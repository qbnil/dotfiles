+static gboolean
+thunar_shortcuts_view_draw (GtkWidget *widget,
+                             cairo_t   *cr)
+{
+  GtkTreeView *tree_view = GTK_TREE_VIEW (widget);
+  GtkTreePath *drop_path = NULL;
+  GtkTreeViewDropPosition position;
+  GdkRectangle rect;
+  GdkWindow *bin_window;
+  GdkRGBA color;
+  gint wx, wy;
+  gboolean result;
+  GtkStyleContext *style_context;
+
+  result = GTK_WIDGET_CLASS (thunar_shortcuts_view_parent_class)->draw (widget, cr);
+
+  gtk_tree_view_get_drag_dest_row (tree_view, &drop_path, &position);
+  if (drop_path != NULL)
+    {
+      bin_window = gtk_tree_view_get_bin_window (tree_view);
+      if (bin_window != NULL)
+        {
+          gdk_window_get_position (bin_window, &wx, &wy);
+          gtk_tree_view_get_background_area (tree_view, drop_path, NULL, &rect);
+          rect.x = 0;
+          rect.width = gdk_window_get_width (bin_window);
+          rect.x += wx;
+          rect.y += wy;
+
+          style_context = gtk_widget_get_style_context (widget);
+          color.red = 0.09; color.green = 0.44; color.blue = 0.80; color.alpha = 0.03;
+          if (gtk_style_context_lookup_color (style_context, "thunar_drop_color", &color))
+            {
+              if (color.alpha > 0.06) color.alpha = 0.06;
+              if (color.alpha < 0.01) color.alpha = 0.01;
+            }
+          else
+            {
+              color.alpha = 0.03;
+            }
+
+          cairo_save (cr);
+          cairo_set_source_rgba (cr, color.red, color.green, color.blue, color.alpha);
+          cairo_rectangle (cr, rect.x, rect.y, rect.width, rect.height);
+          cairo_fill (cr);
+          cairo_restore (cr);
+        }
+      gtk_tree_path_free (drop_path);
+    }
+  return result;
+}
