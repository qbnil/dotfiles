diff --git a/thunar/thunar-icon-renderer.c b/thunar/thunar-icon-renderer.c
index 2221682..ad26782 100644
--- a/thunar/thunar-icon-renderer.c
+++ b/thunar/thunar-icon-renderer.c
@@ -489,6 +489,57 @@ thunar_icon_renderer_color_lighten (cairo_t   *cr,
 
 
 
+static void
+thunar_icon_renderer_color_tint (cairo_t        *cr,
+                                 GdkRectangle   *icon_area,
+                                 GtkWidget      *widget,
+                                 const gchar    *color_name,
+                                 gdouble         alpha_value)
+{
+  cairo_pattern_t *source;
+  GtkStyleContext *context = gtk_widget_get_style_context (widget);
+  GdkRGBA          color;
+  gdouble          r, g, b;
+
+  /* built-in fallbacks (only used when the CSS variables are missing) */
+  if (g_strcmp0 (color_name, "thunar_cut_color") == 0)
+    {
+      r = 0.69;
+      g = 0.29;
+      b = 0.20;
+    }
+  else
+    {
+      r = 0.30;
+      g = 0.54;
+      b = 0.36;
+    }
+
+  if (gtk_style_context_lookup_color (context, color_name, &color))
+    {
+      r = color.red;
+      g = color.green;
+      b = color.blue;
+    }
+
+  cairo_save (cr);
+
+  /* tint only the icon pixels, never the cell/selection background */
+  cairo_rectangle (cr, icon_area->x, icon_area->y, icon_area->width, icon_area->height);
+  cairo_clip (cr);
+
+  source = cairo_pattern_reference (cairo_get_source (cr));
+  cairo_set_source_rgba (cr, r, g, b, alpha_value);
+  cairo_set_operator (cr, CAIRO_OPERATOR_OVER);
+
+  cairo_mask (cr, source);
+
+  cairo_pattern_destroy (source);
+  cairo_restore (cr);
+}
+
+
