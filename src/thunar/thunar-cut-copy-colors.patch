diff --git a/thunar/thunar-standard-view.c b/thunar/thunar-standard-view.c
index 5ce651a..7ef6694 100644
--- a/thunar/thunar-standard-view.c
+++ b/thunar/thunar-standard-view.c
@@ -4271,12 +4271,61 @@ thunar_standard_view_queue_popup (ThunarStandardView *standard_view,
 
 
 
+/* helper for the "cancel cut/copy marker on deselection" feature:
+ * scans the current folder's model for files that are marked as cut or
+ * copied on the clipboard manager and cancels the marker if any are found */
+static void
+thunar_standard_view_cancel_cut_copy (ThunarStandardView *standard_view)
+{
+  ThunarClipboardManager *manager;
+  ThunarFile             *file;
+  GtkTreeIter             iter;
+  gboolean                found = FALSE;
+  gboolean                valid;
+
+  manager = thunar_clipboard_manager_get_for_display (gtk_widget_get_display (GTK_WIDGET (standard_view)));
+
+  /* only files shown in the current folder are candidates here: if the
+   * cut/copied files belong to a different folder (i.e. the user navigated
+   * away), the marker must survive so it can be pasted at the destination */
+  valid = gtk_tree_model_get_iter_first (GTK_TREE_MODEL (standard_view->model), &iter);
+  while (valid)
+    {
+      file = thunar_standard_view_model_get_file (standard_view->model, &iter);
+      if (file != NULL)
+        {
+          if (thunar_clipboard_manager_has_cutted_file (manager, file)
+              || thunar_clipboard_manager_has_copied_file (manager, file))
+            found = TRUE;
+          g_object_unref (file);
+        }
+
+      if (found)
+        break;
+
+      valid = gtk_tree_model_iter_next (GTK_TREE_MODEL (standard_view->model), &iter);
+    }
+
+  if (found)
+    {
+      /* clear the marker and repaint so the files revert to normal colors;
+       * "changed" will also disable the paste actions via the window */
+      thunar_clipboard_manager_clear_files (manager);
+      thunar_standard_view_queue_redraw (standard_view);
+    }
+
+  g_object_unref (G_OBJECT (manager));
+}
+
+
+
