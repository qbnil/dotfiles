       thunar_gdk_cairo_set_source_pixbuf (cr, icon, icon_area.x, icon_area.y, scale_factor);
       cairo_paint_with_alpha (cr, alpha);
 
+      /* tint cut/copied files with the theme colours so the two states are
+       * clearly different: cut = faded red ghost, copy = full + green wash */
+      if (G_LIKELY (cutted))
+        thunar_icon_renderer_color_tint (cr, &icon_area, widget, "thunar_cut_color", 0.60);
