+++ b/thunar/thunar-clipboard-manager.c
@@ -660,6 +660,63 @@ thunar_clipboard_manager_has_cutted_file (ThunarClipboardManager *manager,
 
 
 
+/**
+ * thunar_clipboard_manager_has_copied_file:
+ * @manager : a #ThunarClipboardManager.
+ * @file    : a #ThunarFile.
+ *
+ * Checks whether @file was copied to the given @manager earlier.
+ *
+ * Return value: %TRUE if @file is on the copy list of @manager.
+ **/
+gboolean
+thunar_clipboard_manager_has_copied_file (ThunarClipboardManager *manager,
+                                          const ThunarFile       *file)
+{
+  _thunar_return_val_if_fail (THUNAR_IS_CLIPBOARD_MANAGER (manager), FALSE);
+  _thunar_return_val_if_fail (THUNAR_IS_FILE (file), FALSE);
+
+  return (!manager->files_cutted && g_list_find (manager->files, file) != NULL);
+}
+
+
+
+/**
+ * thunar_clipboard_manager_clear_files:
+ * @manager : a #ThunarClipboardManager.
+ *
+ * Cancels the current cut/copy marker by removing all pending files
+ * from the clipboard and releasing the CLIPBOARD ownership (if the
+ * manager currently owns it). The #ThunarClipboardManager::changed
+ * signal is emitted once the ownership is released, so that all views
+ * redraw the affected files with their regular colors.
+ **/
+void
+thunar_clipboard_manager_clear_files (ThunarClipboardManager *manager)
+{
+  _thunar_return_if_fail (THUNAR_IS_CLIPBOARD_MANAGER (manager));
+
+  /* only the current clipboard owner can release the selection; if another
+   * application owns the clipboard, our file list has already been cleared
+   * by the clear_callback() and there is nothing to do here */
+  if (gtk_clipboard_get_owner (manager->clipboard) == G_OBJECT (manager)
+      && manager->files != NULL)
+    {
+      /* this invokes clear_callback() which releases the pending file
+       * references; the subsequent owner-change notification triggers
+       * the "changed" signal (which updates the paste action state) */
+      gtk_clipboard_clear (manager->clipboard);
+
+      /* if the X server does not support clipboard owner-change
+       * notifications, update the state manually (mirrors the logic
+       * used in transfer_files() and the paste handling) */
+      if (!gdk_display_supports_selection_notification (gtk_clipboard_get_display (manager->clipboard)))
+        thunar_clipboard_manager_owner_changed (manager->clipboard, NULL, manager);
+    }
+}
+
+
+
