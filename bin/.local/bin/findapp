#!/bin/bash
# Comprehensive script to find all traces of an application on Arch Linux
# Usage: ./find-app.sh <app_name> [--remove]

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Help message
show_help() {
    cat <<EOF
Usage: $0 <app_name> [--remove]

Search for all traces of an application on Arch Linux.

Arguments:
  app_name    Name of the application to search for
  --remove    Interactively remove found files (optional)

Examples:
  $0 discord              # Search for Discord
  $0 vencord --remove     # Search and remove Vencord

The script searches:
  • Package manager (pacman, AUR)
  • Binary locations (/usr/bin, /usr/local/bin, ~/.local/bin)
  • Config directories (~/.config, ~/.local/share)
  • Cache directories (~/.cache)
  • System directories (/usr/share, /usr/lib, /opt, /etc)
  • Desktop entries and systemd services
  • Running processes
  • Flatpak and Snap packages
  • AppImage files
  • Shell configuration files

EOF
}

if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help
    exit 0
fi

APP_NAME="$1"
APP_LOWER=$(echo "$APP_NAME" | tr '[:upper:]' '[:lower:]')
REMOVE_MODE=false

if [ $# -ge 2 ] && [ "$2" = "--remove" ]; then
    REMOVE_MODE=true
fi

# Array to store found items for removal
declare -a FOUND_DIRS=()
declare -a FOUND_FILES=()
PACMAN_PACKAGE=""
FLATPAK_PACKAGE=""
SNAP_PACKAGE=""

echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}  Searching for: ${CYAN}$APP_NAME${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}\n"

# 1. Check if installed via package manager
echo -e "${GREEN}[1] Package Manager${NC}"
if pacman -Qi "$APP_LOWER" &>/dev/null; then
    echo -e "${YELLOW}├─ Found in pacman${NC}"
    pacman -Qi "$APP_LOWER" | grep -E "^(Name|Version|Installed Size)" | sed 's/^/│  /'
    PACMAN_PACKAGE="$APP_LOWER"
else
    echo "├─ Not found in pacman"
fi

# Check AUR packages
if command -v yay &>/dev/null; then
    if yay -Qi "$APP_LOWER" &>/dev/null; then
        echo -e "${YELLOW}├─ Found in AUR (yay)${NC}"
        yay -Qi "$APP_LOWER" | grep -E "^(Name|Version|Installed Size)" | sed 's/^/│  /'
        PACMAN_PACKAGE="$APP_LOWER"
    fi
elif command -v paru &>/dev/null; then
    if paru -Qi "$APP_LOWER" &>/dev/null; then
        echo -e "${YELLOW}├─ Found in AUR (paru)${NC}"
        paru -Qi "$APP_LOWER" | grep -E "^(Name|Version|Installed Size)" | sed 's/^/│  /'
        PACMAN_PACKAGE="$APP_LOWER"
    fi
fi
echo

# 2. Search in common binary locations
echo -e "${GREEN}[2] Binary Locations${NC}"
FOUND_BINARIES=false
for dir in /usr/bin /usr/local/bin /opt ~/.local/bin ~/bin; do
    if [ -d "$dir" ]; then
        while IFS= read -r found; do
            if [ -n "$found" ]; then
                echo -e "${YELLOW}├─ $found${NC}"
                FOUND_FILES+=("$found")
                FOUND_BINARIES=true
            fi
        done < <(find "$dir" -maxdepth 1 -iname "*$APP_LOWER*" 2>/dev/null || true)
    fi
done
[ "$FOUND_BINARIES" = false ] && echo "├─ No binaries found"
echo

# 3. Check PATH
echo -e "${GREEN}[3] System PATH${NC}"
if command -v "$APP_LOWER" &>/dev/null; then
    WHICH_PATH=$(which "$APP_LOWER")
    echo -e "${YELLOW}├─ Found: $WHICH_PATH${NC}"
else
    echo "├─ Not found in PATH"
fi
echo

# 4. Search config directories
echo -e "${GREEN}[4] Configuration Files${NC}"
FOUND_CONFIGS=false
for dir in ~/.config ~/.local/share ~/.local/state; do
    if [ -d "$dir" ]; then
        while IFS= read -r found; do
            if [ -n "$found" ]; then
                size=$(du -sh "$found" 2>/dev/null | cut -f1)
                echo -e "${YELLOW}├─ $found ${CYAN}($size)${NC}"
                FOUND_DIRS+=("$found")
                FOUND_CONFIGS=true
            fi
        done < <(find "$dir" -maxdepth 2 -type d -iname "*$APP_LOWER*" 2>/dev/null || true)
    fi
done
[ "$FOUND_CONFIGS" = false ] && echo "├─ No config directories found"
echo

# 5. Search cache directories
echo -e "${GREEN}[5] Cache Files${NC}"
FOUND_CACHES=false
for dir in ~/.cache ~/.local/share; do
    if [ -d "$dir" ]; then
        while IFS= read -r found; do
            if [ -n "$found" ]; then
                size=$(du -sh "$found" 2>/dev/null | cut -f1)
                echo -e "${YELLOW}├─ $found ${CYAN}($size)${NC}"
                FOUND_DIRS+=("$found")
                FOUND_CACHES=true
            fi
        done < <(find "$dir" -maxdepth 2 -type d -iname "*$APP_LOWER*" 2>/dev/null | grep -i cache || true)
    fi
done
[ "$FOUND_CACHES" = false ] && echo "├─ No cache directories found"
echo

# 6. Search system directories (requires sudo for some)
echo -e "${GREEN}[6] System Directories${NC}"
FOUND_SYSTEM=false
for dir in /usr/share /usr/lib /opt /etc; do
    if [ -d "$dir" ]; then
        count=0
        while IFS= read -r found; do
            if [ -n "$found" ]; then
                if [ $count -lt 10 ]; then
                    echo -e "${YELLOW}├─ $found${NC}"
                fi
                ((count++))
                FOUND_SYSTEM=true
            fi
        done < <(sudo find "$dir" -maxdepth 2 -iname "*$APP_LOWER*" 2>/dev/null || true)
        [ $count -gt 10 ] && echo "│  ... and $((count - 10)) more in $dir"
    fi
done
[ "$FOUND_SYSTEM" = false ] && echo "├─ No system files found"
echo

# 7. Search for desktop entries
echo -e "${GREEN}[7] Desktop Entries${NC}"
FOUND_DESKTOP=false
for dir in /usr/share/applications ~/.local/share/applications; do
    if [ -d "$dir" ]; then
        while IFS= read -r found; do
            if [ -n "$found" ]; then
                echo -e "${YELLOW}├─ $found${NC}"
                FOUND_FILES+=("$found")
                FOUND_DESKTOP=true
            fi
        done < <(find "$dir" -maxdepth 1 -iname "*$APP_LOWER*.desktop" 2>/dev/null || true)
    fi
done
[ "$FOUND_DESKTOP" = false ] && echo "├─ No desktop entries found"
echo

# 8. Search for systemd services
echo -e "${GREEN}[8] Systemd Services${NC}"
if systemctl list-unit-files | grep -qi "$APP_LOWER"; then
    echo -e "${YELLOW}├─ Found systemd services:${NC}"
    systemctl list-unit-files | grep -i "$APP_LOWER" | sed 's/^/│  /'
else
    echo "├─ No systemd services found"
fi
echo

# 9. Check running processes
echo -e "${GREEN}[9] Running Processes${NC}"
if pgrep -i "$APP_LOWER" &>/dev/null; then
    echo -e "${YELLOW}├─ Found running processes:${NC}"
    ps aux | grep -i "$APP_LOWER" | grep -v "grep\|find-app.sh" | sed 's/^/│  /' || true
else
    echo "├─ No running processes found"
fi
echo

# 10. Search for files in home directory
echo -e "${GREEN}[10] Home Directory Files${NC}"
FOUND_HOME=false
count=0
while IFS= read -r found; do
    if [ -n "$found" ]; then
        if [ $count -lt 15 ]; then
            echo -e "${YELLOW}├─ $found${NC}"
        fi
        ((count++))
        FOUND_HOME=true
    fi
done < <(find ~ -maxdepth 3 -iname "*$APP_LOWER*" 2>/dev/null | grep -v ".local/share/Trash\|.cache\|node_modules\|.npm" | head -20 || true)
[ $count -gt 15 ] && echo "│  ... and $((count - 15)) more"
[ "$FOUND_HOME" = false ] && echo "├─ No additional files found"
echo

# 11. Check for Flatpak
echo -e "${GREEN}[11] Flatpak${NC}"
if command -v flatpak &>/dev/null; then
    if flatpak list 2>/dev/null | grep -qi "$APP_LOWER"; then
        echo -e "${YELLOW}├─ Found Flatpak app:${NC}"
        flatpak list | grep -i "$APP_LOWER" | sed 's/^/│  /'
        FLATPAK_PACKAGE=$(flatpak list | grep -i "$APP_LOWER" | awk '{print $2}')
    else
        echo "├─ Not found in Flatpak"
    fi
else
    echo "├─ Flatpak not installed"
fi
echo

# 12. Check for Snap
echo -e "${GREEN}[12] Snap${NC}"
if command -v snap &>/dev/null; then
    if snap list 2>/dev/null | grep -qi "$APP_LOWER"; then
        echo -e "${YELLOW}├─ Found Snap package:${NC}"
        snap list | grep -i "$APP_LOWER" | sed 's/^/│  /'
        SNAP_PACKAGE=$(snap list | grep -i "$APP_LOWER" | awk '{print $1}')
    else
        echo "├─ Not found in Snap"
    fi
else
    echo "├─ Snap not installed"
fi
echo

# 13. Check for AppImage
echo -e "${GREEN}[13] AppImage Files${NC}"
FOUND_APPIMAGE=false
while IFS= read -r found; do
    if [ -n "$found" ]; then
        echo -e "${YELLOW}├─ $found${NC}"
        FOUND_FILES+=("$found")
        FOUND_APPIMAGE=true
    fi
done < <(find ~ -maxdepth 3 -type f -iname "*$APP_LOWER*.AppImage" 2>/dev/null || true)
[ "$FOUND_APPIMAGE" = false ] && echo "├─ No AppImage files found"
echo

# 14. Search for shell config references
echo -e "${GREEN}[14] Shell Configuration${NC}"
FOUND_SHELL=false
for file in ~/.bashrc ~/.zshrc ~/.profile ~/.bash_profile ~/.zprofile ~/.config/fish/config.fish; do
    if [ -f "$file" ]; then
        if grep -qi "$APP_LOWER" "$file" 2>/dev/null; then
            echo -e "${YELLOW}├─ Found in $file:${NC}"
            grep -i "$APP_LOWER" "$file" | sed 's/^/│  /'
            FOUND_SHELL=true
        fi
    fi
done
[ "$FOUND_SHELL" = false ] && echo "├─ No shell config references found"
echo

echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}  Search Complete"
echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}\n"

# Removal mode
if [ "$REMOVE_MODE" = true ]; then
    echo -e "${RED}═══ REMOVAL MODE ═══${NC}\n"

    # Remove package manager installations
    if [ -n "$PACMAN_PACKAGE" ]; then
        read -p "$(echo -e ${RED}Remove pacman package \"$PACMAN_PACKAGE\"? [y/N]: ${NC})" -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            sudo pacman -Rns "$PACMAN_PACKAGE"
        fi
    fi

    if [ -n "$FLATPAK_PACKAGE" ]; then
        read -p "$(echo -e ${RED}Remove Flatpak package \"$FLATPAK_PACKAGE\"? [y/N]: ${NC})" -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            flatpak uninstall "$FLATPAK_PACKAGE"
        fi
    fi

    if [ -n "$SNAP_PACKAGE" ]; then
        read -p "$(echo -e ${RED}Remove Snap package \"$SNAP_PACKAGE\"? [y/N]: ${NC})" -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            sudo snap remove "$SNAP_PACKAGE"
        fi
    fi

    # Remove directories
    if [ ${#FOUND_DIRS[@]} -gt 0 ]; then
        echo -e "\n${YELLOW}Found ${#FOUND_DIRS[@]} directories${NC}"
        read -p "$(echo -e ${RED}Remove all found directories? [y/N]: ${NC})" -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            for dir in "${FOUND_DIRS[@]}"; do
                echo "Removing: $dir"
                rm -rf "$dir"
            done
        fi
    fi

    # Remove files
    if [ ${#FOUND_FILES[@]} -gt 0 ]; then
        echo -e "\n${YELLOW}Found ${#FOUND_FILES[@]} files${NC}"
        read -p "$(echo -e ${RED}Remove all found files? [y/N]: ${NC})" -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            for file in "${FOUND_FILES[@]}"; do
                echo "Removing: $file"
                rm -f "$file"
            done
        fi
    fi

    echo -e "\n${GREEN}Removal complete!${NC}"
fi
