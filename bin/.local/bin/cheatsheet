#!/bin/sh
# cheatsheet — all keybinds, blocks + search, looks like clipmenu/fontpicker
# Bind: Super+/
#
# Includes: vxwm, st, rmpc/mpd, neovim, waterfox, and other programs
set -eu

cheat_list() {
	cat <<'EOF'
── launch ──
Super+d                    app launcher (dmenu)
Super+Return               terminal (st)
Super+w                    window switcher (dmenu-win)
Super+Shift+w              wallpaper picker
Super+Shift+p              password manager
Super+p                    power menu (sys)
Super+c                    add clipboard entry (cliphist add)
Super+v                    paste from clipboard (cliphist sel)
Super+/                    cheatsheet
Super+Shift+s              screenshot (flameshot gui)

── music (rmpc/mpd) ──
Super+[                    previous song (mpc)
Super+]                    next song (mpc)
Super+s                    stop song (mpc)
1                          switch to queue view (rmpc)
6                          switch to playlists view (rmpc)
p                          play/pause (rmpc)
x                          toggle random mode (rmpc)
z                          toggle repeat mode (rmpc)
c                          toggle consume mode (rmpc)
v                          toggle single track mode (rmpc)
>                          next track (rmpc)
<                          previous track (rmpc)
f                          seek forward (rmpc)
b                          seek back (rmpc)
.                          volume up (rmpc)
,                          volume down (rmpc)
d                          delete track from queue (rmpc queue view)
D                          delete all from queue (rmpc queue view)
X                          shuffle queue (rmpc queue view)
?                          show help (rmpc)
:                          command mode (rmpc)
j/k                        navigate down/up (rmpc)
J/K                        move track up/down (rmpc)
Space                      select/multi-select (rmpc)
a                          add to queue (rmpc)
A                          add all to queue (rmpc)
/                          search (rmpc)
n/N                        next/previous search result (rmpc)
gg                         jump to top (rmpc)
G                          jump to bottom (rmpc)
C-u / C-d                  page up/down half (rmpc)
C-b / C-f                  page up/down full (rmpc)
gt / gT / Tab / S-Tab      next/previous tab (rmpc)
1-7                        switch to tab by number (rmpc)
C-h/j/k/l                  move between panes (rmpc)

── window ──
Super+q                    close window (killclient)
Super+Shift+Return         swap master
Super+Ctrl+h / l           shrink / grow master (setmfact)
Super+i / o                more / fewer masters (incnmaster)
Super+e                    toggle floating enhanced (ENHANCED_TOGGLE_FLOATING)
Super+Shift+f              fullscreen toggle (FULLSCREEN)
Super+Shift+h/j/k/l        move window left/down/up/right (MOVE_RESIZE_WITH_KEYBOARD)
Super+Ctrl+Shift+h/l       resize window left/right (MOVE_RESIZE_WITH_KEYBOARD)
Super+Ctrl+Shift+j/k       resize window down/up (MOVE_RESIZE_WITH_KEYBOARD)
h / j / k / l              focus left/down/up/right (DIRECTIONAL_FOCUS)
Alt+Tab                    next window (all tiled+floating) (FLOATING_ALTTAB)
Alt+Shift+Tab              previous window (all tiled+floating) (FLOATING_ALTTAB)
Alt+`                      next floating window only (FLOATING_ALTTAB)
Alt+Shift+`                previous floating window only (FLOATING_ALTTAB)

── layout ──
Super+t                    tiled layout
Super+f                    floating layout
Super+m                    monocle layout
Super+g                    grid layout
Super+- / =                gaps decrease / increase (GAPS)
Super+Shift+=              gaps reset (GAPS)
Super+F5                   reload xresources / pywal colors (XRDB)
Super+Shift+Space          toggle floating (default) (ENHANCED_TOGGLE_FLOATING)

── tags ──
Super+1…9                  view tag
Super+Shift+1…9            move window to tag
Super+Ctrl+1…9             toggle tag in view
Super+Ctrl+Shift+1…9       toggle tag on window
Super+0                    view all tags
Super+Tab                  view all tags
Super+Shift+0              tag window on all tags
Super+b                    toggle bar

── canvas (infinite desktop) ──
Alt+r                      home canvas (0,0)
Alt+h / l / j / k          move canvas right/left/up/down
Alt+z                      pin window (stay on screen)
Super+Shift+drag           pan canvas with mouse
drag on empty desktop      pan canvas with mouse

── monitors ──
Super+, / .                focus prev / next monitor
Super+Shift+, / .          send window to monitor

── zoom (screen) ──
Alt+= / Alt+-              zoom in / out (ZOOM)
Alt+Shift+r                reset zoom (ZOOM)
Super+scroll               zoom in / out on window/root (ZOOM)

── opacity (transparency) ──
Alt+o                      toggle opacity global (on/off) (OPACITY)
Alt+Shift+Up / Down        increase / decrease focused window opacity (OPACITY)
Alt+Ctrl+Up / Down         increase / decrease unfocused default opacity (OPACITY)
Alt+Shift+Ctrl+r           reset current window opacity to default (OPACITY)

── mouse ──
click layout symbol        cycle layout
right-click layout symbol  set monocle layout
middle-click title bar     swap master
middle-click status text   open terminal
Super+drag on client       move window
Super+middle-click client  toggle floating
Super+right-drag client    resize window
click tag bar              view tag
right-click tag bar        toggle view tag
Super+click tag bar        tag window
Super+right-click tag bar  toggle tag on window
Super+Shift+drag           pan canvas with mouse
Super+scroll on window     zoom in / out

── media ──
Vol+ / Vol−                volume up / down (XF86Audio)
Mute                       mute toggle (XF86Audio)

── session ──
Super+Shift+q              quit vxwm

── terminal (st) ──
Alt+, / Alt+.              decrease / increase font size
Alt+g                      reset font size / zoom
Ctrl+Shift+c               copy
Ctrl+Shift+v               paste
Ctrl+Shift+y / Shift+Ins   paste primary selection
Ctrl+Shift+right-click     preview image under cursor (feh)
Ctrl+Shift+middle-click    show image info
scroll wheel               scroll history
Shift+PageUp / PageDown    scroll history by page
Print                      print selection
Shift+Print                print screen
Ctrl+Print                 toggle printer mode

── neovim ──
Leader = Space
Leader+u                   source and update nvim config
Leader+re                  restart nvim and restore session
U                          redo (mapped from Ctrl+r)
Esc                        clear search highlights
C-h / C-j / C-k / C-l      move to left/down/up/right split
Leader+rr                  rotate split buffers
Leader+w                   save current file
Leader+q                   quit current buffer
Leader+S                   search and replace word under cursor
S-l / S-h                  next / previous buffer
C-c                        close current buffer
S-k / S-j                  scroll up / down and center
n / N                      next / previous search result centered
Leader+p                   paste without replacing register
Leader+y                   yank selection to system clipboard
Leader+Y                   yank line to system clipboard
Leader+v                   vertical split
C-j / C-k (visual)         move selection down / up
Esc (terminal mode)        exit terminal mode
Leader+oc                  open neovim config
Leader+i                   toggle inlay hints
Leader+tn                  new tab
Leader+tq                  close tab
Leader+ts                  split to new tab
Leader+Tab / Leader+S-Tab  next / previous tab
Leader+cp                  copy file path (line range in visual mode)

── waterfox ──
Ctrl+l                     focus address bar
Ctrl+f / Cmd+f             find in page
F3 / Shift+F3              find next / previous
Ctrl+t                     new tab
Ctrl+w / Cmd+w             close tab
Ctrl+Shift+t               restore closed tab
Ctrl+n                     new window
Ctrl+Shift+p               private window
Ctrl+Tab / Ctrl+Shift+Tab  next / previous tab
Ctrl+h                     history
Ctrl+j                     downloads
Ctrl+Shift+Del             clear history
Ctrl+Shift+b               show bookmarks sidebar
Ctrl+d                     bookmark current page
Ctrl+Shift+m               mute site
F11                        fullscreen
F12                        developer tools

EOF
}

# compact strip above bar (not full-screen)
choice=$(cheat_list | dmenu -p "keys:" -l 6) || true
[ -n "${choice:-}" ] || exit 0

# ignore section headers and unverified (?) entries
case "$choice" in
──* | "?"* | "") exit 0 ;;
esac

# optional: toast the line you picked (handy when searching)
if command -v dunstify >/dev/null 2>&1; then
	dunstify -a keys -u low -t 2500 -r 9920 "keybind" "$choice"
elif command -v notify-send >/dev/null 2>&1; then
	notify-send -a keys -t 2500 "keybind" "$choice"
fi
