#!/bin/sh
# dmenu-above — centered dmenu on primary monitor (horizontal and vertical)
# Usage:  data | dmenu-above [-p prompt] [-l lines] [-H]
set -eu

. "/usr/bin/walcolors" 2>/dev/null || true
nb=${nb:-#222222}
nf=${nf:-#bbbbbb}
sb=${sb:-#005577}
sf=${sf:-#eeeeee}

FN="monospace:size=10"
RF="${XDG_CONFIG_HOME:-$HOME/.config}/rice/font"
if [ -f "$RF" ]; then
	fam=$(grep -v '^#' "$RF" | grep -v '^$' | sed -n '1p')
	sz=$(grep -v '^#' "$RF" | grep -v '^$' | sed -n '2p')
	case "$fam" in "" | -*) ;; *)
		case "$sz" in "" | *[!0-9]*) ;; *) FN="$fam:size=$sz" ;; esac
		;;
	esac
fi

PROMPT=""
LINES=""
HORIZONTAL=0
while [ $# -gt 0 ]; do
	case "$1" in
	-p) PROMPT=$2; shift 2 ;;
	-l) LINES=$2; shift 2 ;;
	-H | --horizontal) HORIZONTAL=1; shift ;;
	*) shift ;;
	esac
done

LIST=$(mktemp /tmp/dma.XXXXXX)
OUT=$(mktemp /tmp/dma.XXXXXX)
BEF=$(mktemp /tmp/dma.XXXXXX)
AFT=$(mktemp /tmp/dma.XXXXXX)
trap 'rm -f "$LIST" "$OUT" "$BEF" "$AFT"' EXIT

cat >"$LIST"
[ -s "$LIST" ] || exit 0

BAR=$(xdotool search --class vxwm 2>/dev/null | head -1)
xdotool search --class dmenu 2>/dev/null | sort >"$BEF" || true

# Get primary monitor geometry
PRIMARY_GEOM=$(xrandr --query | grep " connected primary" | head -1 | grep -oP '\d+x\d+\+\d+\+\d+')
if [ -z "$PRIMARY_GEOM" ]; then
	# No primary set, use first connected monitor
	PRIMARY_GEOM=$(xrandr --query | grep " connected" | head -1 | grep -oP '\d+x\d+\+\d+\+\d+')
fi

# Parse monitor geometry: WIDTHxHEIGHT+X+Y
MON_W=$(echo "$PRIMARY_GEOM" | cut -d'x' -f1)
MON_H=$(echo "$PRIMARY_GEOM" | cut -d'x' -f2 | cut -d'+' -f1)
MON_X=$(echo "$PRIMARY_GEOM" | cut -d'+' -f2)
MON_Y=$(echo "$PRIMARY_GEOM" | cut -d'+' -f3)

set -- -i -nb "$nb" -nf "$nf" -sb "$sb" -sf "$sf" -fn "$FN"
[ -n "$PROMPT" ] && set -- "$@" -p "$PROMPT"

if [ "$HORIZONTAL" -eq 1 ]; then
	# one line centered on primary monitor (horizontal only)
	dmenu "$@" <"$LIST" >"$OUT" &
	DPID=$!

	# Calculate centered width (60% of monitor or 800px max)
	DMENU_W=$((MON_W * 60 / 100))
	[ "$DMENU_W" -gt 800 ] && DMENU_W=800

	i=0
	while [ "$i" -lt 40 ]; do
		xdotool search --class dmenu 2>/dev/null | sort >"$AFT" || true
		DMWIN=$(comm -13 "$BEF" "$AFT" 2>/dev/null | head -1)
		if [ -n "$DMWIN" ]; then
			sleep 0.02
			eval "$(xdotool getwindowgeometry --shell "$DMWIN")"

			# Center vertically on monitor
			NY=$((MON_Y + (MON_H - HEIGHT) / 2))
			[ "$NY" -lt 0 ] && NY=0

			# Center horizontally on monitor
			NX=$((MON_X + (MON_W - DMENU_W) / 2))

			xdotool windowmove "$DMWIN" "$NX" "$NY" 2>/dev/null || true
			xdotool windowsize "$DMWIN" "$DMENU_W" "$HEIGHT" 2>/dev/null || true
			break
		fi
		i=$((i + 1))
		sleep 0.015
	done

	wait "$DPID" || true
	cat "$OUT"
	exit 0
fi

# vertical: default 6 lines, centered on primary monitor (both axes)
case "$LINES" in "" | *[!0-9]*) LINES=6 ;; esac
[ "$LINES" -gt 12 ] && LINES=12
[ "$LINES" -lt 1 ] && LINES=1
set -- -l "$LINES" "$@"

dmenu "$@" <"$LIST" >"$OUT" &
DPID=$!

# Calculate centered width (60% of monitor or 800px max)
DMENU_W=$((MON_W * 60 / 100))
[ "$DMENU_W" -gt 800 ] && DMENU_W=800

i=0
while [ "$i" -lt 40 ]; do
	xdotool search --class dmenu 2>/dev/null | sort >"$AFT" || true
	DMWIN=$(comm -13 "$BEF" "$AFT" 2>/dev/null | head -1)
	if [ -n "$DMWIN" ]; then
		sleep 0.02
		eval "$(xdotool getwindowgeometry --shell "$DMWIN")"

		# Center vertically on monitor
		NY=$((MON_Y + (MON_H - HEIGHT) / 2))
		[ "$NY" -lt 0 ] && NY=0

		# Center horizontally on monitor
		NX=$((MON_X + (MON_W - DMENU_W) / 2))

		xdotool windowmove "$DMWIN" "$NX" "$NY" 2>/dev/null || true
		xdotool windowsize "$DMWIN" "$DMENU_W" "$HEIGHT" 2>/dev/null || true
		break
	fi
	i=$((i + 1))
	sleep 0.015
done

wait "$DPID" || true
cat "$OUT" 2>/dev/null || true
