#!/usr/bin/env bash
# Wallpaper picker → wal → ~/.local/bin/pywal16 (your fast-path postrun)

FOLDER="${XDG_DATA_HOME:-$HOME/.local/share}/wallpapers"
[[ -d "$FOLDER" ]] || FOLDER="${XDG_DATA_HOME:-$HOME/.local/share}/pictures/active-wallpaper-collection"
[[ -d "$FOLDER" ]] || FOLDER="${HOME}/pictures"

SCRIPT="${HOME}/.local/bin/pywal16"

menu() {
  if command -v nsxiv >/dev/null; then
    CHOICE=$(nsxiv -otb "$FOLDER"/* 2>/dev/null || true)
  else
    CHOICE=$(echo -e "Random\n$(command ls -v "$FOLDER" 2>/dev/null)" | dmenu -c -l 15 -i -p "Wallpaper: ")
  fi
  case $CHOICE in
    *.*) wal -i "$CHOICE" -o "$SCRIPT" ;;
    *)   exit 0 ;;
  esac
}

case "$#" in
  0) menu ;;
  1) wal -i "$1" -o "$SCRIPT" ;;
  2) wal -i "$1" --theme "$2" -o "$SCRIPT" ;;
  *) exit 0 ;;
esac
