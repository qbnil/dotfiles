#!/usr/bin/env python3
"""Apply the X cursor theme to the whole session.

Setting Xcursor.theme is enough for applications that are started afterwards,
but it misses two things:

  * the root (desktop) window cursor - vxwm never sets one, and
    `xsetroot -cursor_name left_ptr` only creates a legacy core-font cursor
    that ignores the theme;
  * vxwm's own cursors (bar, resize/move) - they are created with the legacy
    XCreateFontCursor API, so they need an XFixes ChangeCursorByName pass to
    pick up the theme.

This script loads the cursor through libXcursor (honouring Xcursor.theme /
XCURSOR_THEME) and:
  1. sets the root window cursor, and
  2. re-images every named cursor server-side (the vxwm ones included).

Usage: cursor-theme [THEME] [SIZE]
If omitted, THEME/SIZE come from the X resource database, then the
XCURSOR_THEME / XCURSOR_SIZE environment, then fall back to Adwaita/24.
The number of cursors that were re-imaged is printed on stdout.
"""
import ctypes
import ctypes.util
import os
import subprocess
import sys

# Standard Xcursor names; anything present in the theme directory is added too.
NAMES = {
    "left_ptr", "default", "arrow", "xterm", "text", "hand1", "hand2", "pointer",
    "watch", "wait", "crosshair", "cross", "fleur", "move", "grab", "grabbing",
    "help", "question_arrow", "left_ptr_watch", "progress", "not-allowed",
    "all-scroll", "context-menu", "copy", "alias", "cell", "vertical-text",
    "no-drop", "sb_h_double_arrow", "sb_v_double_arrow", "col-resize",
    "row-resize", "ew-resize", "ns-resize", "nwse-resize", "nesw-resize",
    "size_hor", "size_ver", "size_all", "zoom-in", "zoom-out", "sizing",
    "top_left_corner", "top_right_corner", "bottom_left_corner",
    "bottom_right_corner", "top_side", "bottom_side", "left_side", "right_side",
}


def xres(name):
    """Return an X resource value from `xrdb -query`, or None."""
    try:
        out = subprocess.run(["xrdb", "-query"], capture_output=True, text=True).stdout
    except Exception:
        return None
    for line in out.splitlines():
        key, _, val = line.partition(":")
        if key.strip() == name:
            return val.strip()
    return None


def main():
    theme = (sys.argv[1] if len(sys.argv) > 1 else
             xres("Xcursor.theme") or os.environ.get("XCURSOR_THEME") or "Adwaita")
    raw_size = (sys.argv[2] if len(sys.argv) > 2 else
                xres("Xcursor.size") or os.environ.get("XCURSOR_SIZE") or "24")
    try:
        size = int(raw_size)
    except (TypeError, ValueError):
        size = 24

    try:
        libs = [ctypes.util.find_library(n) for n in ("X11", "Xcursor", "Xfixes")]
    except Exception:
        libs = []
    if not all(libs):
        print(0)
        return 0

    x11, xc, xf = (ctypes.CDLL(l) for l in libs)
    vp, ul = ctypes.c_void_p, ctypes.c_ulong

    x11.XOpenDisplay.restype = vp
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XDefaultRootWindow.restype = ul
    x11.XDefaultRootWindow.argtypes = [vp]
    x11.XDefineCursor.argtypes = [vp, ul, ul]
    x11.XFreeCursor.argtypes = [vp, ul]
    x11.XFlush.argtypes = [vp]
    x11.XCloseDisplay.argtypes = [vp]

    xc.XcursorSetTheme.argtypes = [vp, ctypes.c_char_p]
    xc.XcursorSetDefaultSize.argtypes = [vp, ctypes.c_int]
    xc.XcursorLibraryLoadCursor.restype = ul
    xc.XcursorLibraryLoadCursor.argtypes = [vp, ctypes.c_char_p]

    xf.XFixesChangeCursorByName.argtypes = [vp, ul, ctypes.c_char_p]

    dpy = x11.XOpenDisplay(None)
    if not dpy:
        print(0)
        return 0

    xc.XcursorSetTheme(dpy, theme.encode())
    xc.XcursorSetDefaultSize(dpy, size)

    # 1. Desktop / root window cursor.
    root = x11.XDefaultRootWindow(dpy)
    for name in ("left_ptr", "default", "arrow"):
        cur = xc.XcursorLibraryLoadCursor(dpy, name.encode())
        if cur:
            x11.XDefineCursor(dpy, root, cur)
            break

    # 2. Re-image every named cursor so vxwm's bar/resize cursors pick up the theme.
    names = set(NAMES)
    for base in (os.path.expanduser("~/.local/share/icons"),
                 os.path.expanduser("~/.icons"),
                 "/usr/share/icons"):
        d = os.path.join(base, theme, "cursors")
        if os.path.isdir(d):
            names.update(os.listdir(d))

    n = 0
    for name in names:
        cur = xc.XcursorLibraryLoadCursor(dpy, name.encode())
        if cur:
            xf.XFixesChangeCursorByName(dpy, cur, name.encode())
            x11.XFreeCursor(dpy, cur)
            n += 1

    x11.XFlush(dpy)
    x11.XCloseDisplay(dpy)
    print(n)
    return 0


if __name__ == "__main__":
    sys.exit(main())
