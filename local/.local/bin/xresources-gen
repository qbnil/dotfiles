#!/bin/sh
# xresources-gen - rebuild the single Xresources file.
#
# ~/.config/x11/Xresources is generated: the static Xft/cursor block below
# followed by pywal's palette (~/.cache/wal/colors.Xresources). It is the ONLY
# Xresources that exists - there is deliberately no ~/.Xresources.
#
# xrdb-reload runs this on login, WM restart and every wallpaper change, so the
# file always matches the current wal palette. Don't hand-edit colours: the next
# `wal` / wallpaper change overwrites them. Edit the static block below instead.
set -eu

X="${XDG_CONFIG_HOME:-$HOME/.config}"
WAL="${XDG_CACHE_HOME:-$HOME/.cache}/wal"
OUT="$X/x11/Xresources"

mkdir -p "$X/x11"
tmp="$(mktemp "${OUT}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

{
    cat <<'STATIC'
! ~/.config/x11/Xresources - GENERATED by ~/.local/bin/xresources-gen
! Static X settings below; the pywal palette is appended after the marker.
! Do not hand-edit colours - run `wal -i <image>` (wallpaper picker) instead.

! --- Xft (static) ---
! NOTE: Xft.dpi is deliberately NOT set here. Leaving it unset lets Xft use the
! real screen DPI (see xdpyinfo), and vxpanel can still override it via its own
! ~/.config/vxpanel/Xresources. Forcing a fixed DPI (for example 96) shrinks or
! enlarges every font globally.
Xft.antialias: true
Xft.hinting:   true
Xft.rgba:      rgb
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault

! --- Cursor (static fallback; ~/.config/vxpanel/Xresources is merged AFTER this
!     file and overrides the theme/size chosen in vxpanel) ---
Xcursor.theme: Adwaita
Xcursor.size:  24
STATIC

    printf '\n! --- pywal palette (generated) ---\n'
    if [ -f "$WAL/colors.Xresources" ]; then
        cat "$WAL/colors.Xresources"
    else
        printf '! no palette yet - run wal\n'
    fi
} > "$tmp"

mv -f "$tmp" "$OUT"
trap - EXIT
chmod 0644 "$OUT" 2>/dev/null || true
