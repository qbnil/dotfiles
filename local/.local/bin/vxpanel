PROVIDER = Gtk.CssProvider()

def apply_css():
    bgc, fg, c = load_colors()
    ac = c[4]
    PROVIDER.load_from_data(CSS.substitute(
        bg=bgc, fg=fg, ac=ac, onac="#000000" if lum(ac) > 0.5 else "#ffffff",
        s1=mix(bgc, fg, 0.06), s2=mix(bgc, fg, 0.13), s3=mix(bgc, fg, 0.24),
        dim=mix(fg, bgc, 0.42), ok=c[2], warn=c[3], bad=c[1], purple=c[5],
        onbad="#000000" if lum(c[1]) > 0.55 else "#ffffff",
        badh=mix(c[1], "#ffffff", 0.16)).encode())
    for w in REDRAW: w.queue_draw()

# ---------------------------------------------------------------- widget builders
def cls(w, c): w.get_style_context().add_class(c); return w

def new_page(title):
    b = cls(Gtk.Box(orientation=VERT, spacing=14), "page")
    b.set_border_width(24)
    b.pack_start(cls(Gtk.Label(label=title, xalign=0), "title"), False, False, 0)
    return b

def card(parent, title=None):
    c = cls(Gtk.Box(orientation=VERT, spacing=10), "card")
    if title: c.pack_start(cls(Gtk.Label(label=title.upper(), xalign=0), "h"), False, False, 0)
    parent.pack_start(c, False, False, 0)
    return c

def row(c, label, w):
    h = Gtk.Box(spacing=12)
    h.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
    w.set_valign(Gtk.Align.CENTER)
    h.pack_end(w, False, False, 0)
    c.pack_start(h, False, False, 0)

def btn(label, fn, suggested=False):
    b = Gtk.Button.new_with_label(label)
    b.connect("clicked", lambda _: fn())
    if suggested: cls(b, "suggested")
    return b

def btnrow(c, *buttons):
    h = Gtk.Box(spacing=8)
    for b in buttons: h.pack_start(b, False, False, 0)
    c.pack_start(h, False, False, 0)

def combo(items, active=None, fn=None):
    c = Gtk.ComboBoxText()
    for i in items: c.append_text(i)
    if active in items: c.set_active(items.index(active))
    elif items: c.set_active(0)
    if fn: c.connect("changed", lambda w: fn(w.get_active_text()))
    return c

def switch(state, fn=None):
    b = Gtk.ToggleButton()
    b.set_size_request(64, -1)
    def sync(): b.set_label("ON" if b.get_active() else "OFF")
    b.set_active(bool(state)); sync()
    def toggled(w):
        sync()
        if fn: fn(w.get_active())
    b.connect("toggled", toggled)
    return b

def spin(lo, hi, val, step=1, digits=0):
    s = Gtk.SpinButton.new_with_range(lo, hi, step)
    s.set_digits(digits); s.set_value(val)
    return s

def slider(lo, hi, val, step, fn, width=280, digits=0, instant=True, debounce=50):
    """Slider with instant apply - debounce reduced to 50ms for faster response."""
    s = Gtk.Scale.new_with_range(HORZ, lo, hi, step)
    s.set_digits(digits); s.set_value(val); s.set_size_request(width, -1)
    s.set_value_pos(Gtk.PositionType.RIGHT)
    st = {"id": 0}
    def fire():
        st["id"] = 0
        fn(s.get_value())
        return False
    def changed(_):
        if instant:
            if st["id"]: GLib.source_remove(st["id"])
            st["id"] = GLib.timeout_add(debounce, fire)
    s.connect("value-changed", changed)
    return s

def confirm(msg):
    d = Gtk.MessageDialog(transient_for=WIN, message_type=Gtk.MessageType.QUESTION,
                          buttons=Gtk.ButtonsType.YES_NO, text=msg)
    r = d.run(); d.destroy()
    return r == Gtk.ResponseType.YES

PAGES = []
def page(key, label):
    def deco(f): PAGES.append((key, label, f)); return f
    return deco

def reload_page(key, delay=300):
    """Reload a page with reduced delay for faster feedback."""
    GLib.timeout_add(delay, lambda: (WIN.reload(key), False)[1])

# ---------------------------------------------------------------- Display
def parse_xrandr():
    outs, cur = [], None
    for line in sh("xrandr --query").splitlines():
        m = re.match(r"^(\S+) (connected|disconnected)( primary)?", line)
        if m:
            cur = {"name": m[1], "primary": bool(m[3]), "modes": {}, "current": None} if m[2] == "connected" else None
            if cur: outs.append(cur)
            continue
        m = re.match(r"^\s+(\d+x\d+)\S*\s+(.*)$", line)
        if m and cur:
            rs = re.findall(r"(\d+\.\d+)([*+]*)", m[2])
            cur["modes"].setdefault(m[1], [r for r, _ in rs])
            for r, f in rs:
                if "*" in f: cur["current"] = (m[1], r)
    return outs

def output_card(b, o, outs):
    c = card(b, o["name"] + ("  ·  primary" if o["primary"] else ""))
    res = list(o["modes"])
    if not res: return
    rescb = combo(res, o["current"][0] if o["current"] else None)
    ratecb = Gtk.ComboBoxText()
    rot = combo(["normal", "left", "right", "inverted"], "normal")
    prim = switch(o["primary"])
    others = [x["name"] for x in outs if x is not o]
    pos = combo(["keep"] + ["%s %s" % (r, n) for n in others for r in ("right-of", "left-of", "above", "below", "same-as")], "keep")

    def fill(*_):
        ratecb.remove_all()
        rs = o["modes"].get(rescb.get_active_text(), [])
        for r in rs: ratecb.append_text(r)
        cur = o["current"]
        ratecb.set_active(rs.index(cur[1]) if cur and cur[0] == rescb.get_active_text() and cur[1] in rs else 0)
    rescb.connect("changed", fill); fill()

    def apply():
        cmd = ["xrandr", "--output", o["name"], "--mode", rescb.get_active_text(), "--rotate", rot.get_active_text()]
        if ratecb.get_active_text(): cmd += ["--rate", ratecb.get_active_text()]
        if prim.get_active(): cmd.append("--primary")
        p = pos.get_active_text()
        if p and p != "keep":
            rel, other = p.split(" ", 1)
            cmd += ["--" + rel, other]
        persist("xrandr-" + o["name"], shlex.join(cmd))
        run(cmd, "%s applied" % o["name"], lambda: reload_page("display"))

    def off():
        cmd = ["xrandr", "--output", o["name"], "--off"]
        persist("xrandr-" + o["name"], shlex.join(cmd))
        run(cmd, "%s turned off" % o["name"], lambda: reload_page("display"))

    row(c, "Resolution", rescb); row(c, "Refresh rate (Hz)", ratecb); row(c, "Rotation", rot)
    row(c, "Primary", prim)
    if others: row(c, "Position", pos)
    btns = [btn("Apply", apply, True)]
    if others: btns.append(btn("Turn off", off))
    btnrow(c, *btns)

@page("display", "Display")
def display():
    b = new_page("Display")
    outs = parse_xrandr()
    for o in outs: output_card(b, o, outs)
    c = card(b, "Brightness & night light")
    if have("brightnessctl"):
        m = re.search(r"(\d+)%", sh("brightnessctl -m"))
        def brightness(v):
            subprocess.run(["brightnessctl", "set", "%d%%" % v], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        row(c, "Brightness", slider(1, 100, int(m[1]) if m else 100, 1, brightness, instant=True, debounce=50))
    nl = "redshift" if have("redshift") else "gammastep" if have("gammastep") else None
    if nl:
        def temp_desc(v):
            v = int(v)
            for t, s in ((6500, "neutral - no warm filter"),
                         (5800, "barely warm"),
                         (5000, "slightly warm"),
                         (4000, "warm"),
                         (3000, "noticeably warm")):
                if v >= t: return s
            return "very warm (maximum night light)"
        tdesc = Gtk.Label(label=temp_desc(CFG.get("nightlight_k", NIGHT_DEFAULT)), xalign=0)
        def night(v):
            cfg_set("nightlight_k", int(v))
            tdesc.set_text(temp_desc(v))
            persist_nightlight(); apply_display()
        ns = slider(2500, 6500, int(CFG.get("nightlight_k", NIGHT_DEFAULT)), 100, night, instant=True, debounce=100)
        def reset():
            # restoring the default moves the slider too, so slider / label / screen agree
            if int(ns.get_value()) != NIGHT_DEFAULT: ns.set_value(NIGHT_DEFAULT)
            else: night(NIGHT_DEFAULT)
        row(c, "Color temperature (K)", ns)
        c.pack_start(tdesc, False, False, 0)
        c.pack_start(Gtk.Label(label="Lower K = warmer. %dK is the default; 6500K is neutral (no warm filter). Saved and reapplied at login." % NIGHT_DEFAULT, xalign=0), False, False, 0)
        btnrow(c, btn("Reset", reset))
    elif not have("brightnessctl"):
        c.pack_start(Gtk.Label(label="Install brightnessctl and/or redshift for brightness and night light.", xalign=0), False, False, 0)
    if have("arandr"): btnrow(c, btn("Open arandr", lambda: bg("arandr")))
    return b

# ---------------------------------------------------------------- Colors (pywal)
@page("colors", "Colors")
def colors():
    b = new_page("Colors & wallpaper")
    c = card(b, "Palette  (click a swatch to copy its hex)")
    da = Gtk.DrawingArea(); da.set_size_request(-1, 54)
    da.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    def draw(w, cr):
        W, Hh = w.get_allocated_width(), w.get_allocated_height()
        for i, hx in enumerate(load_colors()[2]):
            cr.set_source_rgb(*hex2rgb(hx))
            cr.rectangle(i * W / 16, 0, W / 16 + 1, Hh); cr.fill()
    def click(w, e):
        copy(load_colors()[2][min(15, int(e.x / (w.get_allocated_width() / 16)))])
    da.connect("draw", draw); da.connect("button-press-event", click); REDRAW.append(da)
    c.pack_start(da, False, False, 0)

    c = card(b, "Wallpaper")
    st = {"gen": 0, "paths": []}
    folder = CFG.get("wall_dir") or (H + "/Pictures/Wallpapers" if os.path.isdir(H + "/Pictures/Wallpapers") else H + "/Pictures")
    fc = Gtk.FileChooserButton(title="Wallpaper folder", action=Gtk.FileChooserAction.SELECT_FOLDER)
    if os.path.isdir(folder): fc.set_filename(folder)
    row(c, "Folder", fc)
    row(c, "Light theme", switch(CFG.get("light", False), lambda v: cfg_set("light", v)))
    row(c, "Backend", combo(["wal", "colorthief", "colorz", "haishoku"], CFG.get("backend", "wal"), lambda v: cfg_set("backend", v)))
    if "hook" not in CFG: cfg_set("hook", "~/.local/bin/pywal16" if os.path.exists(H + "/.local/bin/pywal16") else "")
    hk = Gtk.Entry(text=CFG.get("hook", "")); hk.set_width_chars(34)
    hk.set_placeholder_text("script run by wal itself (wal -o), e.g. ~/.local/bin/pywal16")
    hk.connect("changed", lambda w: cfg_set("hook", w.get_text()))
    row(c, "Wal hook script (wal -o)", hk)
    regen = H + "/.local/bin/regenerate-gtk-theme.sh"
    if "post" not in CFG and os.path.exists(regen): cfg_set("post", "~/.local/bin/regenerate-gtk-theme.sh")
    post = Gtk.Entry(text=CFG.get("post", "")); post.set_width_chars(34)
    post.set_placeholder_text("e.g. ~/bin/reload-dwm-colors")
    post.connect("changed", lambda w: cfg_set("post", w.get_text()))
    row(c, "Run after applying", post)
    rk = Gtk.Entry(text=CFG.get("reload_key", "super+F5")); rk.set_width_chars(14)
    rk.connect("changed", lambda w: cfg_set("reload_key", w.get_text()))
    row(c, "Reload WM colors key (xdotool, blank = off)", rk)
    row(c, "Restore palette at login", switch(CFG.get("wal_login", False),
        lambda v: (cfg_set("wal_login", v), persist("wal", "wal -R -q" if v else None))))
    fb = Gtk.FlowBox(); fb.set_max_children_per_line(4); fb.set_selection_mode(Gtk.SelectionMode.NONE)
    fb.set_homogeneous(True)
    c.pack_start(fb, False, False, 0)

    def after():
        # xrdb-reload merges every Xresources source in the canonical order
        # (vxpanel's cursor last); then poke the WM, repaint and run extras.
        steps = [shlex.quote(H + "/.local/bin/xrdb-reload")]
        key = CFG.get("reload_key", "super+F5")
        if key and have("xdotool"): steps += ["sleep 0.1", "xdotool key %s" % shlex.quote(key)]
        if have("xrefresh"): steps.append("xrefresh")
        run("; ".join(steps), "Colors reloaded (xrdb, WM, repaint)")
        if CFG.get("post"): bg(CFG["post"])
    def wal_cmd(cmd):
        """Same call as a wallpaper-menu script: wal -i FILE -o HOOK. With a hook, wal itself runs it
        after the palette is written; without one, vxpanel does the reload steps itself."""
        hook = os.path.expanduser(CFG.get("hook", "").strip())
        if "-i" in cmd and CFG.get("backend", "wal") != "wal": cmd += ["--backend", CFG["backend"]]
        if "-i" in cmd and CFG.get("light"): cmd.append("-l")
        # -n: with a hook, the hook sets the wallpaper synchronously; pywal's
        # own feh is slow/async and would race the repaint (stale wallpaper).
        if hook: cmd += ["-n", "-o", hook]
        return cmd, (None if hook else after)

    def set_wall(_fb, child):
        if not have("wal"): return status("✗ pywal (wal) not found in PATH")
        p = st["paths"][child.get_index()]
        status("Generating palette…")
        cmd, post_fn = wal_cmd(["wal", "-i", p])
        run(cmd, "Palette applied", post_fn)

    def load(*_):
        st["gen"] += 1; gen = st["gen"]; st["paths"] = []
        for ch in fb.get_children(): fb.remove(ch)
        d = fc.get_filename() or folder
        cfg_set("wall_dir", d)
        try:
            files = sorted(f for f in os.listdir(d) if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")))[:60]
        except Exception:
            files = []
        it = iter(files)
        def step():
            if gen != st["gen"]: return False
            f = next(it, None)
            if f is None: return False
            p = os.path.join(d, f)
            try:
                img = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(p, 190, 110, True))
            except Exception:
                return True
            img.set_tooltip_text(f); fb.add(img); fb.show_all()
            st["paths"].append(p)
            return True
        GLib.idle_add(step)
    fc.connect("selection-changed", load)
    fb.connect("child-activated", set_wall)
    load()
    btnrow(c, btn("Restore last palette", lambda: run(*(lambda r: (r[0], "Palette restored", r[1]))(wal_cmd(["wal", "-R"])))))
    return b

# ---------------------------------------------------------------- Theme & fonts
def list_dirs(bases, test):
    s = set()
    for base in bases:
        if os.path.isdir(base):
            for n in os.listdir(base):
                try:
                    if test(os.path.join(base, n)): s.add(n)
                except Exception: pass
    return sorted(s, key=str.lower)

def ini_update(path, kv):
    cp = configparser.ConfigParser(interpolation=None); cp.optionxform = str
    cp.read(path)
    if "Settings" not in cp: cp["Settings"] = {}
    for k, v in kv.items(): cp["Settings"][k] = str(v)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f: cp.write(f)

def kv_file(path, d, fmt, pat):
    try: lines = open(path).read().splitlines()
    except Exception: lines = []
    for k, v in d.items():
        new = fmt.format(k=k, v=v)
        for i, l in enumerate(lines):
            if re.match(pat.format(k=re.escape(k)), l):
                lines[i] = new; break
        else:
            lines.append(new)
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    open(path, "w").write("\n".join(lines) + "\n")

CURSOR_STD = ["left_ptr", "xterm", "text", "hand1", "hand2", "pointer", "watch", "wait", "crosshair", "cross", "fleur",
              "move", "grabbing", "grab", "help", "question_arrow", "arrow", "default", "X_cursor", "left_ptr_watch",
              "progress", "not-allowed", "all-scroll", "context-menu", "copy", "alias", "cell", "vertical-text", "no-drop",
              "sb_h_double_arrow", "sb_v_double_arrow", "col-resize", "row-resize", "ew-resize", "ns-resize",
              "nwse-resize", "nesw-resize", "size_hor", "size_ver", "size_all", "zoom-in", "zoom-out",
              "top_left_corner", "top_right_corner", "bottom_left_corner", "bottom_right_corner",
              "top_side", "bottom_side", "left_side", "right_side",
              "n-resize", "s-resize", "e-resize", "w-resize", "ne-resize", "nw-resize", "se-resize", "sw-resize"]

def reload_cursors(theme, size):
    """Swap the image of every existing themed cursor server-wide (XFixes ChangeCursorByName),
    so windows that are already open - terminals included - switch immediately."""
    try:
        libs = [ctypes.util.find_library(n) for n in ("X11", "Xcursor", "Xfixes")]
        if not all(libs): return 0
        x11, xc, xf = (ctypes.CDLL(l) for l in libs)
        vp, ul = ctypes.c_void_p, ctypes.c_ulong
        x11.XOpenDisplay.restype = vp; x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XFreeCursor.argtypes = [vp, ul]; x11.XFlush.argtypes = [vp]; x11.XCloseDisplay.argtypes = [vp]
        xc.XcursorSetTheme.argtypes = [vp, ctypes.c_char_p]
        xc.XcursorSetDefaultSize.argtypes = [vp, ctypes.c_int]
        xc.XcursorLibraryLoadCursor.restype = ul; xc.XcursorLibraryLoadCursor.argtypes = [vp, ctypes.c_char_p]
        xf.XFixesChangeCursorByName.argtypes = [vp, ul, ctypes.c_char_p]
        dpy = x11.XOpenDisplay(None)
        if not dpy: return 0
        xc.XcursorSetTheme(dpy, theme.encode()); xc.XcursorSetDefaultSize(dpy, int(size))
        names = set(CURSOR_STD)
        for base in (H + "/.local/share/icons", H + "/.icons", "/usr/share/icons"):
            d = "%s/%s/cursors" % (base, theme)
            if os.path.isdir(d): names.update(os.listdir(d))
        n = 0
        for name in names:
            cur = xc.XcursorLibraryLoadCursor(dpy, name.encode())
            if cur:
                xf.XFixesChangeCursorByName(dpy, cur, name.encode()); x11.XFreeCursor(dpy, cur); n += 1
        x11.XFlush(dpy); x11.XCloseDisplay(dpy)
        return n
    except Exception:
        return 0

XS_CONF = H + "/.config/xsettingsd/xsettingsd.conf"

def gs_get(key):
    if not have("gsettings"): return None
    return sh(["gsettings", "get", "org.gnome.desktop.interface", key]).strip().strip("'\"") or None

def rc2_get(key):
    try:
        m = re.search(r'^\s*%s\s*=\s*"?([^"\n]+)"?' % re.escape(key), open(H + "/.gtkrc-2.0").read(), re.M)
        return m[1].strip() if m else None
    except Exception:
        return None

def xs_get(key):
    if not sh("pgrep -x xsettingsd"): return None
    try:
        m = re.search(r'^\s*%s\s+"?([^"\n]+)"?' % re.escape(key), open(XS_CONF).read(), re.M)
        return m[1].strip() if m else None
    except Exception:
        return None

def with_current(items, name):
    """Make sure the currently used theme is in the list (case-insensitive) and return the matching entry."""
    if not name: return items, None
    for i in items:
        if i.lower() == name.lower(): return items, i
    return sorted(items + [name], key=str.lower), name

XS_MAP = {"gtk-theme-name": "Net/ThemeName", "gtk-icon-theme-name": "Net/IconThemeName",
          "gtk-cursor-theme-name": "Gtk/CursorThemeName", "gtk-cursor-theme-size": "Gtk/CursorThemeSize",
          "gtk-font-name": "Gtk/FontName"}

def xsettings_push(kv, dpi=None):
    """Live-update running GTK apps (Thunar etc.) through xsettingsd - only the keys that changed."""
    if not have("xsettingsd"): return False
    d = {XS_MAP[k]: (v if isinstance(v, int) else '"%s"' % v) for k, v in kv.items() if k in XS_MAP}
    if dpi: d["Xft/DPI"] = int(dpi) * 1024
    if d: kv_file(XS_CONF, d, "{k} {v}", r"{k}\s")
    if sh("pgrep -x xsettingsd"): sh(["pkill", "-HUP", "-x", "xsettingsd"])
    else: bg("xsettingsd")
    persist("xsettingsd", "pgrep -x xsettingsd >/dev/null || xsettingsd &")
    return True

@page("theme", "Theme & Fonts")
def theme():
    b = new_page("Theme & fonts")
    gtk = configparser.ConfigParser(interpolation=None); gtk.optionxform = str
    gtk.read(H + "/.config/gtk-3.0/settings.ini")
    g = lambda k, d: gtk["Settings"].get(k, d) if "Settings" in gtk else d
    xr = dict(re.findall(r"^(\S+):\s*(.*)$", sh("xrdb -query"), re.M))
    shared = [H + "/.icons", H + "/.local/share/icons", "/usr/share/icons"]
    themes = list_dirs([H + "/.themes", H + "/.local/share/themes", "/usr/share/themes"], lambda p: os.path.isdir(p + "/gtk-3.0")) or ["Adwaita"]
    icons = list_dirs(shared, lambda p: "Directories=" in open(p + "/index.theme").read()) or ["Adwaita"]
    curs = list_dirs(shared, lambda p: os.path.isdir(p + "/cursors")) or ["Adwaita"]

    cur = lambda gk, xk, sk, d="": xs_get(xk) or g(gk, None) or gs_get(sk) or rc2_get(gk) or d
    th_now = cur("gtk-theme-name", "Net/ThemeName", "gtk-theme")
    # "Default"/"Emacs" are GTK key-binding themes (no styling at all) - never offer them as a look
    themes = [x for x in themes if x not in ("Default", "Emacs") or x == th_now] or themes
    if not th_now: themes = ["(keep current)"] + themes
    themes, th0 = with_current(themes, th_now or "(keep current)")
    ic_now = cur("gtk-icon-theme-name", "Net/IconThemeName", "icon-theme")
    if not ic_now: icons = ["(keep current)"] + icons
    icons, ic0 = with_current(icons, ic_now or "(keep current)")
    curs, cu0 = with_current(curs, xr.get("Xcursor.theme") or cur("gtk-cursor-theme-name", "Gtk/CursorThemeName", "cursor-theme"))
    dark_raw = g("gtk-application-prefer-dark-theme", None) or ("1" if gs_get("color-scheme") == "prefer-dark" else "0")
    csize = xr.get("Xcursor.size") or cur("gtk-cursor-theme-size", "Gtk/CursorThemeSize", "cursor-size", "24")

    c = card(b, "GTK")
    t = combo(themes, th0)
    i = combo(icons, ic0)
    dark = switch(dark_raw in ("1", "true"))

    row(c, "Theme", t); row(c, "Icons", i); row(c, "Prefer dark", dark)

    c = card(b, "Cursor")
    cu = combo(curs, cu0)
    cs = spin(16, 96, int(float(csize or 24)), 2)

    row(c, "Theme", cu); row(c, "Size", cs)

    c = card(b, "Fonts")
    f = Gtk.FontButton(); f.set_font(cur("gtk-font-name", "Gtk/FontName", "font-name", "Sans 10")); row(c, "Interface font", f)
    dpi = spin(72, 288, int(float(xr.get("Xft.dpi", "96")))); row(c, "DPI", dpi)
    aa = switch(xr.get("Xft.antialias", "1") == "1"); row(c, "Antialiasing", aa)
    hs = combo(["hintnone", "hintslight", "hintmedium", "hintfull"], xr.get("Xft.hintstyle", "hintslight")); row(c, "Hinting", hs)
    rg = combo(["none", "rgb", "bgr", "vrgb", "vbgr"], xr.get("Xft.rgba", "none")); row(c, "Subpixel", rg)

    GINIT = {"gtk-theme-name": t.get_active_text(), "gtk-icon-theme-name": i.get_active_text(),
             "gtk-font-name": f.get_font(), "gtk-application-prefer-dark-theme": int(dark.get_active())}
    INIT = {"Xcursor.theme": cu.get_active_text(), "Xcursor.size": int(cs.get_value()),
            "Xft.dpi": int(dpi.get_value()), "Xft.antialias": int(aa.get_active()),
            "Xft.hintstyle": hs.get_active_text(), "Xft.rgba": rg.get_active_text()}

    def apply():
        th, ic, cr = t.get_active_text(), i.get_active_text(), cu.get_active_text()
        size, font = int(cs.get_value()), f.get_font()
        kv = {"gtk-theme-name": th, "gtk-icon-theme-name": ic, "gtk-cursor-theme-name": cr,
              "gtk-cursor-theme-size": size, "gtk-font-name": font,
              "gtk-application-prefer-dark-theme": int(dark.get_active())}
        # only write the GTK keys you actually changed (cursor keys always) - never clobber a generated/pywal theme
        kv_all = dict(kv)
        kv = {k: v for k, v in kv_all.items() if v != "(keep current)" and
              (k.startswith("gtk-cursor") or str(v) != str(GINIT[k]))}
        GINIT.update({k: v for k, v in kv_all.items() if k in GINIT})
        for v in ("gtk-3.0", "gtk-4.0"): ini_update("%s/.config/%s/settings.ini" % (H, v), kv)
        # update vxpanel's own window too (GTK caches the cursor theme per process)
        gs_ = Gtk.Settings.get_default()
        gs_.set_property("gtk-cursor-theme-name", cr)
        gs_.set_property("gtk-cursor-theme-size", size)
        rc = {k: (v if isinstance(v, int) else '"%s"' % v) for k, v in kv.items() if "prefer-dark" not in k}
        kv_file(H + "/.gtkrc-2.0", rc, "{k}={v}", r"\s*{k}\s*=")
        xnew = {"Xcursor.theme": cr, "Xcursor.size": size, "Xft.dpi": int(dpi.get_value()),
                "Xft.antialias": int(aa.get_active()), "Xft.hintstyle": hs.get_active_text(),
                "Xft.rgba": rg.get_active_text()}
        dpi_new = int(dpi.get_value()) if int(dpi.get_value()) != INIT["Xft.dpi"] else None
        xp = xres_path()
        xall = dict(xnew)
        # cursor keys are always written; Xft keys only when you changed them (avoids overriding your font setup)
        xnew = {k: v for k, v in xnew.items() if not k.startswith("Xft.") or str(v) != str(INIT[k])}
        if xnew: kv_file(xp, xnew, "{k}: {v}", r"\s*{k}\s*:")
        INIT.update(xall)  # remember what is stored now, so switching back to an earlier value still gets written

        # Apply X resources with cursor theme
        if os.path.exists(xp): sh(["xrdb", "-merge", xp])
        persist("xres", ("xrdb -merge %s" % shlex.quote(xp)) if xp == VX_XRES and os.path.exists(xp) else None)
        
        # Force reload of cursor theme by setting XCURSOR_THEME env var and calling xsetroot
        # This makes the X server pick up the new cursor theme for new windows
        env = os.environ.copy()
        env["XCURSOR_THEME"] = cr
        env["XCURSOR_SIZE"] = str(size)
        subprocess.run(["xsetroot", "-cursor_name", "left_ptr"], env=env,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        try:
            os.makedirs(H + "/.icons/default", exist_ok=True)
            open(H + "/.icons/default/index.theme", "w").write("[Icon Theme]\nInherits=%s\n" % cr)
            os.makedirs(H + "/.local/share/icons/default", exist_ok=True)
            open(H + "/.local/share/icons/default/index.theme", "w").write("[Icon Theme]\nInherits=%s\n" % cr)
        except Exception as e:
            return status("✗ could not write ~/.icons/default/index.theme: %s" % e)

        # Broadcast theme changes to all GTK applications (Thunar, etc) via gsettings
        applied = []
        if have("gsettings"):
            gmap = {"gtk-theme-name": "gtk-theme", "gtk-icon-theme-name": "icon-theme",
                    "gtk-cursor-theme-name": "cursor-theme", "gtk-font-name": "font-name", "gtk-cursor-theme-size": "cursor-size"}
            for k, v in kv.items():
                if k in gmap:
                    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", gmap[k], str(v)],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            applied = ["Theme: %s" % th, "Icons: %s" % ic, "Cursor: %s" % cr]

            # Rebuild icon cache
            icon_paths = ["/usr/share/icons/%s" % ic, H + "/.local/share/icons/%s" % ic]
            for path in icon_paths:
                if os.path.isdir(path):
                    subprocess.run(["gtk-update-icon-cache", "-f", "-t", path],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        live = xsettings_push(kv, dpi_new)
        ncur = reload_cursors(cr, size)
        persist("cursor", "XCURSOR_THEME=%s XCURSOR_SIZE=%d xsetroot -cursor_name left_ptr" % (shlex.quote(cr), size))
        msg = "✓ Applied: %s" % " | ".join(applied) if applied else "✓ Theme applied"
        if ncur: msg += " | cursor refreshed in open windows"
        env_t = os.environ.get("XCURSOR_THEME")
        if env_t and env_t != cr:
            msg += " | ⚠ XCURSOR_THEME=%s is set in your environment and may override this" % env_t
        status(msg + (" - open GTK apps updated live" if live else
                      " - install xsettingsd for live updates, otherwise restart apps"))
    btnrow(b, btn("Apply", apply, True))
    return b

# ---------------------------------------------------------------- Audio
def devices(kind):
    try:
        return [(d["name"], d.get("description", d["name"])) for d in json.loads(sh(["pactl", "-f", "json", "list", kind + "s"]))
                if not d["name"].endswith(".monitor")]
    except Exception:
        return [(l.split("\t")[1],) * 2 for l in sh(["pactl", "list", "short", kind + "s"]).splitlines()
                if "\t" in l and not l.split("\t")[1].endswith(".monitor")]

def audio_card(b, K, title):
    D = "@DEFAULT_%s@" % K.upper()
    c = card(b, title)
    m = re.search(r"(\d+)%", sh(["pactl", "get-%s-volume" % K, D]))
    def volume(v):
        subprocess.run(["pactl", "set-%s-volume" % K, D, "%d%%" % v], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    row(c, "Volume", slider(0, 150, int(m[1]) if m else 0, 1, volume, instant=True, debounce=50))
    row(c, "Mute", switch("yes" in sh(["pactl", "get-%s-mute" % K, D]),
                          lambda v: run(["pactl", "set-%s-mute" % K, D, "1" if v else "0"], "muted" if v else "unmuted")))
    devs = devices(K); default = sh(["pactl", "get-default-" + K])
    names = {d: n for n, d in devs}
    cur = next((d for n, d in devs if n == default), None)
    row(c, "Device", combo([d for _, d in devs], cur,
        lambda v: run(["pactl", "set-default-" + K, names[v]], "default %s set" % K, lambda: reload_page("audio", 200))))

@page("audio", "Audio")
def audio():
    b = new_page("Audio")
    audio_card(b, "sink", "Output")
    audio_card(b, "source", "Input")
    if have("pavucontrol"): btnrow(b, btn("Open pavucontrol", lambda: bg("pavucontrol")))
    return b

# ---------------------------------------------------------------- Input
def pointers():
    out = []
    for l in sh("xinput list").splitlines():
        m = re.search(r"↳\s*(.+?)\s+id=(\d+)\s+\[slave\s+pointer", l)
        if m: out.append((m[2], m[1]))
    return out

def xi_set(prop, val, key):
    live, saved = [], []
    for i, n in pointers():
        if prop in sh(["xinput", "list-props", i]):
            live.append(shlex.join(["xinput", "set-prop", i, prop, str(val)]))
            saved.append(shlex.join(["xinput", "set-prop", n, prop, str(val)]))
    if not live: return status('✗ no device exposes "%s"' % prop)
    persist(key, "; ".join(saved))
    subprocess.run("; ".join(live), shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def xi_get(prop):
    for i, _ in pointers():
        m = re.search(re.escape(prop) + r" \(\d+\):\s*([-\d.]+)", sh(["xinput", "list-props", i]))
        if m: return float(m[1])
    return None

@page("input", "Input")
def input_page():
    b = new_page("Keyboard & pointer")
    q = dict(re.findall(r"^(\w+):\s*(.*)$", sh("setxkbmap -query"), re.M))
    c = card(b, "Keyboard layout")
    lay = Gtk.Entry(text=q.get("layout", "us")); var = Gtk.Entry(text=q.get("variant", ""))
    opt = Gtk.Entry(text=q.get("options", ""))
    row(c, "Layouts (e.g. us,ru)", lay); row(c, "Variant", var); row(c, "Options", opt)
    def apply_kb():
        cmd = ["setxkbmap", "-layout", lay.get_text() or "us", "-variant", var.get_text(), "-option", ""]
        if opt.get_text(): cmd += ["-option", opt.get_text()]
        persist("kbd", shlex.join(cmd)); run(cmd, "layout %s" % (lay.get_text() or "us"))
    btnrow(c, btn("Apply", apply_kb, True),
           btn("Preset: us,ru + Alt+Shift", lambda: (lay.set_text("us,ru"), opt.set_text("grp:alt_shift_toggle"))))
    c = card(b, "Key repeat")
    dl = spin(100, 1000, int(CFG.get("rdelay", 300)), 25); rt = spin(5, 100, int(CFG.get("rrate", 40)))
    row(c, "Delay (ms)", dl); row(c, "Rate (Hz)", rt)
    def apply_rep():
        cmd = ["xset", "r", "rate", str(int(dl.get_value())), str(int(rt.get_value()))]
        cfg_set("rdelay", int(dl.get_value())); cfg_set("rrate", int(rt.get_value()))
        persist("repeat", shlex.join(cmd)); run(cmd, "key repeat set")
    btnrow(c, btn("Apply", apply_rep, True))
    c = card(b, "Pointer (libinput devices)")
    def speed(v):
        xi_set("libinput Accel Speed", round(v, 2), "xi-speed")
    row(c, "Speed", slider(-1, 1, xi_get("libinput Accel Speed") or 0, 0.05, speed, digits=2, instant=True, debounce=50))
    row(c, "Natural scrolling", switch(xi_get("libinput Natural Scrolling Enabled"),
        lambda v: xi_set("libinput Natural Scrolling Enabled", int(v), "xi-natural")))
    row(c, "Tap to click", switch(xi_get("libinput Tapping Enabled"),
        lambda v: xi_set("libinput Tapping Enabled", int(v), "xi-tap")))
    return b

# ---------------------------------------------------------------- Notifications (dunst drop-in)
DUNST_DEF = {"origin": "top-right", "width": 320, "ox": 20, "oy": 20, "frame": 2, "timeout": 8, "font": "Sans 10"}

def dunst_ver():
    m = re.search(r"(\d+)\.(\d+)", sh("dunst -v"))
    return (int(m[1]), int(m[2])) if m else (1, 12)

def write_dunst(restart=True):
    d = {**DUNST_DEF, **CFG.get("dunst", {})}
    off = "(%d, %d)" % (d["ox"], d["oy"]) if dunst_ver() >= (1, 11) else "%dx%d" % (d["ox"], d["oy"])
    out = ["# generated by vxpanel", "[global]", "origin = %s" % d["origin"], "width = %d" % d["width"],
           "offset = %s" % off, "frame_width = %d" % d["frame"], "corner_radius = 0", 'font = "%s"' % d["font"]]
    bgc, fg, c = load_colors()
    for u, fc, to in (("low", c[8], d["timeout"]), ("normal", c[4], d["timeout"]), ("critical", c[1], 0)):
        out += ["", "[urgency_%s]" % u, "timeout = %d" % to]
        if CFG.get("dunst_follow", True):
            out += ['background = "%s"' % bgc, 'foreground = "%s"' % fg, 'frame_color = "%s"' % fc]
    p = H + "/.config/dunst/dunstrc.d"
    os.makedirs(p, exist_ok=True)
    open(p + "/90-vxpanel.conf", "w").write("\n".join(out) + "\n")
    if restart: bg("pkill -x dunst; sleep 0.3; exec dunst")

@page("notify", "Notifications")
def notif():
    b = new_page("Notifications")
    d = {**DUNST_DEF, **CFG.get("dunst", {})}
    c = card(b, "Control")
    row(c, "Do not disturb", switch(sh("dunstctl is-paused") == "true",
        lambda v: run(["dunstctl", "set-paused", "true" if v else "false"], "paused" if v else "resumed")))
    btnrow(c, btn("Test", lambda: run(["notify-send", "-a", "vxpanel", "Test notification", "Looking good."], "sent")),
           btn("Critical", lambda: run(["notify-send", "-u", "critical", "-a", "vxpanel", "Critical", "Attention!"], "sent")),
           btn("History", lambda: run(["dunstctl", "history-pop"], "history popped")),
           btn("Close all", lambda: run(["dunstctl", "close-all"], "closed")))
    c = card(b, "Appearance  (writes ~/.config/dunst/dunstrc.d/90-vxpanel.conf)")
    org = combo(["top-left", "top-center", "top-right", "bottom-left", "bottom-center", "bottom-right", "center"], d["origin"]); row(c, "Position", org)
    wd = spin(150, 800, d["width"], 10); row(c, "Width", wd)
    ox = spin(0, 400, d["ox"]); oy = spin(0, 400, d["oy"]); row(c, "Offset X", ox); row(c, "Offset Y", oy)
    fw = spin(0, 10, d["frame"]); row(c, "Border width", fw)
    to = spin(0, 120, d["timeout"]); row(c, "Timeout (s, 0 = sticky)", to)
    fn = Gtk.FontButton(); fn.set_font(d["font"]); row(c, "Font", fn)
    fol = switch(CFG.get("dunst_follow", True), lambda v: cfg_set("dunst_follow", v)); row(c, "Follow pywal colors", fol)
    def apply():
        cfg_set("dunst", {"origin": org.get_active_text(), "width": int(wd.get_value()), "ox": int(ox.get_value()),
                          "oy": int(oy.get_value()), "frame": int(fw.get_value()), "timeout": int(to.get_value()),
                          "font": fn.get_font()})
        cfg_set("dunst_follow", fol.get_active())
        if not have("dunst"): return status("✗ dunst not installed")
        write_dunst()
        GLib.timeout_add(900, lambda: (bg(["notify-send", "-a", "vxpanel", "vxpanel", "dunst reloaded"]), False)[1])
        status("✓ dunst config written and restarted")
    btnrow(c, btn("Apply & restart dunst", apply, True))
    return b

# ---------------------------------------------------------------- System
@page("system", "System")
def system():
    b = new_page("System")
    c = card(b, "Compositor (xcompmgr)")
    shd = switch(CFG.get("xc_shadow", True)); fd = switch(CFG.get("xc_fade", False))
    rad = spin(0, 40, CFG.get("xc_rad", 12)); op = spin(0.1, 1.0, CFG.get("xc_op", 0.75), 0.05, 2)
    def comp(on=True):
        cfg_set("xc_shadow", shd.get_active()); cfg_set("xc_fade", fd.get_active())
        cfg_set("xc_rad", int(rad.get_value())); cfg_set("xc_op", round(op.get_value(), 2))
        line = "xcompmgr" + (" -c" if shd.get_active() else "") + (" -f" if fd.get_active() else "") \
               + " -r %d -o %.2f" % (rad.get_value(), op.get_value())
        bg("pkill -x xcompmgr; sleep 0.2; exec " + line if on else "pkill -x xcompmgr")
        persist("xcompmgr", ("pkill -x xcompmgr; " + line + " &") if on else None)
        status("✓ xcompmgr " + ("restarted" if on else "stopped"))
    row(c, "Running", switch(sh("pgrep -x xcompmgr") != "", lambda v: comp(v)))
    row(c, "Shadows", shd); row(c, "Fading", fd); row(c, "Shadow radius", rad); row(c, "Shadow opacity", op)
    btnrow(c, btn("Restart with these options", comp, True))

    c = card(b, "Screen blanking")
    mins = spin(1, 120, int(CFG.get("blank", 10))); row(c, "Blank after (min)", mins)
    def blank():
        s = int(mins.get_value()) * 60; cfg_set("blank", int(mins.get_value()))
        cmd = "xset s %d; xset dpms 0 0 %d" % (s, s)
        persist("blank", cmd); run(cmd, "blank after %d min" % mins.get_value())
    def never():
        persist("blank", "xset s off -dpms"); run("xset s off -dpms", "screen stays on")
    btnrow(c, btn("Apply", blank, True), btn("Never blank", never))

    c = card(b, "Connectivity")
    if have("nmcli"):
        row(c, "Wi-Fi", switch(sh("nmcli radio wifi") == "enabled",
            lambda v: run(["nmcli", "radio", "wifi", "on" if v else "off"], "Wi-Fi " + ("on" if v else "off"))))
    if have("bluetoothctl"):
        row(c, "Bluetooth", switch("Powered: yes" in sh("bluetoothctl show"),
            lambda v: run(["bluetoothctl", "power", "on" if v else "off"], "Bluetooth " + ("on" if v else "off"))))
    tools = [btn(n, lambda n=n: bg(n)) for n in ("nm-connection-editor", "blueman-manager") if have(n)]
    if tools: btnrow(c, *tools)

    c = card(b, "Power")
    def power(label, cmd): return btn(label, lambda: confirm("%s now?" % label) and bg(cmd))
    btnrow(c, power("Suspend", ["systemctl", "suspend"]), power("Reboot", ["systemctl", "reboot"]),
           power("Shut down", ["systemctl", "poweroff"]))

    c = card(b, "Persistence")
    c.pack_start(Gtk.Label(label="Settings X forgets on restart (monitors, keyboard, pointer, compositor, night light…) are saved to\n%s\nand applied automatically at login by xinitrc." % STARTUP, xalign=0), False, False, 0)
    btnrow(c, btn("Open startup.sh", lambda: bg(["xdg-open", STARTUP])))
    return b

# ---------------------------------------------------------------- Network
# Live connectivity/diagnostic view. Everything here is read-only by default;
# the buttons only touch the network when the user asks. Data collection runs
# in a worker thread because systemctl/nmcli/tailscale can each take a moment,
# and the page is polled only while it is the visible stack child.
NET_TIMER = {"id": 0}

SERVICE_CHIPS = [
    ("NetworkManager", "NM"),
    ("dhcpcd", "DHCPCD"),
    ("systemd-networkd", "NETWORKD"),
    ("iwd", "IWD"),
    ("wpa_supplicant", "WPA_SUPPL"),
    ("tailscaled", "TAILSCALE"),
]

def _nm_split(line):
    """Split `nmcli -t` output on unescaped ':' and undo '\\:' / '\\\\'."""
    out, cur, esc = [], [], False
    for ch in line:
        if esc:
            cur.append(ch); esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            out.append("".join(cur)); cur = []
        else:
            cur.append(ch)
    out.append("".join(cur))
    return out

def _kv(text):
    """Parse `Key: value` / `Key:      value` output into a dict."""
    d = {}
    for line in text.splitlines():
        if ":" not in line: continue
        k, v = line.split(":", 1)
        d.setdefault(k.strip(), v.strip())
    return d

def _read_text(path, limit=65536):
    try:
        with open(path, errors="replace") as f:
            return f.read(limit)
    except Exception:
        return ""

def _svc_state(unit):
    """(active, enabled) for a systemd unit, safe when systemd is absent."""
    rc, out, err = _dc(["systemctl", "is-active", unit], 3)
    active = (out or err).strip().splitlines()[0] if (out or err).strip() else "unknown"
    rc, out, _ = _dc(["systemctl", "is-enabled", unit], 3)
    enabled = out.strip().splitlines()[0] if out.strip() else "unknown"
    return active, enabled

def _tcp_probe(host, port, timeout=2.5):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True, "ok"
    except Exception as e:
        return False, str(e)

def _tailscale_info():
    """Everything the panel needs from tailscaled, without requiring jq."""
    d = {"available": False, "backend": "absent", "online": False, "ips": [],
         "dnsname": "", "health": [], "peers": 0, "peers_online": 0,
         "exit_id": "", "exit_online": False, "exit_ip": "", "exit_host": "",
         "exit_nodes": [], "version": "", "error": ""}
    if not have("tailscale"):
        d["error"] = "tailscale is not installed"
        return d
    rc, out, err = _dc(["tailscale", "status", "--json"], 10)
    if rc != 0:
        msg = (err or out or "tailscale status failed").strip()
        d["error"] = (msg.splitlines() or [msg])[-1][:240]
        return d
    try:
        j = json.loads(out)
    except Exception as e:
        d["error"] = "tailscale returned invalid JSON: %s" % e
        return d
    d["available"] = True
    d["backend"] = j.get("BackendState") or "NoState"
    d["version"] = j.get("Version") or ""
    me = j.get("Self") or {}
    d["online"] = bool(me.get("Online"))
    d["ips"] = me.get("TailscaleIPs") or []
    d["dnsname"] = (me.get("DNSName") or "").rstrip(".")
    d["health"] = [str(x) for x in (j.get("Health") or [])]
    peers = j.get("Peer") or {}
    d["peers"] = len(peers)
    d["peers_online"] = sum(1 for p in peers.values() if p.get("Online"))
    ex = j.get("ExitNodeStatus") or {}
    d["exit_id"] = ex.get("ID") or ""
    d["exit_online"] = bool(ex.get("Online"))
    d["exit_ips"] = ex.get("TailscaleIPs") or []
    # Resolve the ID against the peer table as a fallback: `exit-node list`
    # can be slow or fail, and the page should still name the selected node.
    if d["exit_id"]:
        for pid, p in peers.items():
            if pid == d["exit_id"] or p.get("ID") == d["exit_id"]:
                d["exit_host"] = (p.get("DNSName") or p.get("HostName") or "").rstrip(".")
                d["exit_ip"] = next((x for x in d["exit_ips"] if "." in x), "")
                break

    # `tailscale status --json` only exposes the exit node's node ID, so ask
    # `exit-node list` for the human IP/hostname that matches the selected row.
    rc, out, _ = _dc(["tailscale", "exit-node", "list"], 10)
    for line in out.splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("IP ") or "HOSTNAME" in s:
            continue
        p = s.split()
        if len(p) < 2 or p[0].count(".") != 3:
            continue
        node = {"ip": p[0], "host": p[1], "selected": "selected" in p}
        d["exit_nodes"].append(node)
        if node["selected"]:
            d["exit_ip"], d["exit_host"] = node["ip"], node["host"]
    return d

def _net_state(probe=True, scan=False):
    """Collect one snapshot for the page. Safe for a worker thread."""
    d = {"services": {}, "devices": [], "active": None, "ip": {}, "route": "",
         "dns": [], "nm_dns": [], "nm": {}, "wifi": {}, "wifi_aps": [], "dhcp": {},
         "conn_security": {}, "ts": {}, "probe": {}, "resolv": "",
         "nm_conf": "", "dhcp_owner": "unknown", "nm_dhcp_backend": "internal",
         "verdict": ("CHECKING", "hot", ""), "error": None}

    d["resolv"] = _read_text("/etc/resolv.conf")
    d["nm_conf"] = _read_text("/etc/NetworkManager/NetworkManager.conf")

    for name, _ in SERVICE_CHIPS:
        d["services"][name] = _svc_state(name)

    if have("nmcli"):
        rc, out, err = _dc(["nmcli", "-t", "-f", "RUNNING,STATE,CONNECTIVITY", "general"], 6)
        parts = _nm_split(out.strip()) if out.strip() else []
        d["nm"] = {"running": parts[0] if len(parts) > 0 else "",
                   "state": parts[1] if len(parts) > 1 else "",
                   "connectivity": parts[2] if len(parts) > 2 else ""}
        rc, out, err = _dc(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"], 8)
        for line in out.splitlines():
            p = _nm_split(line)
            if len(p) >= 4:
                d["devices"].append({"device": p[0], "type": p[1],
                                     "state": p[2], "connection": p[3]})
        skip = ("tailscale", "docker", "virbr", "lo")
        for dev in d["devices"]:
            if dev["type"] in ("wifi", "ethernet") and dev["state"].startswith("connected") \
               and not dev["device"].startswith(skip):
                d["active"] = dev
                break

    rc, out, _ = _dc(["ip", "-brief", "-4", "addr", "show"], 6)
    for line in out.splitlines():
        p = line.split()
        if len(p) >= 3:
            d["ip"][p[0]] = p[2:]
    rc, out, _ = _dc(["ip", "-4", "route", "show", "default"], 6)
    d["route"] = out.strip()
    d["dns"] = [l.split()[1] for l in d["resolv"].splitlines()
                if l.strip().lower().startswith("nameserver") and len(l.split()) > 1]

    # NetworkManager may not be the one managing the link (dhcpcd, networkd,
    # iwd). Fall back to the device that carries the default route so the page
    # still shows an interface instead of claiming there is no network.
    if d["active"] is None and d["route"]:
        m = re.search(r"\bdev\s+(\S+)", d["route"])
        if m:
            dev = m.group(1)
            wifi = os.path.exists("/sys/class/net/%s/wireless" % dev)
            d["active"] = {"device": dev, "type": "wifi" if wifi else "ethernet",
                           "state": "up (not managed by NetworkManager)",
                           "connection": ""}

    if d["active"] and have("nmcli"):
        dev = d["active"]["device"]
        rc, out, _ = _dc(["nmcli", "device", "show", dev], 10)
        d["iface_detail"] = _kv(out)
        d["nm_dns"] = [l.split(":", 1)[1].strip() for l in out.splitlines()
                       if l.strip().startswith("IP4.DNS")]
        name = d["active"]["connection"]
        if name:
            # The lease lives on the connection, not on `device show` (NM's
            # internal DHCP client keeps it there).
            rc, out, _ = _dc(["nmcli", "-f", "DHCP4", "connection", "show", name], 6)
            for line in out.splitlines():
                if "DHCP4.OPTION" in line and " = " in line:
                    k, v = line.split(":", 1)[1].strip().split(" = ", 1)
                    d["dhcp"][k] = v
            rc, out, _ = _dc(["nmcli", "-f",
                              "802-11-wireless-security.key-mgmt,802-11-wireless-security.pmf",
                              "connection", "show", name], 6)
            d["conn_security"] = _kv(out)

    if have("nmcli"):
        cmd = ["nmcli", "-t", "-f", "IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,SECURITY",
               "device", "wifi", "list", "--rescan", "yes" if scan else "no"]
        rc, out, _ = _dc(cmd, 25 if scan else 8)
        for line in out.splitlines():
            p = _nm_split(line)
            if len(p) >= 8 and p[1]:
                d["wifi_aps"].append({"in_use": p[0].strip() == "*", "ssid": p[1],
                                      "bssid": p[2], "chan": p[3], "freq": p[4],
                                      "rate": p[5], "signal": p[6], "security": p[7]})
        d["wifi"] = next((a for a in d["wifi_aps"] if a["in_use"]), {})

    # Who is actually running DHCP? NetworkManager's own backend can be
    # internal, dhcpcd or systemd-networkd; show that rather than guessing.
    m = re.search(r"^\s*dhcp\s*=\s*(\w+)", d["nm_conf"], re.M)
    if m:
        d["nm_dhcp_backend"] = m.group(1)
    if d["services"].get("NetworkManager", ("", ""))[0] == "active":
        d["dhcp_owner"] = "NetworkManager (%s)" % d["nm_dhcp_backend"]
    elif d["services"].get("dhcpcd", ("", ""))[0] == "active":
        d["dhcp_owner"] = "dhcpcd"
    elif d["services"].get("systemd-networkd", ("", ""))[0] == "active":
        d["dhcp_owner"] = "systemd-networkd"
    elif d["services"].get("iwd", ("", ""))[0] == "active":
        d["dhcp_owner"] = "iwd (no DHCP client detected)"

    if probe:
        d["probe"] = {"tcp443": _tcp_probe("1.1.1.1", 443),
                      "tcp53": _tcp_probe("8.8.8.8", 53)}

    d["ts"] = _tailscale_info()

    # Verdict: distinguish "no local path" from "local path is fine but the
    # outbound probe failed" from NetworkManager's stricter connectivity check.
    dev = (d["active"] or {}).get("device") or ""
    ips = d["ip"].get(dev) or []
    local_ok = bool(d["route"]) and bool(ips)
    tcp_ok = bool((d["probe"].get("tcp443") or (False,))[0] or
                  (d["probe"].get("tcp53") or (False,))[0])
    nmconn = d["nm"].get("connectivity", "")
    if not local_ok:
        if d["route"] and not ips:
            d["verdict"] = ("NO INTERNET", "off", "default route exists but %s has no IPv4 address" % (dev or "the interface"))
        elif ips and not d["route"]:
            d["verdict"] = ("NO INTERNET", "off", "%s has an IPv4 address but no default route (DHCP/gateway problem)" % dev)
        else:
            d["verdict"] = ("NO INTERNET", "off", "no default route and no IPv4 address")
    elif probe and tcp_ok:
        detail = "TCP probe succeeded"
        if nmconn and nmconn != "full":
            detail += "; NetworkManager reports %s (its own check is stricter/failing)" % nmconn
        d["verdict"] = ("CONNECTED", "on", detail)
    elif probe:
        d["verdict"] = ("LOCAL ONLY", "warn",
                        "route and IPv4 are present, but TCP probes to 1.1.1.1:443 and 8.8.8.8:53 failed; "
                        "upstream may be down or egress blocked")
    elif nmconn == "portal":
        d["verdict"] = ("CAPTIVE PORTAL", "warn", "NetworkManager reports a captive portal")
    elif nmconn == "full":
        d["verdict"] = ("CONNECTED", "on", "route and IPv4 present; NetworkManager reports full connectivity")
    else:
        d["verdict"] = ("LIMITED", "warn",
                        "route and IPv4 present; NetworkManager reports %s" % (nmconn or "unknown"))
    return d

def _net_summary(d):
    """Cheap text render of an already-collected snapshot (no subprocesses)."""
    verdict, _, detail = d.get("verdict", ("?", "", ""))
    dev = (d.get("active") or {}).get("device") or ""
    ips = ", ".join(d.get("ip", {}).get(dev) or []) or "none"
    route = d.get("route") or ""
    gw = ((d.get("iface_detail") or {}).get("IP4.GATEWAY") or
          (route.split(" via ")[1].split()[0] if " via " in route else "?"))
    w = d.get("wifi") or {}
    sec = d.get("conn_security") or {}
    ts = d.get("ts") or {}
    lines = [
        "vxpanel network summary · " + time.strftime("%Y-%m-%d %H:%M:%S"),
        "",
        "VERDICT      %s — %s" % (verdict, detail),
        "INTERFACE    %s (%s) · %s" % (dev or "—", (d.get("active") or {}).get("type", "—"),
                                       (d.get("active") or {}).get("connection", "—")),
        "IPv4         %s" % ips,
        "GATEWAY      %s" % gw,
        "DNS RESOLVER %s" % (", ".join(d.get("dns") or []) or "none"),
        "DNS DHCP     %s" % (", ".join(d.get("nm_dns") or []) or "none"),
        "DHCP         %s" % d.get("dhcp_owner", "unknown"),
        "NM STATE     %s · connectivity=%s" % (d.get("nm", {}).get("state", "—"),
                                                d.get("nm", {}).get("connectivity", "—")),
        "WI-FI        %s" % (("%s · %s%% · ch %s · %s · %s" %
                              (w.get("ssid"), w.get("signal"), w.get("chan"),
                               w.get("freq"), w.get("rate"))) if w else "not connected"),
        "AP BSSID     %s" % (w.get("bssid") or "—"),
        "SECURITY     %s · key-mgmt=%s · pmf=%s" % (
            w.get("security") or "—",
            sec.get("802-11-wireless-security.key-mgmt", "—"),
            sec.get("802-11-wireless-security.pmf", "—")),
        "PROBE        " + (", ".join(
            "%s=%s" % (k, "ok" if v[0] else "fail") for k, v in (d.get("probe") or {}).items())
            or "not run"),
        "TAILSCALE    %s · %s · peers %d/%d online" % (
            ts.get("backend", "absent"), "online" if ts.get("online") else "not online",
            ts.get("peers_online", 0), ts.get("peers", 0)),
        "TS ADDRESS   %s" % (", ".join(ts.get("ips") or []) or "—"),
        "TS EXIT      %s" % (("%s (%s)" % (ts.get("exit_host"), ts.get("exit_ip")))
                             if ts.get("exit_ip") else "none"),
        "TS HEALTH    %s" % ("; ".join(ts.get("health") or []) or "none"),
        "",
        "SERVICES     " + " · ".join(
            "%s=%s/%s" % (name, d["services"].get(name, ("?", "?"))[0],
                          d["services"].get(name, ("?", "?"))[1])
            for name, _ in SERVICE_CHIPS),
        "",
        "Use “Copy report” for raw command output and journal tails.",
    ]
    return "\n".join(lines)

def _net_report():
    """A copy-pasteable diagnostic report, including recent journal lines."""
    d = _net_state(probe=True)
    out = [_net_summary(d), "", "===== RAW ====="]
    cmds = [
        ("nmcli general", ["nmcli", "-t", "-f", "RUNNING,STATE,CONNECTIVITY", "general"]),
        ("nmcli connectivity", ["nmcli", "networking", "connectivity"]),
        ("nmcli devices", ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"]),
        ("ip address", ["ip", "-brief", "addr"]),
        ("ip route", ["ip", "route"]),
        ("ip rule", ["ip", "rule"]),
        ("systemd-networkd status", ["networkctl", "status"]),
        ("tailscale status", ["tailscale", "status"]),
    ]
    for title, cmd in cmds:
        if not have(cmd[0]):
            out += ["", "$ " + title, "(not installed)"]
            continue
        rc, stdout, stderr = _dc(cmd, 20)
        out += ["", "$ " + title, (stdout or stderr).rstrip() or "(no output)"]
    if d.get("active"):
        dev = d["active"]["device"]
        rc, stdout, stderr = _dc(["nmcli", "device", "show", dev], 15)
        out += ["", "$ nmcli device show " + dev, (stdout or stderr).rstrip()]
    out += ["", "$ /etc/resolv.conf", d.get("resolv", "").rstrip()]
    out += ["", "$ /etc/NetworkManager/NetworkManager.conf", d.get("nm_conf", "").rstrip()]
    # zlstatus records every verdict change here; it is the bar's own evidence
    # trail for a no-net/no-dns/ts- episode.
    zlog = _read_text(H + "/.local/state/zlstatus/net.log").splitlines()
    out += ["", "$ ~/.local/state/zlstatus/net.log (last 40 lines)",
            "\n".join(zlog[-40:]) or "(no log yet)"]
    for unit in ("NetworkManager", "dhcpcd", "systemd-networkd", "wpa_supplicant", "iwd", "tailscaled"):
        rc, stdout, stderr = _dc(["journalctl", "-u", unit, "-n", "30", "--no-pager"], 15)
        text = (stdout or stderr).strip()
        if text:
            out += ["", "$ journalctl -u %s -n 30" % unit, text]
    return "\n".join(out)

@page("network", "Network")
def network():
    b = new_page("Network")
    st = {"dead": False, "fetching": False, "data": {}, "ap_sig": None,
          "syncing": False, "netcheck": None}

    def alive(): return not st["dead"] and b.get_parent() is not None

    def chip(text, kind=None):
        w = cls(Gtk.Label(label=text, xalign=0), "chip")
        if kind: cls(w, kind)
        w.set_valign(Gtk.Align.CENTER)
        return w

    def set_kind(w, kind):
        ctx = w.get_style_context()
        for k in ("on", "off", "hot", "warn", "run", "pause", "stop", "dead"):
            ctx.remove_class(k)
        if kind: ctx.add_class(kind)

    def value(text="—"):
        l = Gtk.Label(label=text, xalign=1)
        l.set_selectable(True)
        l.set_ellipsize(Pango.EllipsizeMode.END)
        l.set_max_width_chars(78)
        return l

    u = {}
    def put(key, text):
        if key in u: u[key].set_text(text or "—")

    # ---------------- connectivity
    c = card(b, "Connectivity")
    top = Gtk.Box(spacing=9)
    st["verdict"] = chip("CHECKING", "hot")
    st["verdict_detail"] = cls(Gtk.Label(label="Collecting…", xalign=0), "dim")
    st["verdict_detail"].set_line_wrap(True)
    top.pack_start(st["verdict"], False, False, 0)
    top.pack_start(st["verdict_detail"], True, True, 0)
    c.pack_start(top, False, False, 0)
    for key, label in (("iface", "Interface"), ("ip", "IPv4"), ("gw", "Gateway"),
                       ("dns", "DNS (resolver)"), ("dns_dhcp", "DNS (DHCP)"),
                       ("wifi", "Wi-Fi"), ("security", "Security"),
                       ("dhcp", "DHCP lease"), ("probe", "Internet probe")):
        u[key] = value(); row(c, label, u[key])

    # ---------------- services
    c = card(b, "Services  (who owns the link)")
    svc_row = Gtk.Box(spacing=7)
    svc = {}
    for name, short in SERVICE_CHIPS:
        w = chip(short + " —"); svc[name] = w; svc_row.pack_start(w, False, False, 0)
    c.pack_start(svc_row, False, False, 0)
    st["svc_note"] = cls(Gtk.Label(label="", xalign=0), "dim")
    st["svc_note"].set_line_wrap(True)
    c.pack_start(st["svc_note"], False, False, 0)
    u["owner"] = value(); row(c, "DHCP client", u["owner"])

    def open_log(unit):
        if not have("st"): return status("✗ st is not installed")
        bg(["st", "-e", "sh", "-c",
            "journalctl -u %s -n 300 --no-pager; printf '\\nPress Enter to close…'; read _" % unit])

    def restart(unit):
        if not confirm("Restart %s now?\nThe network will drop for a few seconds." % unit): return
        cmd = ["pkexec", "systemctl", "restart", unit] if have("pkexec") else ["systemctl", "restart", unit]
        run(cmd, unit + " restarted", after=lambda: refresh(force=True), always=True)

    btnrow(c,
           btn("NM log", lambda: open_log("NetworkManager")),
           btn("dhcpcd log", lambda: open_log("dhcpcd")),
           btn("Restart NM", lambda: restart("NetworkManager")),
           btn("Restart dhcpcd", lambda: restart("dhcpcd")))

    # ---------------- tailscale
    c = card(b, "Tailscale")
    def ts_toggle(on):
        if st["syncing"]: return
        run(["tailscale", "up"] if on else ["tailscale", "down"],
            "Tailscale up" if on else "Tailscale down",
            after=lambda: refresh(force=True), always=True)
    st["ts_sw"] = switch(False, ts_toggle)
    row(c, "Connected (BackendState=Running)", st["ts_sw"])
    for key, label in (("ts_state", "State"), ("ts_ips", "Address"),
                       ("ts_exit", "Exit node"), ("ts_peers", "Peers"),
                       ("ts_health", "Health")):
        u[key] = value(); row(c, label, u[key])
    st["exit_combo"] = combo(["none"], "none")
    st["exit_combo"].connect("changed", lambda w: set_exit(w.get_active_text()))
    row(c, "Use exit node", st["exit_combo"])

    def set_exit(text):
        if st["syncing"]: return
        ip = ""
        for n in ((st["data"].get("ts") or {}).get("exit_nodes") or []):
            if text == n["ip"] or text == "%s  %s" % (n["ip"], n["host"]):
                ip = n["ip"]; break
        cmd = ["tailscale", "set", "--exit-node=" + ip] if ip else ["tailscale", "set", "--exit-node="]
        run(cmd, "Exit node " + (ip or "cleared"),
            after=lambda: refresh(force=True), always=True)

    def netcheck():
        status("Running tailscale netcheck…")
        def work():
            rc, stdout, stderr = _dc(["tailscale", "netcheck"], 45)
            text = (stdout or stderr or "netcheck failed").strip()
            def fin():
                st["netcheck"] = text
                st["report_view"].get_buffer().set_text(text)
                status("✓ tailscale netcheck finished")
                return False
            GLib.idle_add(fin)
        threading.Thread(target=work, daemon=True).start()

    def copy_ts():
        copy(sh("tailscale status"))

    btnrow(c, btn("Refresh", lambda: refresh(force=True), True),
           btn("Netcheck", netcheck), btn("Copy status", copy_ts))

    # ---------------- Wi-Fi
    c = card(b, "Wi-Fi")
    u["wifi_now"] = value(); row(c, "Current", u["wifi_now"])
    u["wifi_meta"] = value(); row(c, "Radio", u["wifi_meta"])
    u["wifi_bssid"] = value(); row(c, "BSSID", u["wifi_bssid"])
    u["wifi_sec"] = value(); row(c, "Security", u["wifi_sec"])
    st["apbox"] = Gtk.Box(orientation=VERT, spacing=5)
    c.pack_start(st["apbox"], False, False, 0)

    def wifi_connect(ssid, security):
        sec = (security or "").upper()
        if not sec or sec == "OPEN" or sec.startswith("WEP"):
            run(["nmcli", "device", "wifi", "connect", ssid],
                "Connected to " + ssid, after=lambda: refresh(scan=True))
            return
        dlg = Gtk.Dialog(title="Wi-Fi password", transient_for=WIN, modal=True)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok = dlg.add_button("Connect", Gtk.ResponseType.OK)
        cls(ok, "suggested")
        box = dlg.get_content_area(); box.set_border_width(16); box.set_spacing(8)
        box.pack_start(Gtk.Label(label="Password for %s\n(%s)" % (ssid, security), xalign=0),
                       False, False, 0)
        ent = Gtk.Entry(); ent.set_visibility(False); ent.set_activates_default(True)
        box.pack_start(ent, False, False, 0)
        dlg.set_default_response(Gtk.ResponseType.OK)
        dlg.show_all(); resp = dlg.run(); pw = ent.get_text(); dlg.destroy()
        if resp != Gtk.ResponseType.OK: return
        run(["nmcli", "device", "wifi", "connect", ssid, "password", pw],
            "Connected to " + ssid, after=lambda: refresh(scan=True))

    def render_aps(aps):
        sig = tuple((a["ssid"], a["security"], a["signal"], a["in_use"]) for a in aps)
        if sig == st["ap_sig"]: return
        st["ap_sig"] = sig
        for ch in st["apbox"].get_children():
            st["apbox"].remove(ch)
        for a in aps[:14]:
            line = Gtk.Box(spacing=9)
            name = ("● " if a["in_use"] else "   ") + a["ssid"]
            line.pack_start(Gtk.Label(label=name, xalign=0), True, True, 0)
            line.pack_start(chip(a["security"] or "OPEN"), False, False, 0)
            line.pack_start(Gtk.Label(label=(a["signal"] or "?") + "%", xalign=1), False, False, 0)
            if not a["in_use"]:
                x = btn("Connect", lambda _w=None, a=a: wifi_connect(a["ssid"], a["security"]))
                cls(x, "sm")
                line.pack_end(x, False, False, 0)
            st["apbox"].pack_start(line, False, False, 0)
        st["apbox"].show_all()

    btnrow(c, btn("Scan", lambda: refresh(scan=True), True))

    # ---------------- diagnostics
    c = card(b, "Diagnostics")
    st["report_view"] = Gtk.TextView()
    st["report_view"].set_editable(False)
    st["report_view"].set_cursor_visible(False)
    st["report_view"].set_monospace(True)
    st["report_view"].set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
    sw = Gtk.ScrolledWindow()
    sw.set_min_content_height(170)
    sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
    sw.add(st["report_view"])
    c.pack_start(sw, False, False, 0)

    def copy_report():
        status("Collecting network diagnostics…")
        def work():
            text = _net_report()
            GLib.idle_add(lambda: (copy(text), False)[1])
        threading.Thread(target=work, daemon=True).start()

    btnrow(c, btn("Copy report", copy_report, True),
           btn("Refresh now", lambda: refresh(force=True)))

    # ---------------- refresh engine
    def apply(d):
        st["fetching"] = False
        if not alive(): return False
        st["data"] = d

        verdict, kind, detail = d["verdict"]
        st["verdict"].set_text(verdict); set_kind(st["verdict"], kind)
        st["verdict_detail"].set_text(detail)

        act = d.get("active") or {}
        dev = act.get("device") or ""
        ips = d["ip"].get(dev) or []
        put("iface", "%s%s" % (dev or "—", (" · " + act["connection"]) if act.get("connection") else ""))
        put("ip", ", ".join(ips) or "none")
        if " via " in (d.get("route") or ""):
            put("gw", d["route"].split(" via ")[1].split()[0])
        else:
            put("gw", (d.get("iface_detail") or {}).get("IP4.GATEWAY", "—"))
        put("dns", ", ".join(d.get("dns") or []) or "none")
        put("dns_dhcp", ", ".join(d.get("nm_dns") or []) or "none reported")
        put("owner", d.get("dhcp_owner", "unknown"))

        w = d.get("wifi") or {}
        sec = d.get("conn_security") or {}
        if w:
            put("wifi", "%s · %s%% · ch %s · %s · %s" %
                (w.get("ssid"), w.get("signal"), w.get("chan"), w.get("freq"), w.get("rate")))
            put("wifi_now", w.get("ssid", "—"))
            put("wifi_meta", "signal %s%% · ch %s · %s · %s" %
                (w.get("signal"), w.get("chan"), w.get("freq"), w.get("rate")))
            put("wifi_bssid", w.get("bssid") or "—")
            secline = "%s · %s · PMF %s" % (
                w.get("security") or "—",
                sec.get("802-11-wireless-security.key-mgmt", "—"),
                sec.get("802-11-wireless-security.pmf", "—"))
            put("security", secline)
            put("wifi_sec", secline)
        else:
            put("wifi", "not connected")
            put("wifi_now", "—")
            put("wifi_meta", "—")
            put("wifi_bssid", "—")
            put("security", "—")
            put("wifi_sec", "—")

        dh = d.get("dhcp") or {}
        if dh:
            expiry = dh.get("expiry")
            try:
                expiry = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(expiry))) if expiry else "unknown"
            except Exception:
                expiry = "unknown"
            put("dhcp", "server %s · lease expires %s" %
                (dh.get("dhcp_server_identifier", "?"), expiry))
        else:
            put("dhcp", "none reported (static address or another DHCP client)")

        probe = d.get("probe") or {}
        bits = []
        for key, label in (("tcp443", "1.1.1.1:443"), ("tcp53", "8.8.8.8:53")):
            ok, err = probe.get(key, (None, ""))
            bits.append("%s %s" % (label, "ok" if ok else ("failed (%s)" % err if err else "not run")))
        put("probe", " · ".join(bits))

        for name, short in SERVICE_CHIPS:
            active, enabled = d["services"].get(name, ("unknown", "unknown"))
            w = svc[name]
            w.set_text("%s %s" % (short, active.upper()))
            set_kind(w, "run" if active == "active" else
                        "warn" if active in ("activating", "reloading", "deactivating") else
                        "dead" if active == "failed" else "stop")
            w.set_tooltip_text("%s: %s, %s" % (name, active, enabled))
        active_svcs = [n for n, (a, _) in d["services"].items() if a == "active"]
        st["svc_note"].set_text(
            "Active: %s\nDHCP: %s · NetworkManager connectivity=%s · NM dhcp backend=%s" %
            (", ".join(active_svcs) or "none", d.get("dhcp_owner", "unknown"),
             d.get("nm", {}).get("connectivity", "—"), d.get("nm_dhcp_backend", "internal")))

        ts = d.get("ts") or {}
        running = ts.get("backend") == "Running"
        st["syncing"] = True
        st["ts_sw"].set_active(running)
        st["syncing"] = False
        put("ts_state", "%s%s" % (ts.get("backend", "absent"),
                                  " · online" if ts.get("online") else " · not online"))
        put("ts_ips", ", ".join(ts.get("ips") or []) or "—")
        if ts.get("exit_ip"):
            put("ts_exit", "%s (%s)%s" % (ts.get("exit_host"), ts.get("exit_ip"),
                                          "" if ts.get("exit_online") else " · offline"))
        else:
            put("ts_exit", "none")
        put("ts_peers", "%d online / %d known" % (ts.get("peers_online", 0), ts.get("peers", 0)))
        health = "; ".join(ts.get("health") or [])
        put("ts_health", health or ts.get("error") or "none")
        if not ts.get("available"):
            set_kind(st["ts_sw"], "stop")
        else:
            set_kind(st["ts_sw"], "on" if running and ts.get("online") else
                     "warn" if running else "stop")

        nodes = ts.get("exit_nodes") or []
        st["syncing"] = True
        st["exit_combo"].remove_all()
        st["exit_combo"].append_text("none")
        for n in nodes:
            st["exit_combo"].append_text("%s  %s" % (n["ip"], n["host"]))
        target = "%s  %s" % (ts.get("exit_ip"), ts.get("exit_host")) if ts.get("exit_ip") else "none"
        idx = 0
        model = st["exit_combo"].get_model()
        for i in range(len(model)):
            if model[i][0] == target:
                idx = i; break
        st["exit_combo"].set_active(idx)
        st["syncing"] = False

        render_aps(d.get("wifi_aps") or [])
        if st["netcheck"] is None:
            st["report_view"].get_buffer().set_text(_net_summary(d))
        return False

    def refresh(force=False, scan=False):
        # A manual refresh (or an action that changes the link) returns the
        # diagnostics box to the summary; the 10s tick must not, or a netcheck
        # result would disappear seconds after it appeared.
        if force or scan:
            st["netcheck"] = None
        if not alive() or st["fetching"]: return
        st["fetching"] = True
        def work():
            try:
                d = _net_state(probe=True, scan=scan)
            except Exception as e:
                d = {"verdict": ("ERROR", "dead", str(e)), "services": {}, "ip": {},
                     "route": "", "dns": [], "nm": {}, "wifi": {}, "wifi_aps": [],
                     "dhcp": {}, "conn_security": {}, "ts": {}, "probe": {},
                     "resolv": "", "nm_conf": "", "dhcp_owner": "unknown",
                     "nm_dhcp_backend": "internal", "active": None, "devices": []}
            GLib.idle_add(apply, d)
            return False
        threading.Thread(target=work, daemon=True).start()

    def tick():
        if not alive(): return False
        if WIN and WIN.stack.get_visible_child_name() == "network":
            refresh()
        return True

    if NET_TIMER["id"] and GLib.MainContext.default().find_source_by_id(NET_TIMER["id"]):
        GLib.source_remove(NET_TIMER["id"])
    NET_TIMER["id"] = GLib.timeout_add(10000, tick)
    b.connect("destroy", lambda _w: st.update(dead=True))
    GLib.timeout_add(60, lambda: (refresh(force=True), False)[1])
    return b


# ---------------------------------------------------------------- Logs
@page("logs", "Logs")
def logs():
    """Unified journal viewer. Collection runs off the GTK thread; rendering is
    filtered locally so typing/searching never starts another journal query."""
    b = new_page("Logs")
    st = {"dead": False, "rows": [], "source": "all", "query": "", "since": "boot"}

    sources = {
        # Always bound the query. A complete boot journal can be enormous and
        # made the old tab appear stale while GTK was rendering thousands of
        # historical lines before reaching the current entries.
        "all": ("All system logs · latest", ["journalctl", "-b", "0", "-n", "3000", "-o", "short-iso", "--no-pager"]),
        "kernel": ("Kernel / drivers · latest", ["journalctl", "-k", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
        "boot": ("Boot / firmware / BIOS", ["journalctl", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
        "gpu": ("GPU / NVIDIA / DRM", ["journalctl", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
        "cpu": ("CPU / system", ["journalctl", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
        # Tailscale is intentionally a short, recent diagnostic window. It
        # keeps the control-plane failures (map poll, DNS, DERP, reconnects)
        # visible instead of burying them in old startup noise.
        "tailscale": ("Tailscale · live diagnostics", ["journalctl", "-u", "tailscaled", "--since", "2 hours ago", "-n", "1000", "-o", "short-iso", "--no-pager"]),
        "docker": ("Docker / containers", ["journalctl", "-u", "docker", "-u", "containerd", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
        "network": ("Network / DNS", ["journalctl", "-u", "NetworkManager", "-u", "systemd-resolved", "-u", "iwd", "-b", "0", "-n", "2000", "-o", "short-iso", "--no-pager"]),
        "xorg": ("Xorg / desktop", ["journalctl", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
        "zlstatus": ("zlstatus", ["journalctl", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
        "user": ("User services", ["journalctl", "--user", "-b", "0", "-n", "1500", "-o", "short-iso", "--no-pager"]),
    }
    keywords = {
        "gpu": r"nvidia|nvrm|drm|gpu|amdgpu|mesa|cuda|vulkan",
        "cpu": r"cpu|thermal|microcode|oom|memory|segfault|watchdog|hardware error",
        "boot": r"efi|firmware|bios|uefi|acpi|microcode|boot|initramfs|secure boot",
        "xorg": r"xorg|x11|vxwm|xinit|xserver|compositor|xcompmgr|dunst",
        "zlstatus": r"zlstatus",
    }
    # High-signal events are useful when the user searches the all-log view.
    # The Tailscale source itself is deliberately unfiltered so no diagnosis
    # disappears from the panel.
    keywords["tailscale"] = r"tailscale|tailscaled|mapresponse|netmap|derp|controlplane|coordination|health|dns|control:|poll|timeout|online|relay|wireguard|magicsock"

    top = Gtk.Box(spacing=7)
    source = Gtk.ComboBoxText()
    for key, (label, _cmd) in sources.items(): source.append(key, label)
    source.set_active_id("all")
    source.set_tooltip_text("Choose a log source")
    search = Gtk.SearchEntry(); search.set_placeholder_text("Search logs…"); search.set_width_chars(24)
    since = Gtk.ComboBoxText()
    for key, label in (("boot", "Current boot"), ("today", "Today"), ("all", "All available")):
        since.append(key, label)
    since.set_active_id("boot")
    refresh_btn = btn("Refresh", lambda: fetch(), True); cls(refresh_btn, "sm")
    copy_btn = btn("Copy visible", lambda: copy_visible(), False); cls(copy_btn, "sm")
    top.pack_start(source, False, False, 0); top.pack_start(since, False, False, 0)
    top.pack_start(search, True, True, 0); top.pack_start(refresh_btn, False, False, 0); top.pack_start(copy_btn, False, False, 0)
    b.pack_start(top, False, False, 0)

    info = Gtk.Label(label="Loading logs…", xalign=0); cls(info, "dim"); b.pack_start(info, False, False, 0)
    text = Gtk.TextView(); text.set_editable(False); text.set_cursor_visible(False); text.set_monospace(True); text.set_wrap_mode(Gtk.WrapMode.NONE)
    text.set_left_margin(8); text.set_right_margin(8); text.set_top_margin(6); text.set_bottom_margin(6)
    text.get_style_context().add_class("logview")
    buf = text.get_buffer()
    tags = {
        "error": buf.create_tag("log-error", foreground="#ff6b81", weight=Pango.Weight.BOLD),
        "warn": buf.create_tag("log-warn", foreground="#f5c76b"),
        "info": buf.create_tag("log-info", foreground="#a9d6ff"),
        "debug": buf.create_tag("log-debug", foreground="#8b93a7"),
        "source": buf.create_tag("log-source", foreground="#c7a6ff"),
    }
    scroll = Gtk.ScrolledWindow(); scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC); scroll.add(text)
    b.pack_start(scroll, True, True, 0)

    def alive(): return not st["dead"] and b.get_parent() is not None
    def classify(line):
        x = line.lower()
        if any(k in x for k in (" emergency", " alert", " critical", " crit", " error", " failed", " failure", " panic", " oops", " timeout", " oom")):
            return "error"
        if any(k in x for k in (" warning", " warn", " degraded", " retry", " denied", " obsolete")):
            return "warn"
        if any(k in x for k in (" debug", " trace")): return "debug"
        return "info"
    def visible_rows():
        q = st["query"].strip().lower()
        key = st["source"]
        rows = st["rows"]
        if key in keywords:
            import re as _re
            rx = _re.compile(keywords[key], _re.I)
            rows = [x for x in rows if rx.search(x)]
        if q: rows = [x for x in rows if q in x.lower()]
        return rows
    def render():
        if not alive(): return
        rows = visible_rows()
        buf.set_text("")
        it = buf.get_end_iter()
        for line in rows:
            tag = tags[classify(line)]
            buf.insert_with_tags(it, line + "\n", tag)
        info.set_text("%d shown / %d loaded  •  %s" % (len(rows), len(st["rows"]), sources[st["source"]][0]))
        # Keep the most recent entries visible after refresh, but let the user
        # scroll/search without jumping on every keystroke.
        GLib.idle_add(lambda: (scroll.get_vadjustment().set_value(scroll.get_vadjustment().get_upper()), False)[1] if not st.get("user_scrolled") else False)
    def worker(cmd, source_key, since_key):
        c = list(cmd)
        # Add time selectors as real journalctl options. The old fixed
        # insertion point put --since between -u and its unit name for the
        # Tailscale source, producing an invalid query and an apparently empty
        # Logs tab.
        if since_key == "today":
            c += ["--since", "today"]
        elif since_key == "all":
            c = [x for x in c if x not in ("-b", "0")]
        try:
            r = subprocess.run(c, capture_output=True, text=True, errors="replace", timeout=20)
            data = r.stdout.splitlines()
            # Keyword sources are narrowed in Python because the journal query
            # remains portable and useful even when unit names differ.
            if source_key in keywords:
                import re as _re
                rx = _re.compile(keywords[source_key], _re.I)
                data = [x for x in data if rx.search(x)]
            return data[-12000:], r.returncode, r.stderr.strip()
        except Exception as e:
            return [], 1, str(e)
    def fetch():
        if not alive(): return
        key, sk = st["source"], st["since"]
        source.set_sensitive(False); refresh_btn.set_sensitive(False); info.set_text("Loading %s…" % sources[key][0])
        def work():
            rows, rc, err = worker(sources[key][1], key, sk)
            def apply():
                source.set_sensitive(True); refresh_btn.set_sensitive(True)
                if not alive(): return False
                st["rows"] = rows
                if rc and not rows: info.set_text("Log query failed: " + (err or "journalctl failed"))
                render(); return False
            GLib.idle_add(apply)
        threading.Thread(target=work, daemon=True).start()
    def source_changed(w):
        st["source"] = w.get_active_id() or "all"; fetch()
    def since_changed(w):
        st["since"] = w.get_active_id() or "boot"; fetch()
    def search_changed(w):
        st["query"] = w.get_text(); render()
    def copy_visible():
        copy("\n".join(visible_rows())); status("✓ visible logs copied")
    source.connect("changed", source_changed); since.connect("changed", since_changed); search.connect("search-changed", search_changed)
    b.connect("destroy", lambda _w: st.update(dead=True))
    GLib.timeout_add(5000, lambda: (fetch(), True)[1] if alive() else False)
    fetch()
    return b
# ---------------------------------------------------------------- Docker
# Live container list + disk usage + prune actions. Docker is polled only while
# this page is on screen, and rows are rebuilt only when something changed, so
# idle refreshes do not reset the scroll position.
DOCKER_TIMER = {"id": 0}

def _dc(cmd, timeout=60):
    """(rc, stdout, stderr) - never raises, so the panel cannot die on docker."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except FileNotFoundError:
        name = cmd[0] if isinstance(cmd, list) else str(cmd).split()[0]
        return 127, "", "%s is not installed" % name
    except subprocess.TimeoutExpired:
        return 124, "", "docker timed out"
    except Exception as e:
        return 1, "", str(e)

_SIZE_RE = re.compile(r"([\d.]+)\s*([kKmMgGtT]?i?[bB])")
_SIZE_MULT = {"b": 1, "kb": 1e3, "mb": 1e6, "gb": 1e9, "tb": 1e12,
              "kib": 1024, "mib": 1024 ** 2, "gib": 1024 ** 3, "tib": 1024 ** 4}

def size_bytes(s):
    if not s: return 0
    m = _SIZE_RE.search(str(s).split("(")[0])
    if not m: return 0
    try: return int(float(m.group(1)) * _SIZE_MULT[m.group(2).lower()])
    except (ValueError, KeyError): return 0

def size_human(n):
    if n <= 0: return "0 B"
    for unit, div in (("TB", 1e12), ("GB", 1e9), ("MB", 1e6), ("kB", 1e3)):
        if n >= div: return "%.2f %s" % (n / div, unit)
    return "%d B" % n

def container_size(obj):
    """Return readable actual writable and virtual container sizes."""
    value = obj.get("Size")
    if isinstance(value, dict):
        rw = value.get("rwSize", 0)
        root = value.get("rootFsSize", 0)
        if rw or root:
            return "used %s · virtual %s" % (size_human(rw), size_human(root))
    # Docker/older Podman may provide a human-readable Size string.
    text = obj.get("SizeRw") or value or ""
    if text:
        text = str(text)
        # Podman reports e.g. "9.33GB (virtual 9.58GB)". Keep both values,
        # but normalize the label so the panel clearly shows disk usage.
        m = re.match(r"\s*([^()]+?)(?:\s*\(virtual\s+([^()]+)\))?\s*$", text, re.I)
        if m:
            used, virtual = m.group(1).strip(), m.group(2)
            return "used %s%s" % (used, " · virtual " + virtual.strip() if virtual else "")
        return text
    return "size unavailable"

def _docker_state(full=True):
    """(containers, system df rows, info, error) - safe for a worker thread.
    df is None when full=False, meaning 'keep the previous storage numbers'."""
    rc, out, err = _dc(["docker", "info", "--format", "{{json .}}"], 20)
    if rc != 0:
        msg = err or out or "docker daemon is not reachable"
        low = msg.lower()
        if "permission denied" in low:
            msg = "Permission denied on /var/run/docker.sock — add $USER to the docker group."
        elif "failed to connect" in low or "cannot connect" in low or "no such file" in low:
            msg = "Docker daemon is not reachable.\nStart it with: sudo systemctl start docker"
        else:
            msg = msg.splitlines()[0][:300]
        return [], [], {}, msg
    try: info = json.loads(out)
    except Exception: info = {}

    rc, out, err = _dc(["docker", "ps", "-a", "--format", "{{json .}}"], 30)
    if rc != 0:
        return [], [], info, err or "could not list containers"
    containers = []
    for line in out.splitlines():
        if line.strip():
            try: containers.append(json.loads(line))
            except Exception: pass

    rc, out, _ = _dc(["docker", "system", "df", "--format", "{{json .}}"], 60) if full else (0, "", "")
    df = [] if full else None
    if rc == 0 and full:
        for line in out.splitlines():
            if line.strip():
                try: df.append(json.loads(line))
                except Exception: pass

    def order(c):
        state = (c.get("State") or "").lower()
        return ({"running": 0, "restarting": 1, "paused": 2, "created": 3, "exited": 4, "dead": 5}
                .get(state, 6), (c.get("Names") or "").lower())
    containers.sort(key=order)
    return containers, df, info, None


@page("docker", "Docker")
def docker():
    b = new_page("Docker")
    bgc, fg, pal = load_colors()
    accent, ok, warn, purple = pal[4], pal[2], pal[3], pal[5]
    st = {"containers": [], "df": [], "info": {}, "error": None, "filter": "all",
          "sig": None, "df_sig": None, "df_at": 0, "busy": False, "fetching": False,
          "storage": [], "dead": False}

    def alive(): return not st["dead"] and b.get_parent() is not None

    def chip(text, kind=None):
        w = cls(Gtk.Label(label=text, xalign=0), "chip")
        if kind: cls(w, kind)
        w.set_valign(Gtk.Align.CENTER)
        return w

    def set_kind(w, kind):
        ctx = w.get_style_context()
        for k in ("on", "off", "hot", "warn"):
            ctx.remove_class(k)
        if kind: ctx.add_class(kind)

    def term(title, argv):
        if not have("st"): return status("✗ st is not installed")
        bg(["st", "-c", "vxpanel-term", "-t", title, "-e"] + argv)

    # ---------------- engine overview
    c = card(b, "Engine")
    chips = Gtk.Box(spacing=7)
    st["engine"] = chip("CONNECTING")
    st["version"] = chip("engine —")
    st["driver"] = chip("—")
    st["host"] = chip("—")
    for w in (st["engine"], st["version"], st["driver"], st["host"]):
        chips.pack_start(w, False, False, 0)
    c.pack_start(chips, False, False, 0)
    line = Gtk.Box(spacing=10)
    st["counts"] = cls(Gtk.Label(label="—", xalign=0), "dim")
    line.pack_start(st["counts"], False, False, 0)
    line.pack_start(Gtk.Box(), True, True, 0)
    st["updated"] = cls(Gtk.Label(label="waiting…", xalign=0), "dim")
    line.pack_end(st["updated"], False, False, 0)
    def manual_refresh():
        st["acted"] = 0
        status("Refreshing docker…")
        refresh(True)
    ref = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
    cls(ref, "sm"); ref.set_tooltip_text("Refresh now")
    ref.connect("clicked", lambda _w: manual_refresh())
    line.pack_end(ref, False, False, 0)
    c.pack_start(line, False, False, 0)

    # ---------------- containers
    c = cls(Gtk.Box(orientation=VERT, spacing=8), "card")
    b.pack_start(c, False, False, 0)
    head = Gtk.Box(spacing=10)
    head.pack_start(cls(Gtk.Label(label="CONTAINERS", xalign=0), "h"), False, False, 0)
    st["shown"] = cls(Gtk.Label(label="—", xalign=0), "dim")
    head.pack_start(st["shown"], False, False, 0)
    head.pack_start(Gtk.Box(), True, True, 0)
    fbox = Gtk.Box(spacing=6)
    fbtns = {}
    for key, text in (("all", "All"), ("running", "Running"), ("stopped", "Stopped")):
        fb = Gtk.ToggleButton(label=text)
        cls(fb, "sm")
        fb.set_active(key == "all")
        # "clicked" fires before GTK flips the toggle (its class handler runs
        # last and would undo set_active), so drive everything from "toggled".
        fb.connect("toggled", lambda w, k=key: filter_toggled(w, k))
        fbtns[key] = fb
        fbox.pack_start(fb, False, False, 0)
    head.pack_end(fbox, False, False, 0)
    c.pack_start(head, False, False, 0)

    lst = Gtk.ListBox()
    lst.set_selection_mode(Gtk.SelectionMode.NONE)
    cls(lst, "ctrlist")
    c.pack_start(lst, False, False, 0)

    # ---------------- storage
    c = cls(Gtk.Box(orientation=VERT, spacing=9), "card")
    b.pack_start(c, False, False, 0)
    head = Gtk.Box(spacing=10)
    head.pack_start(cls(Gtk.Label(label="STORAGE", xalign=0), "h"), False, False, 0)
    head.pack_start(Gtk.Box(), True, True, 0)
    st["total"] = cls(Gtk.Label(label="total —", xalign=0), "dim")
    st["total"].set_tooltip_text("Images + containers + volumes + build cache")
    head.pack_start(st["total"], False, False, 0)
    st["reclaim"] = chip("reclaimable —", "warn")
    head.pack_end(st["reclaim"], False, False, 0)
    c.pack_start(head, False, False, 0)

    bar = Gtk.DrawingArea()
    bar.set_size_request(-1, 8)
    bar.connect("draw", lambda w, cr: draw_bar(w, cr))
    c.pack_start(bar, False, False, 0)

    legend = Gtk.Box(spacing=18)
    c.pack_start(legend, False, False, 0)

    acts = Gtk.Box(spacing=8)
    for text, tip, fn in (
        ("Prune build cache", "Delete build cache not used by any image", lambda: prune_cache()),
        ("Prune unused images", "Delete images not used by any container", lambda: prune_images()),
        ("Remove stopped", "Delete all stopped containers", lambda: remove_stopped()),
    ):
        x = btn(text, fn); cls(x, "sm"); x.set_tooltip_text(tip)
        acts.pack_start(x, False, False, 0)
    acts.pack_start(Gtk.Box(), True, True, 0)
    full = btn("Full cleanup…", lambda: full_cleanup())
    cls(full, "danger")
    full.set_tooltip_text("Remove all unused containers, images, networks, build cache and optionally volumes")
    acts.pack_end(full, False, False, 0)
    c.pack_start(acts, False, False, 0)

    # ---------------- rendering
    def draw_bar(w, cr):
        width, height = w.get_allocated_width(), w.get_allocated_height()
        cr.set_source_rgb(*hex2rgb(mix(bgc, fg, 0.13)))
        cr.rectangle(0, 0, width, height); cr.fill()
        total = sum(n for _, n, _ in st["storage"])
        if total <= 0: return False
        x = 0.0
        for _name, n, color in st["storage"]:
            seg = width * n / total
            cr.set_source_rgb(*hex2rgb(color))
            cr.rectangle(x + 0.5, 0, max(seg - 1, 1), height); cr.fill()
            x += seg
        return False

    def render_storage(df):
        sig = tuple((r.get("Type"), r.get("Size"), r.get("Reclaimable"), r.get("TotalCount")) for r in df)
        if sig == st["df_sig"]: return
        st["df_sig"] = sig
        for ch in legend.get_children(): legend.remove(ch)
        rows = {r.get("Type", ""): r for r in df}
        specs = (("Images", "Images", accent), ("Containers", "Containers", ok),
                 ("Local Volumes", "Volumes", purple), ("Build Cache", "Build cache", warn))
        st["storage"] = []
        total = reclaim = 0
        for key, name, color in specs:
            r = rows.get(key)
            size = size_bytes(r.get("Size")) if r else 0
            total += size
            reclaim += size_bytes(r.get("Reclaimable")) if r else 0
            count = int(r.get("TotalCount") or 0) if r else 0
            if size > 0: st["storage"].append((name, size, color))
            item = Gtk.Box(spacing=6)
            dot = Gtk.Label()
            dot.set_markup('<span foreground="%s">■</span>' % color)
            item.pack_start(dot, False, False, 0)
            item.pack_start(cls(Gtk.Label(label=name, xalign=0), "dim"), False, False, 0)
            item.pack_start(cls(Gtk.Label(label=size_human(size) + ("  (%d)" % count if count else ""), xalign=0), "dim"), False, False, 0)
            legend.pack_start(item, False, False, 0)
        st["total"].set_text("total " + size_human(total))
        st["reclaim"].set_text("reclaimable " + size_human(reclaim))
        legend.show_all()
        bar.queue_draw()

    def row_for(cobj):
        cid = cobj.get("ID") or ""
        name = cobj.get("Names") or cid[:12]
        state = (cobj.get("State") or "unknown").lower()
        status_txt = cobj.get("Status") or ""
        image = cobj.get("Image") or ""
        ports = cobj.get("Ports") or ""
        running = state in ("running", "restarting", "paused")

        r = Gtk.ListBoxRow()
        cls(r, "ctr")
        h = Gtk.Box(spacing=12)
        dot = Gtk.Label(label="●")
        cls(dot, {"running": "st-run", "paused": "st-pause", "restarting": "st-pause",
                  "dead": "st-dead"}.get(state, "st-stop"))
        dot.set_valign(Gtk.Align.CENTER)
        h.pack_start(dot, False, False, 0)

        text = Gtk.Box(orientation=VERT, spacing=2)
        top = Gtk.Box(spacing=8)
        nm = cls(Gtk.Label(label=name, xalign=0), "name")
        nm.set_ellipsize(Pango.EllipsizeMode.END)
        top.pack_start(nm, False, False, 0)
        pill = chip(state.upper(), {"running": "run", "paused": "pause",
                                    "dead": "dead"}.get(state, "stop"))
        top.pack_start(pill, False, False, 0)
        text.pack_start(top, False, False, 0)
        sub = "%s  ·  %s" % (image, status_txt) if status_txt else image
        s = cls(Gtk.Label(label=sub, xalign=0), "dim")
        s.set_ellipsize(Pango.EllipsizeMode.END); s.set_max_width_chars(56)
        text.pack_start(s, False, False, 0)
        if ports:
            p = cls(Gtk.Label(label=ports, xalign=0), "dim")
            p.set_ellipsize(Pango.EllipsizeMode.END); p.set_max_width_chars(56)
            text.pack_start(p, False, False, 0)
        h.pack_start(text, True, True, 0)

        power = btn("Stop" if running else "Start", lambda: power_toggle(cid, running))
        cls(power, "sm"); power.set_tooltip_text("Stop container" if running else "Start container")
        power.set_valign(Gtk.Align.CENTER)
        rs = btn("Restart", lambda: job(["docker", "restart", cid], "Restarting %s…" % name, "Restarted " + name))
        cls(rs, "sm"); rs.set_sensitive(running); rs.set_tooltip_text("Restart container")
        rs.set_valign(Gtk.Align.CENTER)

        m = Gtk.MenuButton()
        m.set_image(Gtk.Image.new_from_icon_name("view-more-symbolic", Gtk.IconSize.BUTTON))
        cls(m, "sm"); m.set_tooltip_text("More actions")
        m.set_valign(Gtk.Align.CENTER)
        m.set_size_request(34, -1)
        pop = Gtk.Popover()
        pbox = Gtk.Box(orientation=VERT, spacing=2); pbox.set_border_width(4)
        for text_, fn, danger in (
            ("Logs", lambda: (term("logs: " + name, ["docker", "logs", "--tail", "300", "-f", cid]),
                              status("Following logs for " + name)), False),
            ("Shell", lambda: (term("shell: " + name, ["docker", "exec", "-it", cid, "sh", "-c",
                              "command -v bash >/dev/null 2>&1 && exec bash || exec sh"]),
                              status("Shell opened in " + name)), False),
            ("Copy ID", lambda: copy(cid), False),
            ("Remove…", lambda: remove_container(cid, name, running), True),
        ):
            x = Gtk.Button.new_with_label(text_)
            x.set_relief(Gtk.ReliefStyle.NONE)
            x.set_size_request(150, -1)
            x.connect("clicked", lambda _w, f=fn: (pop.popdown(), f()))
            if danger: cls(x, "danger")
            pbox.pack_start(x, False, False, 0)
        pop.add(pbox); m.set_popover(pop)
        pbox.show_all()

        h.pack_end(power, False, False, 0)
        h.pack_end(rs, False, False, 0)
        h.pack_end(m, False, False, 0)
        r.add(h)
        return r

    def render_rows(force=False):
        if not alive(): return
        cs = st["containers"]
        if st["filter"] == "running":
            cs = [c for c in cs if (c.get("State") or "").lower() in ("running", "restarting", "paused")]
        elif st["filter"] == "stopped":
            cs = [c for c in cs if (c.get("State") or "").lower() not in ("running", "restarting", "paused")]
        sig = (st["filter"], st["error"],
               tuple((x.get("ID"), x.get("State"), x.get("Status"), x.get("Ports")) for x in cs))
        if not force and sig == st["sig"]: return
        st["sig"] = sig
        for ch in lst.get_children(): lst.remove(ch)
        if st["error"]:
            box = Gtk.Box(orientation=VERT, spacing=6)
            box.set_border_width(8)
            e = cls(Gtk.Label(label=st["error"], xalign=0), "st-dead")
            e.set_line_wrap(True)
            box.pack_start(e, False, False, 0)
            box.pack_start(cls(Gtk.Label(label="Fix docker access, then press ⟳.", xalign=0), "dim"), False, False, 0)
            lst.add(box)
        elif not cs:
            empty = Gtk.Label(label="No containers here.", xalign=0)
            cls(empty, "dim")
            empty.set_margin_start(8); empty.set_margin_end(8)
            empty.set_margin_top(8); empty.set_margin_bottom(8)
            lst.add(empty)
        else:
            for cobj in cs: lst.add(row_for(cobj))
        lst.show_all()
        running = sum(1 for x in st["containers"] if (x.get("State") or "").lower() == "running")
        st["shown"].set_text("%d shown · %d running" % (len(cs), running))

    def apply(state, force=False):
        if not alive(): return False
        containers, df, info, error = state
        st.update(containers=containers, info=info, error=error, fetching=False)
        if df is not None:
            st["df"] = df
            st["df_at"] = time.time()
        st["updated"].set_text("updated " + time.strftime("%H:%M:%S"))
        if error:
            st["engine"].set_text("OFFLINE"); set_kind(st["engine"], "off")
            st["version"].set_text("engine —"); st["driver"].set_text("—"); st["host"].set_text("—")
            st["counts"].set_text("docker is not reachable")
        else:
            st["engine"].set_text("ONLINE"); set_kind(st["engine"], "on")
            st["version"].set_text("v" + (info.get("ServerVersion") or "?"))
            st["driver"].set_text(info.get("Driver") or "?")
            if info.get("DockerRootDir"):
                st["engine"].set_tooltip_text("Docker root: " + info["DockerRootDir"])
            if info.get("APIVersion"):
                st["version"].set_tooltip_text("API " + info["APIVersion"])
            host = info.get("OperatingSystem") or "linux"
            if info.get("NCPU"): host += " · %d CPU" % info["NCPU"]
            if info.get("MemTotal"): host += " · %.1f GiB" % (info["MemTotal"] / 1024 ** 3)
            st["host"].set_text(host)
            run = sum(1 for x in containers if (x.get("State") or "").lower() == "running")
            paused = sum(1 for x in containers if (x.get("State") or "").lower() == "paused")
            stopped = sum(1 for x in containers if (x.get("State") or "").lower() in ("exited", "created", "dead"))
            parts = ["%d running" % run]
            if paused: parts.append("%d paused" % paused)
            parts.append("%d stopped" % stopped)
            parts.append("%d images" % (info.get("Images") or 0))
            st["counts"].set_text(" · ".join(parts))
        render_storage(st["df"])
        render_rows(force)
        on_screen = WIN and WIN.stack.get_visible_child_name() == "docker"
        if on_screen and error:
            status("✗ docker unreachable - " + error.splitlines()[0][:120])
        elif on_screen and time.time() - st.get("acted", 0) > 6:
            # keep a just-finished action's message on screen
            status("✓ Docker refreshed · " + time.strftime("%H:%M:%S"))
        return False

    def refresh(force=False):
        if not alive() or st["fetching"] or st["busy"]: return
        st["fetching"] = True
        # `docker system df` walks the whole store, so only pay for it every
        # 30s (and after any action). Containers are polled every 5s.
        full = force or not st["df"] or time.time() - st["df_at"] > 30
        def work():
            data = _docker_state(full)
            GLib.idle_add(apply, data, force)
            return False
        threading.Thread(target=work, daemon=True).start()

    def filter_toggled(btn, key):
        """One tab is always active; programmatic changes are guarded by syncing."""
        if st.get("syncing"): return
        st["syncing"] = True
        try:
            if not btn.get_active():          # user toggled the active tab off - put it back
                btn.set_active(True)
                return
            st["filter"] = key
            for k, w in fbtns.items():
                if w is not btn: w.set_active(False)
        finally:
            st["syncing"] = False
        render_rows(force=True)

    def job(cmd, busy, okmsg):
        if st["busy"]: return
        st["busy"] = True; status(busy)
        def work():
            rc, out, err = _dc(cmd, 900)
            def fin():
                st["busy"] = False
                st["acted"] = time.time()   # keep this message off the refresh sweep
                if rc != 0:
                    status("✗ " + ((err or out or "failed").splitlines() or ["failed"])[0])
                else:
                    status("✓ " + okmsg)
                refresh(force=True)
                return False
            GLib.idle_add(fin)
            return False
        threading.Thread(target=work, daemon=True).start()

    def power_toggle(cid, running):
        job(["docker", "stop", cid] if running else ["docker", "start", cid],
            "Stopping container…" if running else "Starting container…",
            "Container stopped" if running else "Container started")

    def remove_container(cid, name, running):
        extra = " It is running and will be stopped first." if running else ""
        if not confirm('Remove container "%s" permanently?%s' % (name, extra)): return
        job(["docker", "rm", "-f", cid], "Removing %s…" % name, "Removed " + name)

    def prune_cache():
        if confirm("Delete the whole build cache? Images and containers are not touched."):
            job(["docker", "builder", "prune", "-a", "-f"], "Pruning build cache…", "Build cache pruned")

    def prune_images():
        if confirm("Delete every image not used by a container? They must be pulled again later."):
            job(["docker", "image", "prune", "-a", "-f"], "Pruning unused images…", "Unused images pruned")

    def remove_stopped():
        if confirm("Remove all stopped containers? Their writable layers and logs are deleted."):
            job(["docker", "container", "prune", "-f"], "Removing stopped containers…", "Stopped containers removed")

    def full_cleanup():
        df = st["df"]
        if not df: return status("✗ docker is offline - nothing to clean")
        reclaim = sum(size_bytes(r.get("Reclaimable")) for r in df)
        d = Gtk.Dialog(title="Full cleanup", transient_for=WIN, modal=True)
        d.set_default_size(560, -1); d.set_resizable(False)
        d.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        d.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        d.get_style_context().add_class("dlg")
        d.add_button("Cancel", Gtk.ResponseType.CANCEL)
        go = d.add_button("Delete everything", Gtk.ResponseType.OK)
        cls(go, "danger")
        box = d.get_content_area(); box.set_border_width(18); box.set_spacing(10)
        box.pack_start(cls(Gtk.Label(label="FULL CLEANUP", xalign=0), "h"), False, False, 0)
        note = Gtk.Label(xalign=0, label="This permanently deletes unused Docker data. Running containers and the images they use are kept.")
        note.set_line_wrap(True); note.set_max_width_chars(60)
        box.pack_start(note, False, False, 0)
        for r in df:
            line = Gtk.Box(spacing=10)
            line.pack_start(Gtk.Label(label="·  " + (r.get("Type") or "?"), xalign=0), False, False, 0)
            line.pack_end(Gtk.Label(label="%s  (%s items)" % (r.get("Size") or "0B", r.get("TotalCount") or 0), xalign=1), False, False, 0)
            box.pack_start(line, False, False, 0)
        box.pack_start(cls(Gtk.Label(label="Estimated space to reclaim: " + size_human(reclaim), xalign=0), "dim"), False, False, 0)
        vol = Gtk.CheckButton(label="Also delete unused volumes (can destroy database data)")
        vol.set_active(True)
        box.pack_start(vol, False, False, 0)
        d.show_all()
        resp = d.run(); volumes = vol.get_active(); d.destroy()
        if resp != Gtk.ResponseType.OK: return
        steps = [("stopped containers", ["docker", "container", "prune", "-f"]),
                 ("unused images", ["docker", "image", "prune", "-a", "-f"]),
                 ("build cache", ["docker", "builder", "prune", "-a", "-f"]),
                 ("unused networks", ["docker", "network", "prune", "-f"])]
        if volumes: steps.insert(3, ("unused volumes", ["docker", "volume", "prune", "-a", "-f"]))
        if st["busy"]: return
        st["busy"] = True; status("Cleaning up…")
        def work():
            freed, errors = 0, []
            for i, (what, cmd) in enumerate(steps):
                def show(i=i, what=what):
                    status("Cleaning %s (%d/%d)…" % (what, i + 1, len(steps)))
                    return False
                GLib.idle_add(show)
                rc, out, err = _dc(cmd, 900)
                if rc != 0:
                    errors.append((err or out or what).splitlines()[0]); continue
                for m in re.finditer(r"(?:Total reclaimed space|Total|Reclaimed):\s*([\d.]+\s*[kKmMgGtT]?[bB])", out, re.I):
                    freed += size_bytes(m.group(1))
            def fin():
                st["busy"] = False
                status("✗ " + errors[0] if errors else "✓ Cleanup done · freed " + size_human(freed))
                refresh(force=True)
                return False
            GLib.idle_add(fin)
            return False
        threading.Thread(target=work, daemon=True).start()

    def tick():
        if not alive(): return False
        if WIN and WIN.stack.get_visible_child_name() == "docker":
            refresh()
        return True

    if DOCKER_TIMER["id"] and GLib.MainContext.default().find_source_by_id(DOCKER_TIMER["id"]):
        GLib.source_remove(DOCKER_TIMER["id"])
    DOCKER_TIMER["id"] = GLib.timeout_add(5000, tick)
    b.connect("destroy", lambda _w: st.update(dead=True))
    # The page is inserted into the stack right after this builder returns, so
    # wait one main-loop turn before the first poll (alive() needs a parent).
    GLib.timeout_add(60, lambda: (refresh(force=True), False)[1])
    return b


# ---------------------------------------------------------------- Podman / Distrobox
# These pages deliberately use the native CLIs instead of Docker compatibility
# layers.  That keeps rootless Podman useful and makes Distrobox status visible
# even when Docker is stopped or unavailable.
def _podman_state():
    if not have("podman"):
        return [], {}, "Podman is not installed. Install it with: sudo pacman -S podman"
    rc, out, err = _dc(["podman", "info", "--format", "{{json .}}"], 20)
    if rc != 0:
        return [], {}, err or out or "Podman is not reachable"
    try: info = json.loads(out)
    except Exception: info = {}
    rc, out, err = _dc(["podman", "ps", "-a", "--size", "--format", "{{json .}}"], 30)
    if rc != 0: return [], info, err or "Could not list Podman containers"
    rows = []
    for line in out.splitlines():
        try:
            if line.strip():
                obj = json.loads(line)
                # Podman's ps reporter exposes the size as a string, while
                # inspect exposes the exact rootfs and writable sizes.
                if obj.get("Names"):
                    rc2, raw, _ = _dc(["podman", "inspect", obj["Names"], "--format", "{{json .Size}}"], 20)
                    if rc2 == 0:
                        try: obj["Size"] = json.loads(raw)
                        except Exception: pass
                rows.append(obj)
        except Exception: pass
    return rows, info, None

def _distrobox_state():
    if not have("distrobox"):
        return [], "Distrobox is not installed. Install it with: sudo pacman -S distrobox"
    rc, out, err = _dc(["distrobox", "list"], 20)
    if rc != 0: return [], err or out or "Could not list Distrobox containers"
    rows = []
    # Current distrobox output is a table. Keep parsing tolerant of column
    # spacing and both old and new headers.
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("ID ") or line.startswith("CONTAINER ID") or set(line) <= set("- |"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) >= 4:
            rows.append({"ID": parts[0], "Names": parts[1], "Status": parts[2], "Image": parts[3], "State": "running" if "up" in parts[2].lower() else "exited"})
    # Distrobox's table does not expose disk usage. Enrich it from the native
    # rootless Podman store when available.
    if have("podman"):
        rc, pout, _ = _dc(["podman", "ps", "-a", "--size", "--format", "{{json .}}"], 30)
        by_name = {}
        for line in pout.splitlines():
            try:
                obj = json.loads(line); by_name[obj.get("Names")] = obj
            except Exception: pass
        for row in rows:
            obj = by_name.get(row["Names"], {})
            row.update({k: obj.get(k, row.get(k, "")) for k in ("Size", "ID", "State", "Status", "Image")})
            if not row.get("Size"):
                rc, inspect, _ = _dc(["podman", "inspect", row["Names"], "--format", "{{json .Size}}"], 20)
                if rc == 0:
                    try: row["Size"] = json.loads(inspect)
                    except Exception: pass
    return rows, None

def _runtime_page(runtime, title):
    b = new_page(title)
    accent, ok, warn = load_colors()[2][4], load_colors()[2][2], load_colors()[2][3]
    st = {"rows": [], "info": {}, "error": None, "sig": None, "dead": False, "fetching": False}
    def alive(): return not st["dead"] and b.get_parent() is not None
    def chip(text, kind=None):
        w = cls(Gtk.Label(label=text, xalign=0), "chip")
        if kind: cls(w, kind)
        w.set_valign(Gtk.Align.CENTER)
        return w
    def refresh():
        if st["fetching"]: return
        st["fetching"] = True; status("Refreshing %s…" % title)
        def work():
            if runtime == "podman":
                rows, info, error = _podman_state()
            else:
                rows, error = _distrobox_state()
                info = {}
            GLib.idle_add(apply, rows, info, error)
        threading.Thread(target=work, daemon=True).start()
    def apply(rows, info, error):
        if not alive(): return False
        st.update(rows=rows, info=info, error=error, fetching=False)
        online = not error
        engine.set_text("ONLINE" if online else "OFFLINE"); set_kind(engine, "on" if online else "off")
        version = info.get("version", {}).get("Version") if isinstance(info, dict) and isinstance(info.get("version"), dict) else None
        version = version or (info.get("Version") if isinstance(info, dict) else None)
        ver.set_text("v" + str(version) if version else ("installed" if online else "—"))
        if online and runtime == "podman":
            host = info.get("host", {}) if isinstance(info, dict) else {}
            store = info.get("store", {}) if isinstance(info, dict) else {}
            detail = "rootless" if host.get("security", {}).get("rootless") else "rootful"
            graph = store.get("graphDriverName") or "storage"
            counts.set_text("%d container%s · %s · %s" % (len(rows), "s" if len(rows) != 1 else "", detail, graph))
        else:
            counts.set_text(("%d environment%s" % (len(rows), "s" if len(rows) != 1 else "")) if online else error)
        for ch in lst.get_children(): lst.remove(ch)
        if error:
            msg = cls(Gtk.Label(label=error, xalign=0), "st-dead"); msg.set_line_wrap(True); lst.add(msg)
        elif not rows:
            lst.add(cls(Gtk.Label(label="No %s environments found." % title, xalign=0), "dim"))
        else:
            for obj in rows: lst.add(row_for(obj))
        lst.show_all(); updated.set_text("updated " + time.strftime("%H:%M:%S")); return False
    def set_kind(w, kind):
        ctx = w.get_style_context()
        for k in ("on", "off", "hot", "warn"): ctx.remove_class(k)
        if kind: ctx.add_class(kind)
    def command(name, action, obj):
        if runtime == "distrobox":
            cmd = ["distrobox", action, obj]
        else:
            cmd = ["podman", action, obj]
        run(cmd, "%s %s" % (action.capitalize(), name), refresh)
    def open_shell(name):
        """Open an independent terminal; do not try to embed a TTY in GTK."""
        if not have("st"):
            return status("✗ st terminal is not installed")
        if runtime == "distrobox":
            cmd = ["distrobox", "enter", name, "--", "zsh", "-i"]
        else:
            cmd = ["podman", "exec", "-it", name, "sh", "-i"]
        bg(["st", "-c", "vxpanel-term", "-t", title + ": " + name, "-e"] + cmd)
        status("✓ terminal opened for " + name)
    def start_then_open(name):
        """Start through Podman, then open the correct interactive command."""
        def after(): open_shell(name)
        run(["podman", "start", name], "Started " + name, after=after)
    def row_for(obj):
        name = obj.get("Names") or obj.get("Name") or obj.get("ID", "")[:12]
        if isinstance(name, (list, tuple)): name = ", ".join(str(x) for x in name)
        name = str(name)
        running = (obj.get("State") or "").lower() in ("running", "up") or "up" in (obj.get("Status") or "").lower()
        r = Gtk.ListBoxRow(); h = Gtk.Box(spacing=10); dot = cls(Gtk.Label(label="●"), "st-run" if running else "st-stop"); h.pack_start(dot, False, False, 0)
        text = Gtk.Box(orientation=VERT, spacing=2); text.pack_start(cls(Gtk.Label(label=name, xalign=0), "name"), False, False, 0)
        size = container_size(obj)
        sub = (obj.get("Image") or "") + ("  ·  " + (obj.get("Status") or "") if obj.get("Status") else "") + "  ·  " + str(size)
        text.pack_start(cls(Gtk.Label(label=sub, xalign=0), "dim"), False, False, 0); h.pack_start(text, True, True, 0)
        power = btn("Stop" if running else "Start", lambda: (command(name, "stop", name) if running else start_then_open(name))); cls(power, "sm"); power.set_tooltip_text("Stop this environment" if running else "Start this environment"); h.pack_end(power, False, False, 0)
        shell = btn("Enter" if runtime == "distrobox" else "Shell", lambda: (open_shell(name) if running else start_then_open(name))); cls(shell, "sm"); shell.set_tooltip_text("Open an interactive terminal inside this environment"); h.pack_end(shell, False, False, 0)
        r.add(h); return r
    c = card(b, "Engine")
    line = Gtk.Box(spacing=8); engine = chip("CONNECTING"); ver = chip("—"); counts = cls(Gtk.Label(label="—", xalign=0), "dim")
    line.pack_start(engine, False, False, 0); line.pack_start(ver, False, False, 0); line.pack_start(counts, False, False, 0); line.pack_start(Gtk.Box(), True, True, 0)
    updated = cls(Gtk.Label(label="waiting…", xalign=0), "dim"); line.pack_start(updated, False, False, 0)
    ref = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON); cls(ref, "sm"); ref.connect("clicked", lambda _w: refresh()); line.pack_end(ref, False, False, 0); c.pack_start(line, False, False, 0)
    c = card(b, "Environments"); lst = Gtk.ListBox(); lst.set_selection_mode(Gtk.SelectionMode.NONE); cls(lst, "ctrlist"); c.pack_start(lst, False, False, 0)
    b.connect("destroy", lambda _w: st.update(dead=True)); refresh(); return b

@page("podman", "Podman")
def podman(): return _runtime_page("podman", "Podman")

@page("distrobox", "Distrobox")
def distrobox(): return _runtime_page("distrobox", "Distrobox")

# ---------------------------------------------------------------- Disk
# Disk usage analysis + cleanup. du/find are slow, so everything runs in
# worker threads and results come back through GLib.idle_add.

def disk_du(path):
    """du -sxB1 of a path in bytes; 0 when missing/unreadable."""
    rc, out, _ = _dc(["du", "-sxB1", "--", path], 600)
    tok = out.split()
    if rc not in (0, 1) or not tok or not tok[0].isdigit(): return 0
    return int(tok[0])

def disk_du_dir(path):
    """du -xaB1 -d1 -> (rows [(basename, bytes, fullpath)], total bytes).
    -a is required: plain -d1 lists directories only, never files."""
    rc, out, _ = _dc(["du", "-xaB1", "-d1", "--", path], 900)
    rows, total = [], 0
    base = os.path.realpath(path)
    for line in out.splitlines():
        if "\t" not in line: continue
        size, p = line.split("\t", 1)
        if not size.isdigit(): continue
        if os.path.realpath(p) == base:
            total = int(size); continue
        rows.append((os.path.basename(p), int(size), p))
    rows.sort(key=lambda r: -r[1])
    return rows, total

def disk_dupes(path, min_mb=1, progress=None, cancel=None):
    """Duplicate files under path by content hash.
    Returns [(filesize, [newest keeper, dup, ...]), ...] sorted by wasted space,
    or None when cancelled."""
    rc, out, _ = _dc(["find", path, "-xdev", "-type", "f", "-size", "+%dM" % min_mb,
                      "-printf", "%s\t%T@\t%p\n"], 1800)
    by_size = {}
    for line in out.splitlines():
        if line.count("\t") != 2: continue
        s, m, p = line.split("\t")
        if not s.isdigit(): continue
        by_size.setdefault(int(s), []).append((float(m), p))
    cand = [(size, g) for size, g in by_size.items() if len(g) > 1]
    cand.sort(key=lambda x: -x[0] * (len(x[1]) - 1))
    total = sum(len(g) for _s, g in cand)
    done = 0
    def sha(p):
        h = hashlib.sha256()
        with open(p, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""): h.update(chunk)
        return h.hexdigest()
    groups = []
    for size, g in cand:
        if cancel and cancel(): return None
        by_hash = {}
        for mtime, p in g:
            try: by_hash.setdefault(sha(p), []).append((mtime, p))
            except OSError: pass
            done += 1
            if progress and done % 25 == 0: progress(done, total)
        for files in by_hash.values():
            if len(files) < 2: continue
            files.sort(key=lambda x: -x[0])   # newest stays, older copies go
            groups.append((size, [p for _, p in files]))
    groups.sort(key=lambda x: -x[0] * (len(x[1]) - 1))
    return groups

def disk_sudo_term(title, script):
    """Run a root command in a visible st window so the password prompt works."""
    if not have("st"): return status("st is not installed - cannot run " + title)
    inner = ("sudo -p 'Password: ' sh -c " + shlex.quote(script) +
             "; rc=$?; echo; echo \"Finished (exit $rc) - press Enter to close\"; read _")
    bg(["st", "-c", "vxpanel-term", "-t", title, "-e", "sh", "-c", inner])
    status("→ " + title + " is running in a terminal")

@page("disk", "Disk")
def disk():
    b = new_page("Disk")
    bgc, fg, pal = load_colors()
    accent, ok, warn, bad = pal[4], pal[2], pal[3], pal[1]
    H = os.path.expanduser("~")
    CL, OC, CX = H + "/.local/share/claude", H + "/.local/share/opencode", H + "/.codex"
    st = {"busy": False, "gen": 0, "path": H, "stack": [], "szlbl": {}, "sizes": {},
          "groups": [], "orphans": 0}

    def alive(): return b.get_parent() is not None
    def visible(): return alive() and WIN and WIN.stack.get_visible_child_name() == "disk"

    def bar(w, cr):
        W, Hh = w.get_allocated_width(), w.get_allocated_height()
        cr.set_source_rgb(*hex2rgb(mix(bgc, fg, 0.13)))
        cr.rectangle(0, 0, W, Hh); cr.fill()
        frac = getattr(w, "frac", 0.0)
        if frac > 0:
            cr.set_source_rgb(*hex2rgb(getattr(w, "col", accent)))
            cr.rectangle(0, 0, max(W * frac, 2), Hh); cr.fill()
        return False

    def mkbar(frac, col, w=90, h=8):
        da = Gtk.DrawingArea(); da.set_size_request(w, h)
        da.frac = float(frac); da.col = col   # set_data() is gone in new PyGObject
        da.set_valign(Gtk.Align.CENTER)
        da.connect("draw", bar)
        return da

    # ---------------- storage
    c = card(b, "Storage")
    fsbox = Gtk.Box(orientation=VERT, spacing=9)
    c.pack_start(fsbox, False, False, 0)
    rootdev = os.stat("/").st_dev
    seen = set()
    for mnt in ("/", "/home", "/var"):
        try:
            if mnt != "/" and os.stat(mnt).st_dev == rootdev: continue
            total, used, _free = shutil.disk_usage(mnt)
        except OSError:
            continue
        if (total, used) in seen: continue   # btrfs subvols report /home as its own device
        seen.add((total, used))
        frac = used / total if total else 0
        r = Gtk.Box(spacing=10)
        r.pack_start(Gtk.Label(label=mnt, xalign=0), False, False, 14)
        r.pack_start(mkbar(frac, ok if frac < 0.8 else warn if frac < 0.92 else bad, 200, 9),
                     False, False, 0)
        r.pack_end(Gtk.Label(label="%s / %s  (%d%%)" % (size_human(used), size_human(total),
                                                        round(100 * frac)), xalign=1), False, False, 0)
        fsbox.pack_start(r, False, False, 0)

    # ---------------- where space goes
    c = card(b, "What's taking space")
    head = Gtk.Box(spacing=8)
    pathlbl = cls(Gtk.Label(label=H, xalign=0), "dim")
    head.pack_start(pathlbl, True, True, 0)
    up = btn("↑ up", lambda: go_up()); cls(up, "sm")
    homeb = btn("⌂ home", lambda: go_home()); cls(homeb, "sm")
    resc = btn("⟳ rescan", lambda: scan()); cls(resc, "sm")
    for wdg in (up, homeb, resc): head.pack_end(wdg, False, False, 0)
    c.pack_start(head, False, False, 0)
    duelst = Gtk.ListBox(); duelst.set_selection_mode(Gtk.SelectionMode.NONE)
    cls(duelst, "ctrlist")
    c.pack_start(duelst, False, False, 0)

    def drill(path):
        if not os.path.isdir(path): return
        st["stack"].append(st["path"]); st["path"] = path; scan()
    def go_up():
        if not st["stack"]: return status("Already at " + st["path"])
        st["path"] = st["stack"].pop(); scan()
    def go_home():
        st["stack"] = []; st["path"] = H; scan()

    def scan():
        if st["busy"]: return
        st["busy"] = True
        path = st["path"]; gen = st["gen"] = st["gen"] + 1
        pathlbl.set_text(path)
        if visible(): status("Scanning " + path + "…")
        def work():
            rows, total = disk_du_dir(path)
            GLib.idle_add(apply_scan, path, rows, total, gen)
            return False
        threading.Thread(target=work, daemon=True).start()

    def apply_scan(path, rows, total, gen):
        st["busy"] = False
        if not alive() or gen != st["gen"] or path != st["path"]: return False
        for w in duelst.get_children(): duelst.remove(w)
        shown = [r for r in rows if r[1] >= 8 * 1024 ** 2][:60]
        small = [r for r in rows if r[1] < 8 * 1024 ** 2]
        biggest = shown[0][1] if shown else 0
        for name, n, full in shown:
            r = Gtk.Box(spacing=10)
            r.pack_start(mkbar(n / biggest if biggest else 0, accent, 90, 8), False, False, 0)
            if os.path.isdir(full):
                d = btn(name, lambda f=full: drill(f))
                d.set_relief(Gtk.ReliefStyle.NONE)
                d.get_child().set_xalign(0)
                d.set_tooltip_text("Click to look inside " + full)
                r.pack_start(d, True, True, 0)
            else:
                r.pack_start(Gtk.Label(label=name, xalign=0), True, True, 0)
            r.pack_end(Gtk.Label(label=size_human(n), xalign=1), False, False, 0)
            duelst.add(r)
        if small:
            n = cls(Gtk.Label(label="· %d smaller entries (%s)" % (len(small),
                     size_human(sum(x[1] for x in small))), xalign=0), "dim")
            duelst.add(n)
        duelst.show_all()
        if visible():
            status("✓ %s · %s in %d entries" % (path, size_human(total), len(rows)))
        GLib.idle_add(measure)
        return False

    # ---------------- cleanup
    c = card(b, "Cleanup")
    note = cls(Gtk.Label(label="User items are deleted directly; system items open a terminal and ask for sudo.",
                         xalign=0), "dim")
    note.set_line_wrap(True)
    c.pack_start(note, False, False, 0)
    acts = Gtk.Box(orientation=VERT, spacing=8)
    c.pack_start(acts, False, False, 0)

    USER_ITEMS = [
        ("User cache", "~/.cache (pywal's wal theme is kept)", [H + "/.cache"], ("wal",),
         "Clear ~/.cache? Applications rebuild it on next launch."),
        ("Claude caches", "snapshots · telemetry · paste cache", [CL + "/shell-snapshots", CL + "/telemetry",
         CL + "/paste-cache", CL + "/cache"], (), "Clear Claude's caches (snapshots, telemetry, paste cache)?"),
        ("OpenCode caches", "logs · tool output", [OC + "/log", OC + "/tool-output", H + "/.cache/opencode"], (),
         "Clear OpenCode's logs and tool output cache?"),
        ("Codex caches", "cache · logs · tmp", [CX + "/cache", CX + "/log", CX + "/tmp"], (),
         "Clear Codex's caches, logs and temp files?"),
        ("Agent histories", "Claude projects · Codex sessions · OpenCode sessions",
         [CL + "/projects", CX + "/sessions", OC + "/project"], (),
         "Delete agent conversation history? Past Claude/Codex/OpenCode sessions cannot be restored."),
    ]

    def item_size(paths):
        t = 0
        for p in paths:
            if os.path.isdir(p): t += disk_du(p)
            elif os.path.isfile(p): t += os.path.getsize(p)
        return t

    def make_user_row(label, hint, paths, excludes, cfm):
        r = Gtk.Box(spacing=12)
        vbox = Gtk.Box(orientation=VERT, spacing=1)
        vbox.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        vbox.pack_start(cls(Gtk.Label(label=hint, xalign=0), "dim"), False, False, 0)
        r.pack_start(vbox, True, True, 0)
        szlbl = cls(Gtk.Label(label="…", xalign=1), "dim")
        r.pack_end(szlbl, False, False, 0)
        cb = btn("Clear", lambda: clear_item(label, paths, excludes, cfm))
        cb.set_valign(Gtk.Align.CENTER)
        r.pack_end(cb, False, False, 0)
        acts.pack_start(r, False, False, 0)
        st["szlbl"][label] = szlbl

    def clear_item(label, paths, excludes, cfm):
        if st["busy"]: return status("busy - wait for the current job")
        if not confirm(cfm): return
        st["busy"] = True; status("Clearing " + label + "…")
        def work():
            before = item_size(paths)
            for p in paths:
                if os.path.isdir(p):
                    for child in os.listdir(p):
                        if child in excludes: continue
                        q = os.path.join(p, child)
                        try: shutil.rmtree(q) if os.path.isdir(q) else os.remove(q)
                        except OSError: pass
                elif os.path.isfile(p):
                    try: os.remove(p)
                    except OSError: pass
            freed = max(before - item_size(paths), 0)
            GLib.idle_add(done_clear, label, freed)
            return False
        threading.Thread(target=work, daemon=True).start()

    def done_clear(label, freed):
        st["busy"] = False
        if not alive(): return False
        status("✓ Cleared %s · freed %s" % (label, size_human(freed)))
        measure()
        return False

    for it in USER_ITEMS: make_user_row(*it)

    # system rows (sudo via a terminal)
    def sys_row(label, hint, has_size=True):
        r = Gtk.Box(spacing=12)
        vbox = Gtk.Box(orientation=VERT, spacing=1)
        vbox.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        vbox.pack_start(cls(Gtk.Label(label=hint, xalign=0), "dim"), False, False, 0)
        r.pack_start(vbox, True, True, 0)
        if has_size:
            szlbl = cls(Gtk.Label(label="…", xalign=1), "dim")
            r.pack_end(szlbl, False, False, 0)
        else:
            szlbl = None
        acts.pack_start(r, False, False, 0)
        return r, szlbl

    def small_btn(r, text, fn, danger=False):
        x = btn(text, fn)
        cls(x, "danger" if danger else "sm")
        x.set_valign(Gtk.Align.CENTER); x.set_margin_start(8)
        r.pack_end(x, False, False, 0)
        return x

    r, szlbl = sys_row("Pacman package cache", "/var/cache/pacman/pkg")
    st["szlbl"]["pacman"] = szlbl
    small_btn(r, "Keep 3 versions", lambda: disk_sudo_term("Pacman cache", "paccache -r"))
    small_btn(r, "Drop uninstalled", lambda: disk_sudo_term("Pacman cache", "paccache -ruk0"))

    r, szlbl = sys_row("Journal logs", "systemd journal on disk")
    st["szlbl"]["journal"] = szlbl
    small_btn(r, "Vacuum to 100M", lambda: disk_sudo_term("Journal vacuum", "journalctl --vacuum-size=100M"))

    r, szlbl = sys_row("Orphan packages", "installed as deps but no longer needed")
    st["szlbl"]["orphans"] = szlbl
    orphan_btn = small_btn(r, "Remove orphans",
                           lambda: disk_sudo_term("Orphan packages", "pacman -Rns $(pacman -Qtdq)"))
    orphan_btn.set_sensitive(False)

    r, _sz = sys_row("SSD TRIM", "reclaim unmapped blocks (safe, fast)", has_size=False)
    small_btn(r, "fstrim -av", lambda: disk_sudo_term("TRIM", "fstrim -av"))

    r, _sz = sys_row("Your cleanup scripts", "interactive, with dry-run flags", has_size=False)
    for t, s in (("Package caches", H + "/.local/bin/cleanup-package-caches.sh"),
                 ("System caches", H + "/.local/bin/cleanup-system-caches.sh")):
        small_btn(r, t, lambda sc=s: disk_sudo_term("Cleanup script", "bash " + shlex.quote(sc) + " </dev/tty"))

    btnrow(c, btn("Refresh sizes", lambda: measure()))

    # ---------------- duplicates
    c = card(b, "Duplicates")
    dhead = Gtk.Box(spacing=8)
    duplbl = cls(Gtk.Label(label="Not scanned yet - scans the folder shown above.", xalign=0), "dim")
    dhead.pack_start(duplbl, True, True, 0)
    c.pack_start(dhead, False, False, 0)
    duplst = Gtk.ListBox(); duplst.set_selection_mode(Gtk.SelectionMode.NONE)
    cls(duplst, "ctrlist")
    c.pack_start(duplst, False, False, 0)

    delall = small_btn(dhead, "Delete all (keep newest)", lambda: delete_all(), danger=True)
    scanb = small_btn(dhead, "Scan for duplicates", lambda: scan_dupes())
    delall.set_sensitive(False)

    def scan_dupes():
        if st["busy"]: return status("busy - wait for the current job")
        st["busy"] = True
        path = st["path"]; gen = st["gen"] = st["gen"] + 1
        scanb.set_sensitive(False)
        status("Scanning %s for duplicate files…" % path)
        def prog(done, total):
            GLib.idle_add(lambda: status("Hashing duplicates… %d/%d files" % (done, total)))
        def work():
            groups = disk_dupes(path, 1, progress=prog, cancel=lambda: gen != st["gen"])
            GLib.idle_add(apply_dupes, groups, path, gen)
            return False
        threading.Thread(target=work, daemon=True).start()

    def render_groups(path):
        for w in duplst.get_children(): duplst.remove(w)
        waste = sum(s * (len(f) - 1) for s, f in st["groups"])
        delall.set_sensitive(bool(st["groups"]))
        if not st["groups"]:
            duplbl.set_text("No duplicates >= 1 MB in %s." % path)
        else:
            duplbl.set_text("%d groups · %s waste in %s" % (len(st["groups"]), size_human(waste), path))
            for i, (size, files) in enumerate(st["groups"][:40]):
                r = Gtk.Box(spacing=10)
                r.pack_start(Gtk.Label(label="%d × %s" % (len(files), size_human(size)), xalign=0),
                             False, False, 0)
                r.pack_end(btn("Keep newest", lambda g=i: delete_group(g)), False, False, 0)
                duplst.add(r)
                for p in files:
                    fr = Gtk.Box(spacing=10)
                    lbl = cls(Gtk.Label(label=p.replace(path + "/", ""), xalign=0), "dim")
                    lbl.set_margin_start(12)
                    fr.pack_start(lbl, True, True, 0)
                    duplst.add(fr)
        duplst.show_all()

    def apply_dupes(groups, path, gen):
        st["busy"] = False
        scanb.set_sensitive(True)
        if not alive() or gen != st["gen"]: return False
        st["groups"] = groups or []
        render_groups(path)
        waste = sum(s * (len(f) - 1) for s, f in st["groups"])
        if visible():
            status("✓ %d duplicate groups · %s waste" % (len(st["groups"]), size_human(waste)))
        return False

    def do_delete(paths):
        freed = 0
        for p in paths:
            try:
                freed += os.path.getsize(p); os.remove(p)
            except OSError: pass
        return freed

    def delete_group(i):
        size, files = st["groups"][i]
        gone = files[1:]
        if not confirm("Delete %d older copies of a %s file?\nThe newest copy is kept." % (len(gone), size_human(size))):
            return
        freed = do_delete(gone)
        st["groups"].pop(i)
        render_groups(st["path"])
        status("✓ Deleted %d copies · freed %s" % (len(gone), size_human(freed)))

    def delete_all():
        gone = [p for _, files in st["groups"] for p in files[1:]]
        waste = sum(s * (len(f) - 1) for s, f in st["groups"])
        if not gone: return
        if not confirm("Delete %d duplicate files and free %s?\nThe newest copy of every file is kept."
                       % (len(gone), size_human(waste))): return
        freed = do_delete(gone)
        st["groups"] = []
        render_groups(st["path"])
        duplbl.set_text("Deleted %d files · freed %s" % (len(gone), size_human(freed)))
        status("✓ Deleted %d duplicates · freed %s" % (len(gone), size_human(freed)))

    # ---------------- measuring sizes
    def measure():
        if st["busy"]: return
        st["busy"] = True
        orphan_btn.set_sensitive(False)
        if visible(): status("Measuring disk usage…")
        def work():
            sizes = {}
            for label, _hint, paths, _ex, _cfm in USER_ITEMS:
                sizes[label] = item_size(paths)
            sizes["pacman"] = disk_du("/var/cache/pacman/pkg")
            rc, out, _ = _dc(["journalctl", "--disk-usage"], 30)
            m = re.search(r"([\d.]+)\s*([KMGT])", out)
            sizes["journal"] = size_bytes(m.group(1) + m.group(2) + "B") if m else 0
            rc, out, _ = _dc(["pacman", "-Qtdq"], 60)
            sizes["orphans"] = out.split() if rc in (0, 1) else []
            GLib.idle_add(apply_sizes, sizes)
            return False
        threading.Thread(target=work, daemon=True).start()

    def apply_sizes(sizes):
        st["busy"] = False
        if not alive(): return False
        st["sizes"] = sizes
        for label, szlbl in st["szlbl"].items():
            if label in ("pacman", "journal"):
                szlbl.set_text(size_human(sizes[label]))
            elif label == "orphans":
                n = len(sizes["orphans"])
                szlbl.set_text("%d packages" % n if n else "none")
                orphan_btn.set_sensitive(n > 0)
            elif label in sizes:
                szlbl.set_text(size_human(sizes[label]))
        if visible():
            status("✓ Disk refreshed · " + time.strftime("%H:%M:%S"))
        return False

    GLib.timeout_add(80, scan)
    return b

# ---------------------------------------------------------------- Window
class Panel(Gtk.Window):
    def __init__(self, start):
        super().__init__(title="vxpanel")
        self.set_default_size(980, 680)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.CENTER)
        root = cls(Gtk.Box(), "root"); self.add(root)
        left = Gtk.Box(orientation=VERT); left.set_size_request(200, -1); left.get_style_context().add_class("sidebar")
        left.pack_start(cls(Gtk.Label(label="VXPANEL", xalign=0), "brand"), False, False, 0)
        self.side = cls(Gtk.ListBox(), "sidebar")
        left.pack_start(self.side, True, True, 0)
        self.stack = Gtk.Stack()
        self.status = Gtk.Label(label="Ready", xalign=0)
        self.status.set_ellipsize(Pango.EllipsizeMode.END); self.status.set_width_chars(10); self.status.set_single_line_mode(True)
        sbar = cls(Gtk.Box(), "status"); sbar.pack_start(self.status, True, True, 0)
        right = Gtk.Box(orientation=VERT)
        right.pack_start(self.stack, True, True, 0); right.pack_start(sbar, False, False, 0)
        self.built = set()
        for _, label, _ in PAGES:
            r = Gtk.ListBoxRow(); r.add(Gtk.Label(label=label, xalign=0)); self.side.add(r)
        self.side.connect("row-selected", self.select)
        root.pack_start(left, False, False, 0); root.pack_start(right, True, True, 0)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", lambda w, e: Gtk.main_quit() if e.keyval == Gdk.KEY_Escape else None)
        self.show_all()
        idx = next((i for i, p in enumerate(PAGES) if p[0] == start), 0)
        self.side.select_row(self.side.get_row_at_index(idx))

    def select(self, _, r):
        if r is None: return
        key, _, fn = PAGES[r.get_index()]
        if key not in self.built:
            sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            sc.add(fn()); self.stack.add_named(sc, key); sc.show_all(); self.built.add(key)
        self.stack.set_visible_child_name(key)

    def reload(self, key):
        ch = self.stack.get_child_by_name(key)
        if ch: self.stack.remove(ch)
        self.built.discard(key)
        self.select(None, self.side.get_selected_row())

def main():
    global WIN
    GLib.set_prgname("vxpanel")
    Gdk.set_program_class("vxpanel")
    apply_css()
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), PROVIDER, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    start = sys.argv[sys.argv.index("--page") + 1] if "--page" in sys.argv[:-1] else "display"
    WIN = Panel(start)
    if os.path.isdir(WAL_DIR):
        mon = Gio.File.new_for_path(WAL_DIR).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        pending = {"id": 0}
        def changed(_m, f, _o, _e):
            if f.get_basename() != "colors.json": return
            if pending["id"]: GLib.source_remove(pending["id"])
            def go():
                pending["id"] = 0
                apply_css()
                if CFG.get("dunst_follow", True) and os.path.exists(H + "/.config/dunst/dunstrc.d/90-vxpanel.conf") and have("dunst"):
                    write_dunst()
                return False
            pending["id"] = GLib.timeout_add(400, go)
        mon.connect("changed", changed)
        WIN._mon = mon
    Gtk.main()

if __name__ == "__main__":
    main()
