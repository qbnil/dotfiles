#!/usr/bin/env python3
"""vxpanel - flat, lightweight floating control panel for dwm-style X11 setups (GTK3 + pywal).
Usage: vxpanel [--page display|colors|theme|audio|input|notify|system|network|logs|docker|podman|distrobox|disk]
Changes that X forgets on restart are saved to ~/.config/vxpanel/startup.sh - run it from your autostart.

Session start never runs this script: startup.sh carries a plain `redshift -O`
line (written by persist_nightlight), so login applies the night light in
~10ms instead of paying Python+GTK startup while the screen sits neutral."""
import json, os, shutil, subprocess, sys

# Only json/os/re/shutil/subprocess are imported up here - everything the
# night light needs.  All GUI-only imports (ctypes, shlex, GTK, ...) live
# below the GUI-only banner further down.

H = os.path.expanduser("~")
WAL_DIR = H + "/.cache/wal"
CONF_DIR = H + "/.config/vxpanel"
STARTUP = CONF_DIR + "/startup.sh"
VX_XRES = CONF_DIR + "/Xresources"
NIGHT_DEFAULT = 4500  # default night-light colour temperature (K)
WIN = None
REDRAW = []

# ---------------------------------------------------------------- config / persistence
def _load():
    try: return json.load(open(CONF_DIR + "/config.json"))
    except Exception: return {}
CFG = _load()

def cfg_set(k, v):
    CFG[k] = v
    os.makedirs(CONF_DIR, exist_ok=True)
    json.dump(CFG, open(CONF_DIR + "/config.json", "w"), indent=1)

def xres_path():
    """vxpanel's own Xresources. Always the XDG path: the session Xresources is
    generated by xresources-gen and merged from ~/.config/x11/Xresources, so
    vxpanel keeps its cursor/DPI keys in its own file instead."""
    return VX_XRES

def persist(key, cmd):
    """Keep one line per key in startup.sh (cmd=None removes it)."""
    try: lines = open(STARTUP).read().splitlines()
    except Exception: lines = ["#!/bin/sh", "# generated by vxpanel - run from your autostart"]
    lines = [l for l in lines if not l.endswith("# vxpanel:" + key)]
    if cmd: lines.append("%s  # vxpanel:%s" % (cmd, key))
    os.makedirs(CONF_DIR, exist_ok=True)
    open(STARTUP, "w").write("\n".join(lines) + "\n")
    os.chmod(STARTUP, 0o755)

# ---------------------------------------------------------------- helpers
def sh(cmd):
    try:
        return subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return ""

def bg(cmd):
    try:
        subprocess.Popen(cmd, shell=isinstance(cmd, str), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass

def have(x): return shutil.which(x) is not None

# ---------------------------------------------------------------- display gamma
# Redshift/gammastep own the CRTC gamma ramp alone - there is no separate
# software-brightness path anymore (dimming was removed; the laptop backlight
# is brightnessctl's job).  The session-start restore is a plain persisted
# `redshift -O <k>` line in startup.sh, so login never spawns Python.
def nightlight_cmd():
    """The redshift/gammastep argv for the saved temperature, or None."""
    nl = "redshift" if have("redshift") else "gammastep" if have("gammastep") else None
    if not nl or not CFG.get("nightlight_k"): return None
    return [nl, "-P", "-O", str(int(CFG["nightlight_k"]))]

def apply_display():
    """Apply the saved night-light colour temperature, now."""
    cmd = nightlight_cmd()
    if cmd:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def persist_nightlight():
    """startup.sh keeps one plain redshift line - no Python at session start."""
    cmd = nightlight_cmd()
    persist("display", None)  # old entry: spawned vxpanel --apply-display
    persist("nightlight", " ".join(cmd) if cmd else None)

# ---------------------------------------------------------------- GUI-only
# From here on: ctypes (cursor theming below uses Xcursor/Xfixes), re (page
# parsing), shlex, configparser, threading, Template, GTK.  Nothing above
# needs them, and at session start they used to cost ~0.3s of visible
# bright-neutral screen before the night light landed.
import ctypes, ctypes.util
import re, shlex, hashlib, configparser, threading, time, socket
from string import Template
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf, Pango
VERT, HORZ = Gtk.Orientation.VERTICAL, Gtk.Orientation.HORIZONTAL

def status(msg):
    if WIN:
        WIN.status.set_text(msg); WIN.status.set_tooltip_text(msg)

def run(cmd, ok="Done", after=None, timeout=60, always=False):
    """Run a command in a thread, report the result in the status bar.

    `always` also calls `after` on failure; used by the Tailscale controls so
    the switch snaps back to the daemon's real state instead of waiting for
    the next 10s tick.
    """
    def work():
        good = False
        try:
            r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=timeout)
            good = r.returncode == 0
            msg = "✓ " + ok if good else "✗ " + ((r.stderr or r.stdout).strip().splitlines() or ["failed"])[-1]
        except FileNotFoundError:
            msg = "✗ not installed: " + (cmd[0] if isinstance(cmd, list) else cmd.split()[0])
        except Exception as e:
            msg = "✗ %s" % e
        def fin():
            status(msg)
            if (good or always) and after: after()
            return False
        GLib.idle_add(fin)
    threading.Thread(target=work, daemon=True).start()

def copy(text):
    Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
    status("Copied: " + text)

def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))

def mix(a, b, t):
    return "#%02x%02x%02x" % tuple(int((x + (y - x) * t) * 255) for x, y in zip(hex2rgb(a), hex2rgb(b)))

def lum(h):
    r, g, b = hex2rgb(h)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

FALLBACK = ["#1a1b26", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#bb9af7", "#7dcfff", "#a9b1d6",
            "#414868", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#bb9af7", "#7dcfff", "#c0caf5"]

def load_colors():
    try:
        d = json.load(open(WAL_DIR + "/colors.json"))
        return d["special"]["background"], d["special"]["foreground"], [d["colors"]["color%d" % i] for i in range(16)]
    except Exception:
        return FALLBACK[0], FALLBACK[15], FALLBACK

# ---------------------------------------------------------------- style (flat, square)
