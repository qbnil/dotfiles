#!/usr/bin/env python3
"""vxpanel - flat, lightweight floating control panel for dwm-style X11 setups (GTK3 + pywal).
Usage: vxpanel [--page display|colors|theme|audio|input|notify|system]
Changes that X forgets on restart are saved to ~/.config/vxpanel/startup.sh - run it from your autostart."""
import ctypes, ctypes.util, configparser, json, os, re, shlex, shutil, subprocess, sys, threading, time
from string import Template
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf, Pango

H = os.path.expanduser("~")
WAL_DIR = H + "/.cache/wal"
CONF_DIR = H + "/.config/vxpanel"
STARTUP = CONF_DIR + "/startup.sh"
VX_XRES = CONF_DIR + "/Xresources"
VERT, HORZ = Gtk.Orientation.VERTICAL, Gtk.Orientation.HORIZONTAL
WIN = None
REDRAW = []

# ---------------------------------------------------------------- config / persistence
def _load():
    try: return json.load(open(CONF_DIR + "/config.json"))
    except Exception: return {}
CFG = _load()

def cfg_set(k, v):
    CFG[k] = v
    os.makedirs(CONF_DIR, exist_ok=True)
    json.dump(CFG, open(CONF_DIR + "/config.json", "w"), indent=1)

def persist(key, cmd):
    """Keep one line per key in startup.sh (cmd=None removes it)."""
    try: lines = open(STARTUP).read().splitlines()
    except Exception: lines = ["#!/bin/sh", "# generated by vxpanel - run from your autostart"]
    lines = [l for l in lines if not l.endswith("# vxpanel:" + key)]
    if cmd: lines.append("%s  # vxpanel:%s" % (cmd, key))
    os.makedirs(CONF_DIR, exist_ok=True)
    open(STARTUP, "w").write("\n".join(lines) + "\n")
    os.chmod(STARTUP, 0o755)

# ---------------------------------------------------------------- helpers
def sh(cmd):
    try:
        return subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return ""

def bg(cmd):
    try:
        subprocess.Popen(cmd, shell=isinstance(cmd, str), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass

def have(x): return shutil.which(x) is not None

def status(msg):
    if WIN:
        WIN.status.set_text(msg); WIN.status.set_tooltip_text(msg)

def run(cmd, ok="Done", after=None, timeout=60):
    """Run a command in a thread, report the result in the status bar."""
    def work():
        good = False
        try:
            r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=timeout)
            good = r.returncode == 0
            msg = "✓ " + ok if good else "✗ " + ((r.stderr or r.stdout).strip().splitlines() or ["failed"])[-1]
        except FileNotFoundError:
            msg = "✗ not installed: " + (cmd[0] if isinstance(cmd, list) else cmd.split()[0])
        except Exception as e:
            msg = "✗ %s" % e
        def fin():
            status(msg)
            if good and after: after()
            return False
        GLib.idle_add(fin)
    threading.Thread(target=work, daemon=True).start()

def copy(text):
    Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
    status("Copied: " + text)

def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))

def mix(a, b, t):
    return "#%02x%02x%02x" % tuple(int((x + (y - x) * t) * 255) for x, y in zip(hex2rgb(a), hex2rgb(b)))

def lum(h):
    r, g, b = hex2rgb(h)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

FALLBACK = ["#1a1b26", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#bb9af7", "#7dcfff", "#a9b1d6",
            "#414868", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#bb9af7", "#7dcfff", "#c0caf5"]

def load_colors():
    try:
        d = json.load(open(WAL_DIR + "/colors.json"))
        return d["special"]["background"], d["special"]["foreground"], [d["colors"]["color%d" % i] for i in range(16)]
    except Exception:
        return FALLBACK[0], FALLBACK[15], FALLBACK

# ---------------------------------------------------------------- style (flat, square)
CSS = Template("""
* { border-radius: 0; box-shadow: none; text-shadow: none; background-image: none; }
window, .root, scrolledwindow, viewport, stack, .page, .page box, .page label { background-color: $bg; color: $fg; }
.brand { background-color: $s1; color: $ac; font-weight: bold; letter-spacing: 3px; padding: 18px 16px 12px 16px; }
.sidebar, .sidebar row, .sidebar row label { background-color: $s1; color: $fg; }
.sidebar { border-right: 1px solid $s2; }
.sidebar row { padding: 10px 14px; border-left: 3px solid transparent; }
.sidebar row:hover, .sidebar row:hover label { background-color: $s2; }
.sidebar row:selected, .sidebar row:selected label { background-color: $s2; color: $ac; font-weight: bold; }
.sidebar row:selected { border-left: 3px solid $ac; }
.title { font-size: 22px; font-weight: bold; padding-bottom: 4px; }
.page .h { color: $ac; font-weight: bold; font-size: 11px; letter-spacing: 2px; }
.card, .card box, .card label { background-color: $s1; color: $fg; }
.card { border: 1px solid $s2; padding: 16px; }
.card .h { color: $ac; }
.status, .status label { background-color: $s1; color: $fg; }
.status { border-top: 1px solid $s2; padding: 7px 16px; }
button, button label { background-color: $s2; color: $fg; }
button { border: 1px solid $s3; padding: 5px 14px; min-height: 20px; }
button:hover, button:hover label, button:checked, button:checked label,
button.suggested, button.suggested label { background-color: $ac; color: $onac; }
button:hover, button:checked, button.suggested { border-color: $ac; }
entry, spinbutton { background-color: $s2; color: $fg; border: 1px solid $s3; min-height: 26px; padding: 0 6px; }
spinbutton button { border: none; padding: 0 6px; }
menu, menu menuitem, popover, .popup { background-color: $s1; color: $fg; border: 1px solid $s3; }
menuitem:hover, menuitem:hover label { background-color: $ac; color: $onac; }
scale trough { background-color: $s3; min-height: 4px; border: none; }
