FROM docker.io/kalilinux/kali-rolling:latest

ARG USER_NAME=kent
ARG USER_UID=1000

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash zsh sudo ca-certificates less curl iproute2 procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u "${USER_UID}" -s /bin/bash "${USER_NAME}" \
    && echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/distrobox-user \
    && chmod 0440 /etc/sudoers.d/distrobox-user \
    && mkdir -p "/home/${USER_NAME}/data" \
    && chown -R "${USER_NAME}:${USER_NAME}" "/home/${USER_NAME}"
