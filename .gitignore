# Credentials and private identity — never commit these.
config/.config/shell/secrets.sh
config/.config/ghgrab/config.json
config/.config/anthropic/credentials/
config/.config/claude/claude.json
config/.config/ssh/
**/*credentials*
**/*secret*
**/id_*_key
**/known_hosts*

# Runtime state, caches, history and databases.
**/.cache/
**/.local/state/
**/.zcompdump
**/*history*
**/*.log
**/*-wal
**/*-shm
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/database

# Compiled programs and build output.
**/*.o
**/*.so
**/*.a
**/.zig-cache/
**/zig-out/
share/.local/share/vxwm/vxwm
share/.local/share/dmenu/dmenu
share/.local/share/slock/slock
share/.local/share/st-terminal/st
share/.local/share/nsxiv/nsxiv
share/.local/share/vcompmgr/vcompmgr
share/.local/share/zlstatus/zig-out/

# Nested repositories and downloaded dependencies.
**/.git/
config/.config/tmux/plugins/
config/.config/nvim/.git/

# Personal data kept locally for this machine but not published.
share/.local/share/archives/
share/.local/share/downloads/
share/.local/share/documents/
share/.local/share/music/
share/.local/share/pictures/
share/.local/share/honkai-star-rail-cursors/

# Regenerated or explicitly excluded application data.
share/.local/share/videos/
share/.local/share/TelegramDesktop/
share/.local/share/claude/
share/.local/share/tor-browser/
share/.local/share/nvim/
share/.local/share/cargo/
share/.local/share/Trash/
share/.local/share/xorg/
share/.local/share/flatpak/
share/.local/share/gvfs-metadata/
