# Runtime / machine-local
**/.cache/
**/__pycache__/
*.pyc
*.o
*.a
*.so
*.swp
*~
.DS_Store

# Build artifacts inside vendored trees
share/.local/share/zlstatus/zig-out/
share/.local/share/zlstatus/zig-cache/
share/.local/share/*/config.h.bak

# Secrets
**/secrets.sh
**/*secret*
**/*.pem
**/*.key

# MPD runtime DB
mpd/.config/mpd/database
mpd/.config/mpd/state
mpd/.config/mpd/pid
mpd/.config/mpd/log

# Editor / plugin lock noise (keep lazy-lock if you want reproducible nvim)
# nvim/.config/nvim/lazy-lock.json

# Large binary wallpaper dumps (store elsewhere or git-lfs)
# wallpapers/.local/share/wallpapers/*
# !wallpapers/.local/share/wallpapers/.gitkeep

# Stow residual
.stow-local-ignore
