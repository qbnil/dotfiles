# Runtime / machine-local
**/.cache/
**/__pycache__/
*.pyc
*.o
*.a
*.so
*.swp
*~
.DS_Store

# Generated at runtime by xresources-gen (static block + the pywal palette).
# Never track/stow this: the repo copy would be overwritten by pywal.
config/.config/x11/Xresources

# Build artifacts from vendored sources
**/zig-out/
**/zig-cache/
**/.zig-cache/
**/config.h.bak
src/*/config.h.bak
# makepkg leftovers (src/thunar)
src/thunar/src/
src/thunar/pkg/
src/thunar/*.pkg.tar.*
src/thunar/*.tar.bz2

# Secrets
**/secrets.sh
**/*secret*
**/*.pem
**/*.key
**/.gnupg/
**/*.gpg
**/*.kdbx
**/.password-store/
**/password-store/

# Runtime state that can contain decrypted secrets
# nvim undo files hold full previous buffer contents (incl. pass show output),
# claude.json may carry session/auth tokens, cliphist DB stores copied secrets.
**/.local/state/
**/undo/
**/claude.json
**/cliphist.db

# MPD runtime state
**/mpd/database
**/mpd/state
**/mpd/pid
**/mpd/log
**/mpd/sticker.sql

# Editor / plugin lock noise
# Keep nvim/lazy-lock.json for reproducible plugin versions.

# Stow residuals
.stow-local-ignore

# OpenCode local secrets / backups
config/.config/opencode/omniroute.key
config/.config/opencode/service.json
config/.config/opencode/auth.json
config/.config/opencode/*.bak*
