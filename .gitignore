# Runtime / machine-local
**/.cache/
**/__pycache__/
*.pyc
*.o
*.a
*.so
*.swp
*~
.DS_Store

# Build artifacts from vendored sources
**/zig-out/
**/zig-cache/
**/config.h.bak
src/*/config.h.bak

# Secrets
**/secrets.sh
**/*secret*
**/*.pem
**/*.key
**/.gnupg/
**/*.gpg
**/*.kdbx
**/.password-store/
**/password-store/

# Runtime state that can contain decrypted secrets
# nvim undo files hold full previous buffer contents (incl. pass show output),
# claude.json may carry session/auth tokens, cliphist DB stores copied secrets.
**/.local/state/
**/undo/
**/claude.json
**/cliphist.db

# MPD runtime state
**/mpd/database
**/mpd/state
**/mpd/pid
**/mpd/log
**/mpd/sticker.sql

# Editor / plugin lock noise
# Keep nvim/lazy-lock.json for reproducible plugin versions.

# Stow residuals
.stow-local-ignore
