#!/bin/sh
# Warn when the running NVIDIA kernel module does not match the installed
# userspace driver. Xorg aborts with "no screens found" (NVRM API mismatch)
# in that state, so a reboot is required before starting X again.
#
# Run by pacman after nvidia-utils / nvidia-*-dkms transactions.
# Deliberately cheap: one /sys read, one local pacman DB lookup, one directory
# test. No GPU calls, no dkms work, no module tree scan.

reboot=0
reasons=""

# A kernel upgrade deletes /usr/lib/modules/<running>, so the modules X would
# modprobe no longer exist even if the driver versions happen to match.
if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    reboot=1
    reasons="running kernel $(uname -r) has no module tree"
fi

# Loaded kernel module vs installed userspace ("615.78.08-1" -> "615.78.08").
mod_ver=$(cat /sys/module/nvidia/version 2>/dev/null)
user_ver=$(pacman -Q nvidia-utils 2>/dev/null | cut -d' ' -f2)
user_ver=${user_ver%-*}

if [ -n "$mod_ver" ] && [ -n "$user_ver" ] && [ "$mod_ver" != "$user_ver" ]; then
    reboot=1
    reasons="${reasons:+$reasons; }loaded module $mod_ver != installed userspace $user_ver"
fi

[ "$reboot" -eq 1 ] || exit 0

printf '\n==> WARNING: NVIDIA driver mismatch - reboot before starting X\n'
printf '    reason: %s\n' "$reasons"
printf '    Xorg will fail with "no screens found" (NVRM API mismatch) until then.\n\n'
