#!/usr/bin/env bash

# Script intended for use via the command line.
#
# `.tmux.conf` needs to be set for TPM. Tmux has to be installed on the system,
# but does not need to be started in order to run this script.

CURRENT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
SCRIPTS_DIR="$CURRENT_DIR/../scripts"

# TPM reads @plugin and TMUX_PLUGIN_MANAGER_PATH from the user's tmux server.
# Running this script with sudo changes HOME to /root and starts a different
# tmux configuration, which produces the misleading "not configured" error.
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
	echo "Do not run TPM with sudo. Run it as your normal user from inside tmux:" >&2
	echo "  Prefix + I" >&2
	echo "or let ~/dotfiles/install.sh run it." >&2
	exit 1
fi

# When this helper is called directly (outside an existing tmux client), TPM
# has no server in which to store TMUX_PLUGIN_MANAGER_PATH. Initialise the
# user's configured tmux server and set the same path that tpm.conf would set
# when it is loaded inside tmux. The dotfiles installer already runs this
# through an isolated server, so this only affects manual `bash install_plugins`
# use.
if [ -z "${TMUX:-}" ]; then
	tmux_conf="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
	tmux_plugins="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/"
	if command -v tmux >/dev/null 2>&1 && [ -f "$tmux_conf" ]; then
		tmux start-server >/dev/null 2>&1 || true
		tmux set-environment -g TMUX_PLUGIN_MANAGER_PATH "$tmux_plugins" >/dev/null 2>&1 || true
	fi
fi

main() {
	bash "$SCRIPTS_DIR/install_plugins.sh" # has correct exit code
}
main
