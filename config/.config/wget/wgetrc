# ~/.config/wget/wgetrc
# User wget configuration (kept in XDG config dir via $WGETRC).
# System-wide defaults are still read from /etc/wgetrc; settings here win.
# See `man wget` or /etc/wgetrc for the full list of options.

# Uncomment to enable:

# https_only = on
# hsts = on
# robots = off
# timeout = 30
# tries = 3
# progress = bar:force:noscroll
